{
  "name": "rtcap",
  "vendor": true,
  "save": "julian",
  "perf": true,
  "note": "rtleaf's views by the lamps in 5.8 and 5.9 with the renderer's capture of each (XBE_CAPTURE_DIR)",
  "settings": {
    "width": 1920,
    "height": 1080,
    "hdr": false,
    "frame_generation": 0,
    "antialiasing": 2,
    "ambient_occlusion": 2,
    "ray_tracing": 5
  },
  "steps": [
    {
      "press": "0:wait:11000",
      "shot": "title",
      "expect": [
        "not player.active"
      ],
      "judge": false
    },
    {
      "until": "player.active and not cutscene and not loading and not menu",
      "timeout": 90,
      "poll": "0:a,90f:wait",
      "poll_by": [
        [
          "cutscene",
          "0:start,45f:wait"
        ]
      ],
      "shot": "loaded",
      "judge": false
    },
    {
      "press": "0:warp=5.8,10f:wait:20f"
    },
    {
      "until": "map == 5 and room == 8 and player.active and not loading",
      "timeout": 40,
      "poll_by": [
        [
          "cutscene",
          "0:start,45f:wait"
        ],
        [
          "menu",
          "0:b,30f:wait"
        ]
      ]
    },
    {
      "press": "0f:wait:120f",
      "shot": "5-8-a",
      "judge": false
    },
    {
      "press": "0f:rsl:30f,40f:wait:1f",
      "shot": "5-8-1",
      "judge": false
    },
    {
      "press": "0f:rsl:30f,40f:wait:1f",
      "shot": "5-8-2",
      "judge": false
    },
    {
      "press": "0:capture,10f:wait:30f",
      "shot": "5-8-2-cap",
      "judge": false
    },
    {
      "press": "0f:rsl:30f,40f:wait:1f",
      "shot": "5-8-3",
      "judge": false
    },
    {
      "press": "0:warp=5.9,10f:wait:20f"
    },
    {
      "until": "map == 5 and room == 9 and player.active and not loading",
      "timeout": 40,
      "poll_by": [
        [
          "cutscene",
          "0:start,45f:wait"
        ],
        [
          "menu",
          "0:b,30f:wait"
        ]
      ]
    },
    {
      "press": "0f:wait:120f",
      "shot": "5-9-a",
      "judge": false
    },
    {
      "press": "0f:rsl:30f,40f:wait:1f",
      "shot": "5-9-1",
      "judge": false
    },
    {
      "press": "0f:rsl:30f,40f:wait:1f",
      "shot": "5-9-2",
      "judge": false
    },
    {
      "press": "0:capture,10f:wait:30f",
      "shot": "5-9-2-cap",
      "judge": false
    }
  ]
}