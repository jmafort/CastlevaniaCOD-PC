+// Anti-aliasing of the frame's 3D, before its UI: AMD FSR's upscaler at the frame's own size (native AA), from AMD's
+// amd_fidelityfx_loader_dx12.dll and amd_fidelityfx_upscaler_dx12.dll beside the game. The title's 3D draws are moved
+// by a sub-pixel offset each frame (Jitter), which it gathers over the frames into smooth edges.
+class AntiAlias {
+public:
+    struct Frame {
+        ID3D12Resource* color = nullptr;   // the frame's colour, in ALL_SHADER_RESOURCE
+        ID3D12Resource* depth = nullptr;   // R32_FLOAT, the colour's size, reversed (1 near), ALL_SHADER_RESOURCE
+        ID3D12Resource* motion = nullptr;  // R16G16_FLOAT, the colour's size: to the frame before in UV units
+        ID3D12Resource* output = nullptr;  // the colour's size, in UNORDERED_ACCESS
+        uint32_t w = 0, h = 0;
+        float jitter[2] = {};  // pixels, as Jitter gave them for this frame
+        bool reset = false;    // nothing to gather from: a cut, the first frame
+        FrameView view;
+        float frame_ms = 16.7f;
+        float sharpness = 0.3f;  // AMD's sharpening after, 0 none
+    };
+    virtual ~AntiAlias() = default;
+    // the frame's offset in pixels, each -0.5 to 0.5
+    virtual void Jitter(uint64_t frame, float& x, float& y) const = 0;
+    // recorded into cl; false when it can't (logged)
+    virtual bool Run(ID3D12GraphicsCommandList* cl, const Frame& f) = 0;
+};
+
+// null when AMD's files are not beside the game (logged)
+std::unique_ptr<AntiAlias> MakeAntiAlias(ID3D12Device* dev);
+
 }  // namespace gpu::framegen
