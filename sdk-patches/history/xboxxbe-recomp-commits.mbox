diff --git a/runtime/gpu/rt_lights.hlsli b/runtime/gpu/rt_lights.hlsli
new file mode 100644
index 0000000..13d5855
--- /dev/null
+++ b/runtime/gpu/rt_lights.hlsli
@@ -0,0 +1,80 @@
+// The scene's lights for the passes that sample them (rt_gi.hlsl's bounce lighting, rt_ao.hlsl's characters' shadows
+// from them): a pass declares in its constants, after rt_scene.hlsli's, lt (the lights listed, their brightness, the
+// candidates a sample is picked from, the most light they throw on a surface), sk (z: the lights drawn flat's
+// brightness, w: the most area a light's light is counted from) and lights[128] (each light's draw and triangles), and
+// before including this, Hash, ViewZ and Depth (the frame's depth at a texel: a light drawn flat goes where it shows).
+
+// One of the lights' points picked for a surface at p facing n (Look::emissive: a glow, a flame, a spell, which the
+// game added onto the frame), by resampling: of tries candidates, each a point on a triangle of a light picked at
+// random, the one kept as its unshadowed light there is strong. q: the point; its light here unshadowed, as the bounce
+// rays' average is (radiance over pi), returned (0: none)
+float3 PickLight(float3 p, float3 n, uint2 id, uint frame, int tries, out float3 q_out) {
+    q_out = 0;
+    uint count = min(uint(lt.x), 128u);  // the list holds 128
+    if (count == 0) return 0;
+    float3 keep_l = 0, keep_q = 0;
+    float keep_f = 0, wsum = 0;
+    [loop] for (int k = 0; k < tries; k++) {
+        float u0 = Hash(uint3(id, frame * 16u + uint(k) + 101u));
+        float u1 = Hash(uint3(id.yx + 31u, frame * 16u + uint(k) + 211u));
+        float u2 = Hash(uint3(id + 977u, frame * 16u + uint(k) + 331u));
+        float u3 = Hash(uint3(id.yx + 4111u, frame * 16u + uint(k) + 457u));
+        uint li = min(uint(u0 * count), count - 1);
+        uint geom = lights[li].x, tris = max(lights[li].y, 1u);
+        uint prim = min(uint(u1 * tris), tris - 1);
+        // a point on the triangle, evenly over it
+        float su = sqrt(u2);
+        float2 bary = float2(su * (1 - u3), su * u3);
+        Spot s = SpotOf(geom, prim, bary);
+        float3 e = s.tint.rgb * s.tint.a;
+        if (geo[geom].c.w > 2.5f) {
+            // drawn flat: where it shows, before what the frame drew there; a haze over the view is none
+            // (the depth at its triangle's middle: the same place for every sample of it, frame to frame)
+            if (FlatShare(s) > 0.02f) e = 0;
+            e *= sk.z;
+            FlatAt(s, 0.95f * ViewZ(Depth(FlatPixel(s, float2(1.0f / 3, 1.0f / 3)))));
+        }
+        float3 q = s.p[0] * (1 - bary.x - bary.y) + s.p[1] * bary.x + s.p[2] * bary.y;
+        float area = 0.5f * length(cross(s.p[1] - s.p[0], s.p[2] - s.p[0]));
+        // no light bigger than a torch's flame (sk.w, its area): a glowing sheet (mist, a beam of light, the marker on
+        // the floor that points to a save room) is a glow, not a lamp, and lit whole rooms its colour
+        if (sk.w > 0) e *= min(1.0f, sk.w / (area * float(tris)));
+        uint pic = geo[geom].a.z;
+        if (pic != kNone) {
+            float4 c = pictures[NonUniformResourceIndex(pic)].SampleLevel(wrap, s.at, 2);
+            e *= c.rgb * (geo[geom].c.w == 1 || geo[geom].c.w == 3 ? c.a : 1.0f);
+        }
+        float3 d = q - p;
+        float d2 = dot(d, d);
+        float3 l = d * rsqrt(max(d2, 1e-8f));
+        float cosn = saturate(dot(n, l));
+        // its light here, unshadowed, as a small glowing patch (no side of a sprite turned away from it)
+        // (no nearer than a little way off: a wall right behind a flame is lit, not burnt white)
+        float3 f = e * cosn / (d2 + max(area * 0.25f, 3600.0f));
+        float target = dot(f, float3(0.2126f, 0.7152f, 0.0722f));
+        float w = target * area * float(tris) * float(count);  // over how likely the point was
+        wsum += w;
+        if (w > 0 && Hash(uint3(id.x + uint(k) * 7u, id.y, frame * 3u + 991u)) * wsum <= w) {
+            keep_l = f;
+            keep_q = q;
+            keep_f = target;
+        }
+    }
+    if (keep_f <= 0) return 0;
+    q_out = keep_q;
+    return keep_l / keep_f * (wsum / float(tries)) / 3.14159265f;
+}
+
+// The lights' light on a surface at p facing n: one point picked (PickLight, lt.z candidates), then a ray toward it for
+// its shadow (anything solid between: a character between a torch and the wall throws one; the lights themselves and
+// water let it through)
+float3 LightAt(float3 p, float3 n, uint2 id, uint frame, int tries) {
+    float3 q;
+    float3 l = PickLight(p, n, id, frame, tries, q);
+    if (all(l == 0)) return 0;
+    float3 dq = q - p;
+    float dist = length(dq);
+    if (dist < 1e-3f || TraceScene(p, dq / dist, 0, dist * 0.98f, 8) >= 0) return 0;
+    return l;
+}
+float3 LightAt(float3 p, float3 n, uint2 id, uint frame) { return LightAt(p, n, id, frame, int(lt.z)); }
