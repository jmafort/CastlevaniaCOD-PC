diff --git a/runtime/gpu/rt_glowmem.hlsl b/runtime/gpu/rt_glowmem.hlsl
new file mode 100644
index 0000000..90e0ccf
--- /dev/null
+++ b/runtime/gpu/rt_glowmem.hlsl
@@ -0,0 +1,184 @@
+// The glows remembered off screen (d3d12.cpp's Lighting, for the bounce lighting's lights, rt_gi.hlsl). The scene's
+// lights are the glows, flames and spells the game drew this frame (Scene::Emissive), and the game draws only what is
+// on screen: a torch just out of view stopped lighting the wall in view beside it, and the wall darkened as the camera
+// turned. This pass keeps, frame to frame, a few slots of the glows seen: each where it is (moved with the camera into
+// each frame's view space), all the light it gives off, and how long it has been out of view. A glow the frame drew
+// is the list's (age 0, not sampled from here); one not drawn that is off screen is remembered (age 1 and up), for at
+// most gm.w frames; one not drawn that is on screen is gone (a spell over, a light put out) and its slot freed.
+// Two steps, each a pixel shader over a small RGBA32F target (gm.x):
+//  0: each listed light's summary, 128 x 3 texels by its place in the list: its middle (view space) and area; all
+//     the light it gives off and the least distance its light is counted from; whether a slot already holds it
+//  1: the slots, gm2.w x 2 texels: where (view space) and its age (-1: none); its light and least distance (as 0's)
+cbuffer P : register(b0) {
+    float4 cam;   // the view's depth at the buffer's 0 and its 1, tan of half the view across, down
+    float4 part;  // the 3D's size in depth texels (rw, rh)
+    float4 lt;    // the scene's lights listed (rt_gi.hlsl's lt)
+    float4 sk;    // z: the lights drawn flat's brightness; w: the most area a light's light is counted from
+    float4 gm;    // the step (0, 1); the SRV heap's indices: the summary (step 1's), the slots the frame before (-1:
+                  // none, a cut); the frames a glow is remembered off screen at most
+    float4 gm2;   // how near a light is to a slot's glow to be it: a part of the square root of the light's area, and
+                  // at least; the part of the screen's middle where a glow not drawn is on screen; the slots
+    float4 pc0;   // the camera's move the other way: the frame before's clip space to this frame's, rows
+    float4 pc1;
+    float4 pc2;
+    float4 pc3;
+    uint4 lights[128];  // each light's draw among the scene's and its triangles
+};
+#include "rt_scene.hlsli"
+Texture2D<float> depth : register(t1);
+
+float ViewZ(float d) { return cam.x * cam.y / (d * cam.x + (1 - d) * cam.y); }
+float Depth(int2 px) { return depth.Load(int3(clamp(px, int2(0, 0), int2(part.xy) - 1), 0)); }
+float Hash(uint3 v) {
+    v = v * 1664525u + 1013904223u;
+    v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;
+    v ^= v >> 16u;
+    v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;
+    return float(v.x & 0xFFFFFF) / 16777216.0f;
+}
+#include "rt_lights.hlsli"
+
+Texture2D<float4> Tex(float i) { return pictures[NonUniformResourceIndex(uint(i))]; }
+float Luma(float3 c) { return dot(c, float3(0.2126f, 0.7152f, 0.0722f)); }
+
+// a place in the frame before's view space moved into this frame's (the camera's move undone: its clip space, x and y
+// over the view's tan, the depth buffer's value times the view depth, w the view depth; a point behind the eye stays
+// behind it)
+float3 Move(float3 v) {
+    float4 c = float4(v.x / cam.z, v.y / cam.w, cam.y * (cam.x - v.z) / (cam.x - cam.y), v.z);
+    float4 q = float4(dot(pc0, c), dot(pc1, c), dot(pc2, c), dot(pc3, c));
+    if (abs(q.w) < 1e-6f) return float3(0, 0, -1e30f);
+    float z = ViewZ(q.z / q.w);
+    return float3(q.xy / q.w * cam.zw * z, z);
