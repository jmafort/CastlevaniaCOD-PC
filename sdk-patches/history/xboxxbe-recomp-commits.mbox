+bool Scene::AddLateDraw(const void* indices, uint32_t index_count, bool index16, bool strip, uint32_t draw_count,
+                        uint32_t first, uint32_t slots, const Look& look) {
+    if (!ready_) return false;
+    Slot& s = slots_[slot_];
+    constexpr uint64_t kLateIndices = 1u << 18;
+    if (!s.late_index) {
+        D3D12_HEAP_PROPERTIES up{D3D12_HEAP_TYPE_UPLOAD};
+        D3D12_RESOURCE_DESC d = Buffer(kLateIndices * 4);
+        d.Flags = D3D12_RESOURCE_FLAG_NONE;
+        void* map = nullptr;
+        if (FAILED(dev_->CreateCommittedResource(&up, D3D12_HEAP_FLAG_NONE, &d, D3D12_RESOURCE_STATE_GENERIC_READ,
+                                                 nullptr, IID_PPV_ARGS(&s.late_index))) ||
+            FAILED(s.late_index->Map(0, nullptr, &map))) {
+            s.late_index = nullptr;
+            return false;
+        }
+        s.late_index_map = static_cast<uint32_t*>(map);
+        s.late_index_bytes = kLateIndices * 4;
+    }
+    Geometry g;
+    g.first = first;
+    g.vertex_count = slots;
+    g.look = look;
+    g.look.water = true;
+    uint32_t n = index_count ? index_count : draw_count;
+    if (!strip && !index_count) {
+        g.vertex_count = std::min(slots, draw_count - draw_count % 3);
+        if (!g.vertex_count) return false;
+        s.late_geoms.push_back(g);
+        return true;
+    }
+    if (n < 3) return false;
+    uint64_t most = strip ? uint64_t(n - 2) * 3 : n;
+    if ((s.late_index_used + most) * 4 > s.late_index_bytes) return false;
+    auto at = [&](uint32_t k) -> uint32_t {
+        if (!index_count) return k;
+        return index16 ? static_cast<const uint16_t*>(indices)[k] : static_cast<const uint32_t*>(indices)[k];
+    };
+    uint32_t* out = s.late_index_map + s.late_index_used;
+    uint32_t count = 0;
+    for (uint32_t k = 0; k + 2 < n; k += strip ? 1 : 3) {
+        uint32_t i0 = at(k), i1 = at(k + 1), i2 = at(k + 2);
+        if (strip && (i0 == i1 || i1 == i2 || i0 == i2)) continue;
+        out[count++] = i0;
+        out[count++] = i1;
+        out[count++] = i2;
+    }
+    if (!count) return false;
+    g.indices = s.late_index->GetGPUVirtualAddress() + s.late_index_used * 4;
+    g.index_format = DXGI_FORMAT_R32_UINT;
+    g.index_count = count;
+    s.late_index_used += count;
+    s.late_geoms.push_back(g);
+    return true;
