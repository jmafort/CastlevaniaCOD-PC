+        params[2 + i].DescriptorTable.pDescriptorRanges = &ranges[i];
+    }
+    for (int i = 0; i < 3; i++) {
+        params[4 + i].ParameterType = D3D12_ROOT_PARAMETER_TYPE_SRV;
+        params[4 + i].Descriptor.ShaderRegister = 2 + i;
+    }
+    D3D12_STATIC_SAMPLER_DESC wrap{};
+    wrap.Filter = D3D12_FILTER_MIN_MAG_MIP_LINEAR;
+    wrap.AddressU = wrap.AddressV = wrap.AddressW = D3D12_TEXTURE_ADDRESS_MODE_WRAP;
+    wrap.MaxLOD = D3D12_FLOAT32_MAX;
+    wrap.ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+    D3D12_ROOT_SIGNATURE_DESC rsd{};
+    rsd.NumParameters = 7;
+    rsd.pParameters = params;
+    rsd.NumStaticSamplers = 1;
+    rsd.pStaticSamplers = &wrap;
+    ComPtr<ID3DBlob> rs, err;
+    if (FAILED(D3D12SerializeRootSignature(&rsd, D3D_ROOT_SIGNATURE_VERSION_1, &rs, &err)) ||
+        FAILED(dev_->CreateRootSignature(0, rs->GetBufferPointer(), rs->GetBufferSize(), IID_PPV_ARGS(&ao_root_)))) {
+        LOGW("ray tracing: its root signature was not made");
+        return false;
+    }
+    // a full screen triangle into an R8 target, as the screen space pass draws
+    D3D12_GRAPHICS_PIPELINE_STATE_DESC pd{};
+    pd.pRootSignature = ao_root_.Get();
+    pd.VS = {k_rt_ao_vs, sizeof(k_rt_ao_vs)};
+    pd.PS = {k_rt_ao_ps, sizeof(k_rt_ao_ps)};
+    pd.BlendState.RenderTarget[0].RenderTargetWriteMask = D3D12_COLOR_WRITE_ENABLE_ALL;
+    pd.SampleMask = UINT_MAX;
+    pd.RasterizerState.FillMode = D3D12_FILL_MODE_SOLID;
+    pd.RasterizerState.CullMode = D3D12_CULL_MODE_NONE;
+    pd.RasterizerState.DepthClipEnable = TRUE;
+    pd.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
+    pd.NumRenderTargets = 1;
+    pd.RTVFormats[0] = DXGI_FORMAT_R8_UNORM;
+    pd.SampleDesc.Count = 1;
+    if (FAILED(dev_->CreateGraphicsPipelineState(&pd, IID_PPV_ARGS(&ao_pso_)))) {
+        LOGW("ray tracing: its ambient occlusion pipeline was not made");
+        return false;
+    }
+    slots_.resize(frames);
+    for (Slot& s : slots_) {
+        D3D12_HEAP_PROPERTIES up{D3D12_HEAP_TYPE_UPLOAD};
+        D3D12_RESOURCE_DESC d = Buffer(256);
+        d.Flags = D3D12_RESOURCE_FLAG_NONE;
+        if (FAILED(dev_->CreateCommittedResource(&up, D3D12_HEAP_FLAG_NONE, &d, D3D12_RESOURCE_STATE_GENERIC_READ, nullptr,
+                                                 IID_PPV_ARGS(&s.instance))) ||
+            FAILED(s.instance->Map(0, nullptr, &s.instance_map)) ||
+            !Ensure(s.capture, s.capture_bytes, kFirstCapture * kVertexBytes, D3D12_RESOURCE_STATE_UNORDERED_ACCESS) ||
+            !EnsureIndices(s, kFirstIndices) || !EnsureTable(s, 4096))
+            return false;
+        s.capture_state = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+    }
+    ready_ = true;
+    g_ray_tracing_ready.store(true, std::memory_order_relaxed);
+    LOGR("ray tracing: DXR tier %d.%d, ready", int(o5.RaytracingTier) / 10, int(o5.RaytracingTier) % 10);
+    return true;
+#endif
+}
+
+bool Scene::Ensure(ComPtr<ID3D12Resource>& r, uint64_t& have, uint64_t want, D3D12_RESOURCE_STATES state) {
+    if (r && have >= want) return true;
+    uint64_t bytes = (want + want / 4 + 0xFFFF) & ~uint64_t(0xFFFF);  // a quarter more, so a frame or two later fits
+    D3D12_HEAP_PROPERTIES hp{D3D12_HEAP_TYPE_DEFAULT};
+    D3D12_RESOURCE_DESC d = Buffer(bytes);
+    ComPtr<ID3D12Resource> n;
+    if (FAILED(dev_->CreateCommittedResource(&hp, D3D12_HEAP_FLAG_NONE, &d, state, nullptr, IID_PPV_ARGS(&n)))) {
+        LOGW("ray tracing: a %llu MB buffer was not made", (unsigned long long)(bytes >> 20));
+        return false;
+    }
+    r = std::move(n);  // the slot's last frame is done with the old one
+    have = bytes;
+    return true;
+}
+
+// the slot's indices: an upload buffer the CPU writes and the build reads, mapped for good
+bool Scene::EnsureIndices(Slot& s, uint64_t count) {
+    if (s.indices && s.index_bytes >= count * 4) return true;
+    uint64_t bytes = (count * 4 + count + 0xFFFF) & ~uint64_t(0xFFFF);
+    D3D12_HEAP_PROPERTIES up{D3D12_HEAP_TYPE_UPLOAD};
+    D3D12_RESOURCE_DESC d = Buffer(bytes);
+    d.Flags = D3D12_RESOURCE_FLAG_NONE;
+    ComPtr<ID3D12Resource> n;
+    void* map = nullptr;
+    if (FAILED(dev_->CreateCommittedResource(&up, D3D12_HEAP_FLAG_NONE, &d, D3D12_RESOURCE_STATE_GENERIC_READ, nullptr,
+                                             IID_PPV_ARGS(&n))) ||
+        FAILED(n->Map(0, nullptr, &map))) {
+        LOGW("ray tracing: a %llu MB index buffer was not made", (unsigned long long)(bytes >> 20));
+        return false;
+    }
+    s.indices = std::move(n);
+    s.index_map = static_cast<uint32_t*>(map);
+    s.index_bytes = bytes;
+    return true;
+}
+
+// the slot's draws for the shaders, likewise
+bool Scene::EnsureTable(Slot& s, uint64_t count) {
+    if (s.table && s.table_bytes >= count * sizeof(GeometryEntry)) return true;
+    uint64_t bytes = (count * 2 * sizeof(GeometryEntry) + 0xFFFF) & ~uint64_t(0xFFFF);
+    D3D12_HEAP_PROPERTIES up{D3D12_HEAP_TYPE_UPLOAD};
+    D3D12_RESOURCE_DESC d = Buffer(bytes);
+    d.Flags = D3D12_RESOURCE_FLAG_NONE;
+    ComPtr<ID3D12Resource> n;
+    void* map = nullptr;
+    if (FAILED(dev_->CreateCommittedResource(&up, D3D12_HEAP_FLAG_NONE, &d, D3D12_RESOURCE_STATE_GENERIC_READ, nullptr,
+                                             IID_PPV_ARGS(&n))) ||
+        FAILED(n->Map(0, nullptr, &map))) {
+        LOGW("ray tracing: its table of draws was not made");
+        return false;
+    }
+    s.table = std::move(n);
+    s.table_map = static_cast<GeometryEntry*>(map);
+    s.table_bytes = bytes;
+    return true;
+}
+
+void Scene::AddDraw(const void* indices, uint32_t index_count, bool index16, bool strip, uint32_t draw_count,
+                    uint32_t first, uint32_t slots, uint32_t picture, uint32_t alpha) {
+    if (!ready_ || built_) return;
+    Geometry g;
+    g.first = first;
+    g.vertex_count = slots;
+    if (alpha && picture != UINT32_MAX) {
+        g.picture = picture;
+        g.alpha = alpha;
+    }
+    if (!strip && !index_count) {  // its vertices three by three
+        g.vertex_count = std::min(slots, draw_count - draw_count % 3);
+        if (g.vertex_count) Add(g);
+        return;
+    }
+    uint32_t n = index_count ? index_count : draw_count;
+    if (n < 3) return;
+    uint64_t most = strip ? uint64_t(n - 2) * 3 : n;
+    Slot& s = slots_[slot_];
+    index_want_ = std::max(index_want_, index_used_ + most);
+    if ((index_used_ + most) * 4 > s.index_bytes) return;  // the next frame's is larger
+    auto at = [&](uint32_t k) -> uint32_t {
+        if (!index_count) return k;
+        return index16 ? static_cast<const uint16_t*>(indices)[k] : static_cast<const uint32_t*>(indices)[k];
+    };
+    uint32_t* out = s.index_map + index_used_;
+    uint32_t count = 0;
+    if (!strip) {
+        for (uint32_t k = 0; k + 2 < n; k += 3) {
+            out[count++] = at(k);
+            out[count++] = at(k + 1);
+            out[count++] = at(k + 2);
+        }
+    } else {
+        // each three in a row a triangle, the degenerate ones (joining strips) left out
+        for (uint32_t k = 0; k + 2 < n; k++) {
+            uint32_t i0 = at(k), i1 = at(k + 1), i2 = at(k + 2);
+            if (i0 == i1 || i1 == i2 || i0 == i2) continue;
+            out[count++] = i0;
+            out[count++] = i1;
+            out[count++] = i2;
+        }
+    }
+    if (!count) return;
+    g.indices = s.indices->GetGPUVirtualAddress() + index_used_ * 4;
+    g.index_format = DXGI_FORMAT_R32_UINT;
+    g.index_count = count;
+    g.index_start = uint32_t(index_used_);
+    index_used_ += count;
+    Add(g);
+}
+
+void Scene::UavBarrier() {
+    D3D12_RESOURCE_BARRIER b{};
+    b.Type = D3D12_RESOURCE_BARRIER_TYPE_UAV;
+    cl_->ResourceBarrier(1, &b);
+}
+
+void Scene::Begin(uint32_t slot) {
+    if (!ready_) return;
+    slot_ = slot % uint32_t(slots_.size());
+    Slot& s = slots_[slot_];
+    geoms_.clear();
+    used_ = 0;
+    index_used_ = 0;
+    built_ = false;
+    if (index_want_ * 4 > s.index_bytes && EnsureIndices(s, index_want_))
+        LOGR("ray tracing: the index buffer now holds %llu indices", (unsigned long long)(s.index_bytes / 4));
+    // the frame before asked for more than there was: room for it
+    if (uint64_t(want_) * kVertexBytes > s.capture_bytes &&
+        Ensure(s.capture, s.capture_bytes, uint64_t(want_) * kVertexBytes, D3D12_RESOURCE_STATE_UNORDERED_ACCESS)) {
+        s.capture_state = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+        LOGR("ray tracing: the capture buffer now holds %llu vertices",
+             (unsigned long long)(s.capture_bytes / kVertexBytes));
+    }
+    if (s.capture_state != D3D12_RESOURCE_STATE_UNORDERED_ACCESS) {
+        D3D12_RESOURCE_BARRIER b{};
+        b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+        b.Transition.pResource = s.capture.Get();
+        b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+        b.Transition.StateBefore = s.capture_state;
+        b.Transition.StateAfter = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+        cl_->ResourceBarrier(1, &b);
+        s.capture_state = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+    }
+}
+
+D3D12_GPU_VIRTUAL_ADDRESS Scene::Capture() const {
+    return ready_ ? slots_[slot_].capture->GetGPUVirtualAddress() : 0;
+}
+
+uint32_t Scene::Reserve(uint32_t n) {
+    if (!ready_ || built_) return UINT32_MAX;
+    uint64_t cap = slots_[slot_].capture_bytes / kVertexBytes;
+    want_ = uint32_t(std::min<uint64_t>(std::max<uint64_t>(want_, uint64_t(used_) + n), 1u << 26));
+    if (uint64_t(used_) + n > cap) return UINT32_MAX;
+    uint32_t first = used_;
+    used_ += n;
+    return first;
+}
+
+void Scene::Add(const Geometry& g) {
+    if (ready_ && !built_) geoms_.push_back(g);
+}
+
+bool Scene::Build(const float to_view[12]) {
+    if (!ready_ || built_ || geoms_.empty()) return false;
+    Slot& s = slots_[slot_];
+    if (!EnsureTable(s, geoms_.size())) return false;
+    for (size_t i = 0; i < geoms_.size(); i++) {
+        const Geometry& g = geoms_[i];
+        s.table_map[i] = {g.first, g.index_start, g.alpha ? g.picture : 0, g.alpha};
+    }
+    // the vertices written: to the build as its input
+    D3D12_RESOURCE_BARRIER tb{};
+    tb.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    tb.Transition.pResource = s.capture.Get();
+    tb.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    tb.Transition.StateBefore = s.capture_state;
+    tb.Transition.StateAfter = kRead;
+    cl_->ResourceBarrier(1, &tb);
+    s.capture_state = kRead;
+
+    D3D12_GPU_VIRTUAL_ADDRESS vb = s.capture->GetGPUVirtualAddress();
+    descs_.clear();
+    uint64_t triangles = 0;
+    for (const Geometry& g : geoms_) {
+        D3D12_RAYTRACING_GEOMETRY_DESC d{};
+        d.Type = D3D12_RAYTRACING_GEOMETRY_TYPE_TRIANGLES;
+        // a cut-out's triangles go to the passes' alpha test (rt_scene.hlsli), the rest are solid
+        d.Flags = g.alpha ? D3D12_RAYTRACING_GEOMETRY_FLAG_NONE : D3D12_RAYTRACING_GEOMETRY_FLAG_OPAQUE;
+        auto& t = d.Triangles;
+        t.VertexFormat = DXGI_FORMAT_R32G32B32_FLOAT;
+        t.VertexCount = g.vertex_count;
+        t.VertexBuffer.StartAddress = vb + uint64_t(g.first) * kVertexBytes;
+        t.VertexBuffer.StrideInBytes = kVertexBytes;
+        if (g.indices) {
+            t.IndexFormat = g.index_format;
+            t.IndexCount = g.index_count;
+            t.IndexBuffer = g.indices;
+            triangles += g.index_count / 3;
+        } else {
+            t.IndexFormat = DXGI_FORMAT_UNKNOWN;
+            triangles += g.vertex_count / 3;
+        }
+        descs_.push_back(d);
+    }
+    D3D12_BUILD_RAYTRACING_ACCELERATION_STRUCTURE_INPUTS bottom{};
+    bottom.Type = D3D12_RAYTRACING_ACCELERATION_STRUCTURE_TYPE_BOTTOM_LEVEL;
+    bottom.Flags = D3D12_RAYTRACING_ACCELERATION_STRUCTURE_BUILD_FLAG_PREFER_FAST_BUILD;
+    bottom.NumDescs = uint32_t(descs_.size());
+    bottom.DescsLayout = D3D12_ELEMENTS_LAYOUT_ARRAY;
+    bottom.pGeometryDescs = descs_.data();
+    D3D12_RAYTRACING_ACCELERATION_STRUCTURE_PREBUILD_INFO bi{};
+    dev_->GetRaytracingAccelerationStructurePrebuildInfo(&bottom, &bi);
+
+    D3D12_BUILD_RAYTRACING_ACCELERATION_STRUCTURE_INPUTS top{};
+    top.Type = D3D12_RAYTRACING_ACCELERATION_STRUCTURE_TYPE_TOP_LEVEL;
+    top.Flags = D3D12_RAYTRACING_ACCELERATION_STRUCTURE_BUILD_FLAG_PREFER_FAST_TRACE;
+    top.NumDescs = 1;
+    top.DescsLayout = D3D12_ELEMENTS_LAYOUT_ARRAY;
+    D3D12_RAYTRACING_ACCELERATION_STRUCTURE_PREBUILD_INFO ti{};
+    dev_->GetRaytracingAccelerationStructurePrebuildInfo(&top, &ti);
+
+    const auto kAs = D3D12_RESOURCE_STATE_RAYTRACING_ACCELERATION_STRUCTURE;
+    uint64_t scratch = std::max(bi.ScratchDataSizeInBytes, ti.ScratchDataSizeInBytes);
+    if (!Ensure(s.blas, s.blas_bytes, bi.ResultDataMaxSizeInBytes, kAs) ||
+        !Ensure(s.tlas, s.tlas_bytes, ti.ResultDataMaxSizeInBytes, kAs) ||
+        !Ensure(s.scratch, s.scratch_bytes, scratch, D3D12_RESOURCE_STATE_UNORDERED_ACCESS))
+        return false;
+
+    D3D12_BUILD_RAYTRACING_ACCELERATION_STRUCTURE_DESC bd{};
+    bd.Inputs = bottom;
+    bd.DestAccelerationStructureData = s.blas->GetGPUVirtualAddress();
+    bd.ScratchAccelerationStructureData = s.scratch->GetGPUVirtualAddress();
+    cl_->BuildRaytracingAccelerationStructure(&bd, 0, nullptr);
+    UavBarrier();
+
+    // the one instance: the captured clip x, y and w put back into view space
+    D3D12_RAYTRACING_INSTANCE_DESC inst{};
+    std::memcpy(inst.Transform, to_view, sizeof(float) * 12);
+    inst.InstanceMask = 0xFF;
+    inst.Flags = D3D12_RAYTRACING_INSTANCE_FLAG_TRIANGLE_CULL_DISABLE;
+    inst.AccelerationStructure = s.blas->GetGPUVirtualAddress();
+    std::memcpy(s.instance_map, &inst, sizeof(inst));
+    top.InstanceDescs = s.instance->GetGPUVirtualAddress();
+    D3D12_BUILD_RAYTRACING_ACCELERATION_STRUCTURE_DESC td{};
+    td.Inputs = top;
+    td.DestAccelerationStructureData = s.tlas->GetGPUVirtualAddress();
+    td.ScratchAccelerationStructureData = s.scratch->GetGPUVirtualAddress();
+    cl_->BuildRaytracingAccelerationStructure(&td, 0, nullptr);
+    UavBarrier();
+    built_ = true;
+    // the first frame's, then one every half minute or so
+    if (builds_++ % 1800 == 0) {
+        LOGR("ray tracing: the frame's scene, %zu draws, %llu triangles, %u vertices; %.1f MB built", geoms_.size(),
+             (unsigned long long)triangles, used_, double(bi.ResultDataMaxSizeInBytes) / 1048576.0);
+    }
+    return true;
+}
+
+D3D12_GPU_VIRTUAL_ADDRESS Scene::Tlas() const {
+    return built_ ? slots_[slot_].tlas->GetGPUVirtualAddress() : 0;
+}
+D3D12_GPU_VIRTUAL_ADDRESS Scene::Vertices() const {
+    return built_ ? slots_[slot_].capture->GetGPUVirtualAddress() : 0;
+}
+D3D12_GPU_VIRTUAL_ADDRESS Scene::Indices() const {
+    return built_ ? slots_[slot_].indices->GetGPUVirtualAddress() : 0;
+}
+D3D12_GPU_VIRTUAL_ADDRESS Scene::GeometryTable() const {
+    return built_ ? slots_[slot_].table->GetGPUVirtualAddress() : 0;
+}
+
+void Scene::TraceAmbientOcclusion(D3D12_GPU_VIRTUAL_ADDRESS cb, D3D12_GPU_DESCRIPTOR_HANDLE depth,
+                                  D3D12_GPU_DESCRIPTOR_HANDLE pictures, D3D12_CPU_DESCRIPTOR_HANDLE rtv, uint32_t w,
+                                  uint32_t h) {
+    if (!built_) return;
+    cl_->SetGraphicsRootSignature(ao_root_.Get());
+    cl_->SetPipelineState(ao_pso_.Get());
+    cl_->SetGraphicsRootConstantBufferView(0, cb);
+    cl_->SetGraphicsRootShaderResourceView(1, Tlas());
+    cl_->SetGraphicsRootDescriptorTable(2, depth);
+    cl_->SetGraphicsRootDescriptorTable(3, pictures);
+    cl_->SetGraphicsRootShaderResourceView(4, Vertices());
+    cl_->SetGraphicsRootShaderResourceView(5, Indices());
+    cl_->SetGraphicsRootShaderResourceView(6, GeometryTable());
+    cl_->OMSetRenderTargets(1, &rtv, FALSE, nullptr);
+    D3D12_VIEWPORT vp{0, 0, float(w), float(h), 0, 1};
+    D3D12_RECT sc{0, 0, LONG(w), LONG(h)};
+    cl_->RSSetViewports(1, &vp);
+    cl_->RSSetScissorRects(1, &sc);
+    cl_->IASetPrimitiveTopology(D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+    cl_->DrawInstanced(3, 1, 0, 0);
+}
+
