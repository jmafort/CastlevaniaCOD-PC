+    uint64_t shown_ = 0;            // frames on the screen (Shown)
+    sl::DLSSGStatus status_ = sl::DLSSGStatus(0xffffffffu);  // as last logged: none yet
+    bool ready_ = false, mode_on_ = false, hdr_said_ = false;
+};
+
+}  // namespace
+
+std::unique_ptr<FrameGen> Make(uint32_t kind) {
+    if (kind == kFsr) {
+        auto f = std::make_unique<Fsr>();
+        if (f->Load()) return f;
+    } else if (kind == kDlss) {
+        auto d = std::make_unique<Dlss>();
+        if (d->Load()) return d;
+    }
+    return nullptr;
+}
