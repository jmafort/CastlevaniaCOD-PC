+        std::wstring missing;
+        if (!Have(dir, {L"amd_fidelityfx_loader_dx12.dll", L"amd_fidelityfx_upscaler_dx12.dll"}, missing)) {
+            LOGR("antialias: AMD FSR needs %ls beside the game (AMD's FidelityFX SDK release, signedbin)",
+                 missing.c_str());
+            return false;
+        }
+        lib_ = LoadLibraryExW((dir / L"amd_fidelityfx_loader_dx12.dll").c_str(), nullptr, LOAD_WITH_ALTERED_SEARCH_PATH);
+        if (!lib_) {
+            LOGR("antialias: amd_fidelityfx_loader_dx12.dll does not load (error %lu)", GetLastError());
+            return false;
+        }
+        create_ = reinterpret_cast<PfnFfxCreateContext>(GetProcAddress(lib_, "ffxCreateContext"));
+        destroy_ = reinterpret_cast<PfnFfxDestroyContext>(GetProcAddress(lib_, "ffxDestroyContext"));
+        dispatch_ = reinterpret_cast<PfnFfxDispatch>(GetProcAddress(lib_, "ffxDispatch"));
+        if (!create_ || !destroy_ || !dispatch_) {
+            LOGR("antialias: amd_fidelityfx_loader_dx12.dll lacks the FidelityFX API");
+            return false;
+        }
+        return true;
+    }
+
+    // at the frame's own size the sequence is 8 long (AMD's 8 times the scale squared)
+    void Jitter(uint64_t frame, float& x, float& y) const override {
+        constexpr int32_t kPhases = 8;
+        int32_t i = int32_t(frame % kPhases) + 1;
+        x = Halton(i, 2) - 0.5f;
+        y = Halton(i, 3) - 0.5f;
+    }
+
+    bool Run(ID3D12GraphicsCommandList* cl, const Frame& f) override {
+        if (!f.color || !f.depth || !f.motion || !f.output || !f.w || !f.h) return false;
+        if (ctx_ && (f.w != w_ || f.h != h_)) {
+            destroy_(&ctx_, nullptr);
+            ctx_ = nullptr;
+        }
+        bool fresh = !ctx_;
+        if (!ctx_ && !MakeContext(f.w, f.h)) return false;
+        ffxDispatchDescUpscale d{};
+        d.header.type = FFX_API_DISPATCH_DESC_TYPE_UPSCALE;
+        d.commandList = cl;
+        d.color = ffxApiGetResourceDX12(f.color, FFX_API_RESOURCE_STATE_PIXEL_COMPUTE_READ);
+        d.depth = ffxApiGetResourceDX12(f.depth, FFX_API_RESOURCE_STATE_PIXEL_COMPUTE_READ);
+        d.motionVectors = ffxApiGetResourceDX12(f.motion, FFX_API_RESOURCE_STATE_PIXEL_COMPUTE_READ);
+        d.output = ffxApiGetResourceDX12(f.output, FFX_API_RESOURCE_STATE_UNORDERED_ACCESS);
+        d.jitterOffset = {f.jitter[0], f.jitter[1]};
+        d.motionVectorScale = {float(f.w), float(f.h)};  // UV units to pixels
+        d.renderSize = {f.w, f.h};
+        d.upscaleSize = {f.w, f.h};
+        d.enableSharpening = f.sharpness > 0;
+        d.sharpness = f.sharpness;
+        d.frameTimeDelta = f.frame_ms;
+        d.preExposure = 1;
+        d.reset = f.reset || fresh;
+        d.cameraNear = f.view.near_w;
+        d.cameraFar = f.view.far_w;
+        d.cameraFovAngleVertical = f.view.fov_y;
+        d.viewSpaceToMetersFactor = 0.01f;  // the title's units are about centimetres
+        d.flags = FFX_UPSCALE_FLAG_NON_LINEAR_COLOR_SRGB;
+        ffxReturnCode_t r = dispatch_(&ctx_, &d.header);
+        if (r != FFX_API_RETURN_OK) {
+            FG_FIRST(4, "antialias: AMD FSR dispatch %u at %ux%u", r, f.w, f.h);
+            return false;
+        }
+        return true;
+    }
+
+private:
+    bool MakeContext(uint32_t w, uint32_t h) {
+        ffxCreateBackendDX12Desc be{};
+        be.header.type = FFX_API_CREATE_CONTEXT_DESC_TYPE_BACKEND_DX12;
+        be.device = dev_;
+        ffxCreateContextDescUpscaleVersion ver{};
+        ver.header.type = FFX_API_CREATE_CONTEXT_DESC_TYPE_UPSCALE_VERSION;
+        ver.version = FFX_UPSCALER_VERSION;
+        ver.header.pNext = &be.header;
+        ffxCreateContextDescUpscale c{};
+        c.header.type = FFX_API_CREATE_CONTEXT_DESC_TYPE_UPSCALE;
+        c.header.pNext = &ver.header;
+        // the frame as the game drew it: gamma-encoded colour, depth reversed (1 near), exposure found by AMD
+        c.flags = FFX_UPSCALE_ENABLE_AUTO_EXPOSURE | FFX_UPSCALE_ENABLE_DEPTH_INVERTED |
+                  FFX_UPSCALE_ENABLE_NON_LINEAR_COLORSPACE;
+        c.maxRenderSize = {w, h};
+        c.maxUpscaleSize = {w, h};
+        ffxReturnCode_t r = create_(&ctx_, &c.header, nullptr);
+        if (r != FFX_API_RETURN_OK) {
+            FG_FIRST(4, "antialias: AMD FSR's context was not made (%u) at %ux%u", r, w, h);
+            ctx_ = nullptr;
+            return false;
+        }
+        w_ = w;
+        h_ = h;
+        LOGR("antialias: AMD FSR at %ux%u", w, h);
+        return true;
+    }
+
+    ID3D12Device* dev_ = nullptr;
+    HMODULE lib_ = nullptr;
+    PfnFfxCreateContext create_ = nullptr;
+    PfnFfxDestroyContext destroy_ = nullptr;
+    PfnFfxDispatch dispatch_ = nullptr;
+    ffxContext ctx_ = nullptr;
+    uint32_t w_ = 0, h_ = 0;
+};
+
