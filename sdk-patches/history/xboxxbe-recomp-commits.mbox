+bool Scene::Init(ID3D12Device* dev, ID3D12GraphicsCommandList* cl, uint32_t frames) {
+#if !XBE_RAYTRACING
+    (void)dev;
+    (void)cl;
+    (void)frames;
+    LOGR("ray tracing: not in this build (no dxc when it was built)");
+    return false;
+#else
+    if (FAILED(dev->QueryInterface(IID_PPV_ARGS(&dev_))) || FAILED(cl->QueryInterface(IID_PPV_ARGS(&cl_)))) {
+        LOGR("ray tracing: none, the Direct3D 12 runtime is too old for it");
+        return false;
