--- /dev/null
+++ b/runtime/gpu/rt_aotemporal.hlsl
@@ -0,0 +1,82 @@
+// Ray traced ambient occlusion's own denoiser (d3d12.cpp's AmbientOcclusion, when no vendor's denoiser takes the frame:
+// AMD FSR, or DLSS without Ray Reconstruction's files): each texel of this frame's ambient occlusion (rt_ao.hlsl, a few
+// rays a pixel) is added into what that surface gathered over the frames before, which the pass after it (aoapply)
+// blurs a little and multiplies into the frame. Where the surface was a frame before comes from the frame's motion;
+// the history there is taken only from texels that showed the same surface (the guides' surfaces, this frame's and the
+// one before's: as deep as the camera's move says, facing the same way), and held within what this frame's own
+// neighbours span, so a shade that moves with a character (its contact shadow) follows it rather than trailing behind.
+// Each frame counts as much as all the frames before it until there are XBE_RT_DN_AO_FRAMES of them.
+cbuffer P : register(b0) {
+    float4 cam;   // the view's depth at the buffer's 0 and its 1, tan of half the view across, down
+    float4 part;  // the 3D's size in depth texels (rw, rh), the ambient occlusion's part of it (aw, ah)
+    float4 ix;    // the SRV heap's indices: this frame's ambient occlusion, the history before, the surfaces now and before
+    float4 ix2;   // the SRV heap's indices: the motion, the depth; the frames gathered at most, the neighbours' span (in
+                  // deviations)
+    float4 m0;    // the camera's move: this frame's clip space to the frame before's, rows
+    float4 m1;
+    float4 m2;
+    float4 m3;
+    float4 opt;   // 1: nothing to gather from; the depth's tolerance (a part of it), the normals' (the least cosine);
+                  // XBE_RT_VIEW
+};
+#include "rt_scene.hlsli"
+
+float ViewZ(float d) { return cam.x * cam.y / (d * cam.x + (1 - d) * cam.y); }
+Texture2D<float4> Tex(float i) { return pictures[NonUniformResourceIndex(uint(i))]; }
+
+float4 ps(float4 pos : SV_Position) : SV_Target {
+    int2 q = int2(pos.xy);
+    int2 size = int2(part.zw);
+    // the full size pixel at the middle of its part, as the ambient occlusion took it
+    int2 px = int2((float2(q) + 0.5) * part.xy / part.zw);
+    float cur = Tex(ix.x).Load(int3(q, 0)).r;
+    float4 s = Tex(ix.z).Load(int3(px, 0));
+    if (s.w <= 0) return float4(cur, 1, 0, 0);  // nothing drawn there
+    // this frame's neighbours: what the history may be held within
+    float mean = 0, sq = 0;
+    [unroll] for (int y = -1; y <= 1; y++)
+        [unroll] for (int x = -1; x <= 1; x++) {
+            float a = Tex(ix.x).Load(int3(clamp(q + int2(x, y), int2(0, 0), size - 1), 0)).r;
+            mean += a;
+            sq += a * a;
+        }
+    mean /= 9;
+    float sd = sqrt(max(sq / 9 - mean * mean, 0));
+    float d = Tex(ix2.y).Load(int3(px, 0)).r;
+    float z = s.w;
+    // where it was, and how deep, had only the camera moved
+    float2 uv = (float2(px) + 0.5) / part.xy + Tex(ix2.x).Load(int3(px, 0)).xy;
+    float4 c = float4((float(px.x) + 0.5) / part.x * 2 - 1, 1 - (float(px.y) + 0.5) / part.y * 2, d, 1);
+    float4 p = float4(dot(m0, c), dot(m1, c), dot(m2, c), dot(m3, c));
+    float zc = abs(p.w) > 1e-20f ? ViewZ(saturate(p.z / p.w)) : z;
+    float2 h = 0;
+    float wsum = 0;
+    if (opt.x == 0 && all(uv >= 0) && all(uv <= 1)) {
+        float2 g = uv * part.zw - 0.5f;
+        int2 g0 = int2(floor(g));
+        float2 f = g - float2(g0);
+        [unroll] for (int k = 0; k < 4; k++) {
+            int2 t = g0 + int2(k & 1, k >> 1);
+            if (any(t < 0) || any(t >= size)) continue;
+            int2 tp = int2((float2(t) + 0.5) * part.xy / part.zw);
+            float4 sp = Tex(ix.w).Load(int3(tp, 0));
+            if (sp.w <= 0) continue;
+            if (min(abs(sp.w - z), abs(sp.w - zc)) > opt.y * z) continue;
+            if (dot(sp.xyz, s.xyz) < opt.z) continue;
+            float w = ((k & 1) ? f.x : 1 - f.x) * ((k >> 1) ? f.y : 1 - f.y) + 1e-4f;
+            h += Tex(ix.y).Load(int3(t, 0)).xy * w;
+            wsum += w;
+        }
+    }
+    float frames = 0, past = cur;
+    if (wsum > 1e-3f) {
+        h /= wsum;
+        frames = h.y;
+        past = clamp(h.x, mean - ix2.w * sd - 0.02f, mean + ix2.w * sd + 0.02f);
+    }
+    frames = min(frames + 1, ix2.z);
+    float ao = lerp(past, cur, 1 / frames);
+    // XBE_RT_VIEW 11: the frames gathered (white the most), black where none
+    if (opt.w == 11) ao = (frames - 1) / max(ix2.z - 1, 1);
+    return float4(ao, frames, 0, 0);
+}
