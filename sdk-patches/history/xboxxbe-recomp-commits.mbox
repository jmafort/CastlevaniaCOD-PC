+        power += e * a;
+        area += a;
+        n += 1;
+    }
+    float scale = float(tris) / max(n, 1);
+    float3 at = area > 0 ? mid / area : 0;
+    if (Luma(power) <= 0) area = 0;  // no light given off (a flame off the screen, a haze): none to remember
+    if (row == 0) return float4(at, area > 0 ? area * scale : -1);
+    if (row == 1) return float4(power * scale, max(0.25f * area / max(n, 1), 3600.0f));
