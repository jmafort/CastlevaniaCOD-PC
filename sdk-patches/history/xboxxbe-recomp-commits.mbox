 runtime/gpu/d3d12.cpp    | 50 +++++++++++++++++++++++++---------------
 runtime/gpu/framegen.cpp | 24 +++++++++++--------
 runtime/gpu/framegen.h   |  3 ++-
 4 files changed, 70 insertions(+), 28 deletions(-)

