+
+HRESULT CreateGraphicsPipelineCached(ID3D12Device* dev, const D3D12_GRAPHICS_PIPELINE_STATE_DESC& d, REFIID riid,
+                                     void** out) {
+    PipelineCache& c = Pipes();
