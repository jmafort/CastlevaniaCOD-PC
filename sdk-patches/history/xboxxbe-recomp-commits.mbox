+// Ray traced reflections' own denoiser, its second step (after rt_refltemporal.hlsl): the gathered reflections smoothed
+// across their neighbours on the same surface, 5 x 5 taps step texels apart, twice (1 then 2 apart: the second pass
+// drawn over the frame, premultiplied, as rt_refl.hlsl's own would be). How far a pixel's light spreads goes with its
+// roughness (a mirror's hardly at all, so its reflection stays sharp; a worn polish's as wide as its blur) and with how
+// few frames it holds yet. A neighbour counts as it lies on the same surface (as deep, facing the same way) and is as
+// rough.
+cbuffer P : register(b0) {
+    float4 cam;   // the view's depth at the buffer's 0 and its 1, tan of half the view across, down
+    float4 part;  // the 3D's size (rw, rh), twice
+    float4 ix;    // the SRV heap's indices: the reflections, the frames they hold, the surfaces; the taps' step
+    float4 opt;   // the SRV heap's index of the guides' normals (roughness in w); the roughness where reflections have
+                  // faded out, the depth's tolerance (a part of it), the normals' sharpness
+    float4 opt2;  // the frames gathered at most; XBE_RT_VIEW; how wide the roughest spreads (in steps)
+};
+#include "rt_scene.hlsli"
+
+Texture2D<float4> Tex(float i) { return pictures[NonUniformResourceIndex(uint(i))]; }
+
+float4 ps(float4 pos : SV_Position) : SV_Target {
+    int2 q = int2(pos.xy);
+    int2 size = int2(part.xy);
+    float4 c = Tex(ix.x).Load(int3(q, 0));
+    float4 sc = Tex(ix.z).Load(int3(q, 0));
+    float rc = Tex(opt.x).Load(int3(q, 0)).w;
+    bool view = opt2.y == 11 || opt2.y == 12;
+    // XBE_RT_VIEW 11: the reflections alone, denoised (black where none); 12: the frames they gathered
+    if (sc.w <= 0 || rc >= opt.y) return view ? float4(0, 0, 0, 1) : c;
+    float frames = max(Tex(ix.y).Load(int3(q, 0)).r, 1);
+    // its spread in taps: none for a mirror, the most for the roughest, wider while few frames are gathered
+    float spread = opt2.z * saturate(rc / (0.75f * opt.y)) * sqrt(saturate(4 / frames) + 0.25f);
+    if (spread < 0.05f || opt2.y == 12) return view ? float4(c.rgb, 1) : c;
+    int step = int(ix.w);
+    float4 sum = 0;
+    float wsum = 0;
+    [unroll] for (int j = -2; j <= 2; j++) {
+        [unroll] for (int i = -2; i <= 2; i++) {
+            int2 t = q + int2(i, j) * step;
+            if (any(t < 0) || any(t >= size)) continue;
+            float w = exp(-float(i * i + j * j) / (2 * spread * spread));
+            if (i != 0 || j != 0) {
+                float4 s = Tex(ix.z).Load(int3(t, 0));
+                if (s.w <= 0) continue;
+                float r = Tex(opt.x).Load(int3(t, 0)).w;
+                w *= exp(-abs(s.w - sc.w) / (opt.z * sc.w * sqrt(float(i * i + j * j)) * step + 1e-3f));
+                w *= pow(saturate(dot(s.xyz, sc.xyz)), opt.w);
+                w *= saturate(1 - abs(r - rc) * 8);
+            }
+            sum += Tex(ix.x).Load(int3(t, 0)) * w;
+            wsum += w;
+        }
+    }
+    float4 o = wsum > 1e-6f ? sum / wsum : c;
+    return view ? float4(o.rgb, 1) : o;
+}
diff --git a/runtime/gpu/rt_refltemporal.hlsl b/runtime/gpu/rt_refltemporal.hlsl
new file mode 100644
index 0000000..aa89638
--- /dev/null
+++ b/runtime/gpu/rt_refltemporal.hlsl
@@ -0,0 +1,95 @@
+// Ray traced reflections' own denoiser, its first step (d3d12.cpp's Reflections, when no vendor's denoiser takes the
+// frame: AMD FSR, or DLSS without Ray Reconstruction's files): this frame's reflections (rt_refl.hlsl, one ray a pixel
+// spread over its roughness, drawn into a target of their own: the colour they add, premultiplied, and the share of the
+// surface's own they take out) are added into what that surface gathered over the frames before. Where the surface
+// was a frame before comes from the frame's motion, its history taken only from pixels that showed the same surface
+// (the guides' surfaces: as deep as the camera's move says, facing the same way) and held within what this frame's own
+// neighbours span: a reflection moves over its surface as the eye does, which the surface's motion does not follow, so
+// a mirror's reflection keeps little history (its rays hardly scatter, so it needs little) and a rough one more (up to
+// XBE_RT_DN_REFL_FRAMES, its rays scattering most).
+cbuffer P : register(b0) {
+    float4 cam;   // the view's depth at the buffer's 0 and its 1, tan of half the view across, down
+    float4 part;  // the 3D's size (rw, rh), twice
+    float4 ix;    // the SRV heap's indices: this frame's reflections, the history before, the surfaces now and before
+    float4 ix2;   // the SRV heap's indices: the motion, the depth, the guides' normals (roughness in w); the frames
+                  // gathered at most
+    float4 m0;    // the camera's move: this frame's clip space to the frame before's, rows
+    float4 m1;
+    float4 m2;
+    float4 m3;
+    float4 opt;   // 1: nothing to gather from; the depth's tolerance (a part of it), the normals' (the least cosine);
+                  // the neighbours' span (in deviations)
+    float4 opt2;  // the roughness where reflections have faded out; XBE_RT_VIEW; the SRV heap's index of the frames
+                  // the history before holds
+};
+#include "rt_scene.hlsli"
+
+float ViewZ(float d) { return cam.x * cam.y / (d * cam.x + (1 - d) * cam.y); }
+Texture2D<float4> Tex(float i) { return pictures[NonUniformResourceIndex(uint(i))]; }
+
+struct Out {
+    float4 history : SV_Target0;  // the reflections gathered, premultiplied as rt_refl.hlsl draws them
+    float frames : SV_Target1;    // how many frames that holds
+};
+
+Out ps(float4 pos : SV_Position) {
+    Out o;
+    int2 px = int2(pos.xy);
+    int2 size = int2(part.xy);
+    float4 cur = Tex(ix.x).Load(int3(px, 0));
+    o.history = cur;
+    o.frames = 1;
+    float4 s = Tex(ix.z).Load(int3(px, 0));
+    float rough = Tex(ix2.z).Load(int3(px, 0)).w;
+    if (s.w <= 0 || rough >= opt2.x) return o;  // nothing drawn, or too rough to reflect
+    // this frame's neighbours: what the history may be held within
+    float4 mean = 0, sq = 0;
+    [unroll] for (int y = -1; y <= 1; y++)
+        [unroll] for (int x = -1; x <= 1; x++) {
+            float4 a = Tex(ix.x).Load(int3(clamp(px + int2(x, y), int2(0, 0), size - 1), 0));
+            mean += a;
+            sq += a * a;
+        }
+    mean /= 9;
+    float4 sd = sqrt(max(sq / 9 - mean * mean, 0));
+    float d = Tex(ix2.y).Load(int3(px, 0)).r;
+    float z = s.w;
+    float2 uv = (float2(px) + 0.5) / part.xy + Tex(ix2.x).Load(int3(px, 0)).xy;
+    float4 c = float4((float(px.x) + 0.5) / part.x * 2 - 1, 1 - (float(px.y) + 0.5) / part.y * 2, d, 1);
+    float4 p = float4(dot(m0, c), dot(m1, c), dot(m2, c), dot(m3, c));
+    float zc = abs(p.w) > 1e-20f ? ViewZ(saturate(p.z / p.w)) : z;
+    float4 h = 0;
+    float n = 0, wsum = 0;
+    if (opt.x == 0 && all(uv >= 0) && all(uv <= 1)) {
+        float2 g = uv * part.xy - 0.5f;
+        int2 g0 = int2(floor(g));
+        float2 f = g - float2(g0);
+        [unroll] for (int k = 0; k < 4; k++) {
+            int2 t = g0 + int2(k & 1, k >> 1);
+            if (any(t < 0) || any(t >= size)) continue;
+            float4 sp = Tex(ix.w).Load(int3(t, 0));
+            if (sp.w <= 0) continue;
+            if (min(abs(sp.w - z), abs(sp.w - zc)) > opt.y * z) continue;
+            if (dot(sp.xyz, s.xyz) < opt.z) continue;
+            float w = ((k & 1) ? f.x : 1 - f.x) * ((k >> 1) ? f.y : 1 - f.y) + 1e-4f;
+            h += Tex(ix.y).Load(int3(t, 0)) * w;
+            n += Tex(opt2.z).Load(int3(t, 0)).r * w;
+            wsum += w;
+        }
+    }
+    // the most it gathers: few for a mirror, the most for the roughest that still reflects
+    float most = max(lerp(3.0f, ix2.w, saturate(rough / (0.75f * opt2.x))), 1);
+    float frames = 0;
+    float4 past = cur;
+    if (wsum > 1e-3f) {
+        h /= wsum;
+        frames = n / wsum;
+        past = clamp(h, mean - opt.w * sd - 0.01f, mean + opt.w * sd + 0.01f);
+    }
+    frames = min(frames + 1, most);
+    o.history = lerp(past, cur, 1 / frames);
+    o.frames = frames;
+    // XBE_RT_VIEW 12: the frames gathered (white the most), red where none
+    if (opt2.y == 12) o.history = float4(frames <= 1 ? 1 : 0, (frames - 1) / max(ix2.w - 1, 1), (frames - 1) / max(ix2.w - 1, 1), 1);
+    return o;
+}
