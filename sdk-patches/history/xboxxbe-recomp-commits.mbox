+bool PaletteIndices(const TextureDesc& d, const uint8_t* guest, std::vector<uint8_t>& out) {
+    if (d.format != 0x0B || d.linear || d.cube || d.depth != 1) return false;
+    uint32_t mx, my, mz;
+    SwizzleMasks(d.width, d.height, 1, mx, my, mz);
+    out.resize(size_t(d.width) * d.height);
+    for (uint32_t y = 0; y < d.height; y++) {
+        uint32_t row = Deposit(y, my);
+        for (uint32_t x = 0; x < d.width; x++) out[size_t(y) * d.width + x] = guest[row | Deposit(x, mx)];
+    }
+    return true;
+}
