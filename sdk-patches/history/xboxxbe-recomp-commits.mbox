+// The bounce lighting's own denoiser, its first step (d3d12.cpp's Lighting, when no vendor's denoiser takes the frame:
+// AMD FSR, or DLSS without Ray Reconstruction's files): each texel of the bounce target (rt_gi.hlsl, the light arriving
+// at a part of the frame's size) is added into what that surface gathered over the frames before. Where the surface
+// was a frame before comes from the frame's motion (each draw's own, else the camera's); the history there is taken
+// only from texels that held the same surface (as near as the camera's move says, facing the same way: a character
+// that walked past a wall leaves the wall's history behind), and each frame counts as much as the frames before it
+// together until there are kFrames of them, so a surface new to the view clears as fast as it can and a still one
+// keeps settling. Its light's mean and mean square go along for the variance the smoothing after it
+// (rt_giatrous.hlsl) is guided by. Writes the history (light, frames), the moments, and the surface each texel is (its
+// world normal and view depth), which the next frame checks its own against.
+cbuffer P : register(b0) {
+    float4 cam;   // the view's depth at the buffer's 0 and its 1, tan of half the view across, down
+    float4 part;  // the 3D's size in depth texels (rw, rh), the bounce target's part (gw, gh)
+    float4 ix;    // the SRV heap's indices: the bounce target, and the frame before's history, moments and surfaces
+    float4 ix2;   // the SRV heap's indices: the motion, the guides' normals, the depth; the frames gathered at most
+    float4 m0;    // the camera's move: this frame's clip space to the frame before's, rows
+    float4 m1;
+    float4 m2;
+    float4 m3;
+    float4 opt;   // 1: nothing to gather from (a cut, a room's first frame); the depth's tolerance (a part of it), the
+                  // normals' (the least cosine); XBE_RT_VIEW
+};
+#include "rt_scene.hlsli"
+
+float ViewZ(float d) { return cam.x * cam.y / (d * cam.x + (1 - d) * cam.y); }
+float Luma(float3 c) { return dot(c, float3(0.2126f, 0.7152f, 0.0722f)); }
+Texture2D<float4> Tex(float i) { return pictures[NonUniformResourceIndex(uint(i))]; }
+
+struct Out {
+    float4 history : SV_Target0;  // the light gathered, the frames it holds
+    float4 moments : SV_Target1;  // its luminance's mean and mean square
+    float4 surface : SV_Target2;  // world normal, view depth (0: no surface)
+};
+
+Out ps(float4 pos : SV_Position) {
+    Out o;
+    o.history = 0;
+    o.moments = 0;
+    o.surface = 0;
+    int2 q = int2(pos.xy);
+    // the depth texel at the middle of its part, as the bounce pass took it
+    int2 px = int2((float2(q) + 0.5) * part.xy / part.zw);
+    float4 cur = Tex(ix.x).Load(int3(q, 0));
+    if (cur.a == 0) return o;  // no bounce there (not the scene's surface, or past its fade)
+    float d = Tex(ix2.z).Load(int3(px, 0)).r;
+    float z = ViewZ(d);
+    float3 n = Tex(ix2.y).Load(int3(px, 0)).xyz;
+    o.surface = float4(n, z);
+    // where it was: its motion, in parts of the 3D's size
+    float2 uv = (float2(px) + 0.5) / part.xy + Tex(ix2.x).Load(int3(px, 0)).xy;
+    // how deep it was, had only the camera moved
+    float4 c = float4((float(px.x) + 0.5) / part.x * 2 - 1, 1 - (float(px.y) + 0.5) / part.y * 2, d, 1);
+    float4 p = float4(dot(m0, c), dot(m1, c), dot(m2, c), dot(m3, c));
+    float zc = abs(p.w) > 1e-20f ? ViewZ(saturate(p.z / p.w)) : z;
+    float4 h = 0;
+    float2 m = 0;
+    float wsum = 0;
+    if (opt.x == 0 && all(uv >= 0) && all(uv <= 1)) {
+        // the four texels about it, each kept only where it held the same surface
+        float2 g = uv * part.zw - 0.5f;
+        int2 g0 = int2(floor(g));
+        float2 f = g - float2(g0);
+        [unroll] for (int k = 0; k < 4; k++) {
+            int2 t = g0 + int2(k & 1, k >> 1);
+            if (any(t < 0) || any(t >= int2(part.zw))) continue;
+            float4 s = Tex(ix.w).Load(int3(t, 0));
+            if (s.w <= 0) continue;
+            if (min(abs(s.w - z), abs(s.w - zc)) > opt.y * z) continue;
+            if (dot(s.xyz, n) < opt.z) continue;
+            float w = ((k & 1) ? f.x : 1 - f.x) * ((k >> 1) ? f.y : 1 - f.y) + 1e-4f;
+            h += Tex(ix.y).Load(int3(t, 0)) * w;
+            m += Tex(ix.z).Load(int3(t, 0)).xy * w;
+            wsum += w;
+        }
+    }
+    float frames = 0;
+    if (wsum > 1e-3f) {
+        h /= wsum;
+        m /= wsum;
+        frames = h.a;
+    }
+    frames = min(frames + 1, ix2.w);
+    float l = Luma(cur.rgb);
+    // a ray that met something far brighter than the surface ever gathered: held to a few deviations above it, so one
+    // frame's spark does not linger for a second
+    if (frames > 4) {
+        float sd = sqrt(max(m.y - m.x * m.x, 0));
+        float top = m.x + 4 * sd + 0.02f;
+        if (l > top) {
+            cur.rgb *= top / l;
+            l = top;
+        }
+    }
+    float a = 1 / frames;
+    o.history = float4(lerp(h.rgb, cur.rgb, a), frames);
+    o.moments = float4(lerp(m, float2(l, l * l), a), 0, 0);
+    // XBE_RT_VIEW 10: the frames gathered (white 32), red where none
+    if (opt.w == 10) o.history = float4(frames <= 1 ? 1 : 0, frames / 32, frames / 32, frames);
+    return o;
+}
