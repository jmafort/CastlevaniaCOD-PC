index 0000000..bb07375
--- /dev/null
+++ b/runtime/gpu/rt_giatrous.hlsl
@@ -0,0 +1,71 @@
+// The bounce lighting's own denoiser, its second step (after rt_gitemporal.hlsl): the gathered light smoothed across
+// its neighbours on the same surface, a few times over with the taps further apart each time (an "a trous" wavelet:
+// 5 x 5 taps 1, 2, 4 and 8 texels apart reach 61 texels across for 100 taps). A neighbour counts as it lies on the
+// same surface (as deep, facing the same way) and as its light is near this texel's, by how far the light still
+// varies here: where the frames gathered have settled it, little is smoothed and the light's own shape stays (a bright
+// patch where the water's light falls); where they have not (a surface new to the view), its noise is smoothed away.
+// The first pass takes the history and its moments (the variance from them, made large where few frames are
+// gathered), each after it the pass before's light and variance.
+cbuffer P : register(b0) {
+    float4 cam;   // the view's depth at the buffer's 0 and its 1, tan of half the view across, down
+    float4 part;  // the 3D's size in depth texels (rw, rh), the bounce target's part (gw, gh)
+    float4 ix;    // the SRV heap's indices: the light (and its variance, or frames on the first pass), the moments (the
+                  // first pass), the surfaces; the taps' step
+    float4 opt;   // 1: the first pass; how far the light may differ (in deviations), the depth's tolerance (a part of
+                  // it), the normals' sharpness
+};
+#include "rt_scene.hlsli"
+
+float Luma(float3 c) { return dot(c, float3(0.2126f, 0.7152f, 0.0722f)); }
+Texture2D<float4> Tex(float i) { return pictures[NonUniformResourceIndex(uint(i))]; }
+
+// a texel's light and variance (the first pass's from its moments)
+float4 LightAt(int2 t) {
+    float4 c = Tex(ix.x).Load(int3(t, 0));
+    if (opt.x == 0) return c;
+    float2 m = Tex(ix.y).Load(int3(t, 0)).xy;
+    float v = max(m.y - m.x * m.x, 0);
+    // few frames: the moments say little yet, so the light is taken to vary as much as it is bright
+    if (c.a < 4) v = max(v, m.x * m.x * 4 / max(c.a, 1));
+    return float4(c.rgb, v);
+}
+
+float4 ps(float4 pos : SV_Position) : SV_Target {
+    int2 q = int2(pos.xy);
+    int2 size = int2(part.zw);
+    float4 sc = Tex(ix.z).Load(int3(q, 0));
+    if (sc.w <= 0) return 0;  // no surface
+    float4 c = LightAt(q);
+    // the variance smoothed over the 3 x 3 about it, steadier to judge by
+    float vs = 0;
+    [unroll] for (int y = -1; y <= 1; y++)
+        [unroll] for (int x = -1; x <= 1; x++) {
+            int2 t = clamp(q + int2(x, y), int2(0, 0), size - 1);
+            float k = (x == 0 ? 0.5f : 0.25f) * (y == 0 ? 0.5f : 0.25f);
+            vs += LightAt(t).a * k;
+        }
+    float lc = Luma(c.rgb);
+    float spread = opt.y * sqrt(max(vs, 0)) + 1e-4f;
+    int step = int(ix.w);
+    static const float kK[3] = {0.375f, 0.25f, 0.0625f};  // B3 spline: 3/8, 1/4, 1/16
+    float3 sum = 0;
+    float vsum = 0, wsum = 0;
+    [unroll] for (int j = -2; j <= 2; j++) {
+        [unroll] for (int i = -2; i <= 2; i++) {
+            int2 t = q + int2(i, j) * step;
+            if (any(t < 0) || any(t >= size)) continue;
+            float4 s = (i == 0 && j == 0) ? sc : Tex(ix.z).Load(int3(t, 0));
+            if (s.w <= 0) continue;
+            float4 l = (i == 0 && j == 0) ? c : LightAt(t);
+            float w = kK[abs(i)] * kK[abs(j)];
+            w *= exp(-abs(s.w - sc.w) / (opt.z * sc.w * sqrt(float(i * i + j * j)) * step + 1e-3f));
+            w *= pow(saturate(dot(s.xyz, sc.xyz)), opt.w);
+            w *= exp(-abs(Luma(l.rgb) - lc) / spread);
+            sum += l.rgb * w;
+            vsum += l.a * w * w;
+            wsum += w;
+        }
+    }
+    if (wsum <= 1e-6f) return c;
+    return float4(sum / wsum, vsum / (wsum * wsum));
+}
