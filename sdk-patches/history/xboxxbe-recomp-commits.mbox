+
+struct Glow {
+    float3 p;   // where, this frame's view space
+    float age;  // -1: none; 0: drawn this frame; frames out of view
+    float4 b;   // its light, its least distance
+};
+// slot s as the frame before left it, moved into this frame's view
+Glow Before(uint s) {
+    Glow g;
+    g.p = 0;
+    g.age = -1;
+    g.b = 0;
