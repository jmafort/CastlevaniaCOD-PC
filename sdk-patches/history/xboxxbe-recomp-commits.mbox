From ede471fab8e5b20e5d4695f4d3eb810945bc9120 Mon Sep 17 00:00:00 2001
From: PlatinumMimic <julianharmon100@gmail.com>
Date: Fri, 6 Nov 2026 13:57:59 -0500
Subject: [PATCH] Ray traced ambient occlusion: its gather lenient with a
 statue's facets, held less tightly to a frame's grain

The same-surface tests of the AO's history are its own now (XBE_RT_DN_AO_DEPTH 0.15, XBE_RT_DN_AO_NORMAL 0.3, a
cosine), looser than the bounce lighting's: at half size a statue's facets land on one another as the camera turns.
The history is held within 3 deviations of this frame's neighbours (XBE_RT_DN_AO_SPAN, was 1.5): at 1.5 it was
pulled to each frame's own grain, and the save room's side walls, with their statues, still changed a little with the
camera's every turn.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01P39J2XTW6h6BAjQxxWwA47
---
 runtime/gpu/d3d12.cpp | 16 +++++++++++-----
 1 file changed, 11 insertions(+), 5 deletions(-)

diff --git a/runtime/gpu/d3d12.cpp b/runtime/gpu/d3d12.cpp
index 70477a5..9c7ddd8 100644
--- a/runtime/gpu/d3d12.cpp
+++ b/runtime/gpu/d3d12.cpp
@@ -7511,17 +7511,23 @@ void D3D12Backend::Water(Target& t, uint32_t rw, uint32_t rh) {
     }
 }
 
-// Ray traced ambient occlusion gathered over the frames (rt_aotemporal.hlsl), for the blur and multiply after it, when
-// no vendor's denoiser takes the frame: XBE_RT_DN_AO_FRAMES at most (16), held within this frame's neighbours' span
-// (XBE_RT_DN_AO_SPAN deviations, 1.5)
+// Ray traced ambient occlusion gathered over the frames (rt_aotemporal.hlsl), for the blur and multiply after it:
+// XBE_RT_DN_AO_FRAMES at most (16), held within this frame's neighbours' span (XBE_RT_DN_AO_SPAN deviations, 3; at
+// 1.5 the history was pulled to each frame's own grain, and the save room's side walls, with their statues, still
+// changed a little with the camera's every turn)
 ID3D12Resource* D3D12Backend::GatherAmbientOcclusion(uint32_t rw, uint32_t rh, uint32_t aw, uint32_t ah) {
     const uint32_t w = guide_w_, h = guide_h_;
     if (!ao_ || ao_w_ != w || ao_h_ != h || !EnsureOwnDenoiseTargets(w, h)) return nullptr;
     static const int kView = std::getenv("XBE_RT_VIEW") ? std::atoi(std::getenv("XBE_RT_VIEW")) : 0;
     auto env = [](const char* n, float d) { const char* e = std::getenv(n); return e ? float(std::atof(e)) : d; };
+    // the same surface a frame before: as deep within XBE_RT_DN_AO_DEPTH (0.15) of its depth, facing within
+    // XBE_RT_DN_AO_NORMAL (0.3, a cosine) of its way. Looser than the bounce lighting's (0.1, 0.8): at half size a
+    // statue's facets land on one another as the camera turns, and at 0.8 a statue's history was thrown away every
+    // frame of a pan, its shade starting over from one frame's 8 rays (the save room's statues flickered, its walls
+    // not); what the history may hold is bounded by this frame's neighbours anyway (the span)
     static const float kFrames = std::clamp(env("XBE_RT_DN_AO_FRAMES", 16), 1.0f, 255.0f),
-                       kSpan = env("XBE_RT_DN_AO_SPAN", 1.5f), kDepth = env("XBE_RT_DN_DEPTH", 0.1f),
-                       kNormal = env("XBE_RT_DN_NORMAL", 0.8f);
+                       kSpan = env("XBE_RT_DN_AO_SPAN", 3.0f), kDepth = env("XBE_RT_DN_AO_DEPTH", 0.15f),
+                       kNormal = env("XBE_RT_DN_AO_NORMAL", 0.3f);
     const D3D12_RESOURCE_STATES kRead =
         D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE | D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE;
     uint32_t cur = 6 + (aodn_cur_ ^ 1), prev = 6 + aodn_cur_;
