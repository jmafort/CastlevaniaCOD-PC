+// Halton's sequence in a base, from index 1: anti-aliasing's offsets, as AMD's own samples take them
+float Halton(int32_t index, int32_t base) {
+    float f = 1, r = 0;
+    for (int32_t i = index; i > 0; i /= base) {
+        f /= float(base);
+        r += f * float(i % base);
+    }
+    return r;
+}
