 }
 
+// XBE_AO_VIEW: ambient occlusion drawn in place of the frame's 3D: 1 its shade, 2 the view depth it reads in bands of
+// 1000 units (to see the title's scale), 3 the same from its own pass, 4 why it gives none, 5 3 and 4 by turns; 0 unset
+inline int AoView() {
+    static const int v = [] {
+        const char* e = std::getenv("XBE_AO_VIEW");
+        return e ? std::atoi(e) : 0;
+    }();
+    return v;
+}
+
+// XBE_AO_RADIUS, XBE_AO_STRENGTH: ambient occlusion's radius in the title's units and its strength in place of the
+// quality's (to tune it); def when unset
+inline float AoRadius(float def) {
+    static const char* v = std::getenv("XBE_AO_RADIUS");
+    return v ? float(std::atof(v)) : def;
+}
+inline float AoStrength(float def) {
+    static const char* v = std::getenv("XBE_AO_STRENGTH");
+    return v ? float(std::atof(v)) : def;
+}
