+        hdr_before_ = nullptr;
+        Transition(fg_hudless_[k].Get(), fg_hudless_state_[k], D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE);
+        in.hudless = fg_hudless_[k].Get();
