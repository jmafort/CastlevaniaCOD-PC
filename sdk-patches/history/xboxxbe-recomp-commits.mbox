+    uint tris = max(lights[li].y, 1u);
+    // a few of its triangles' middles, for a light of many (a glow's many quads)
+    uint stride = max(1u, (tris + 31u) / 32u);
+    float3 mid = 0, power = 0;
+    float area = 0, n = 0;
