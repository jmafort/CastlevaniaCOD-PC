+bool D3D12Backend::Guides(const Target& t, uint32_t rw, uint32_t rh) {
+    if (guide_frame_ == presents_) return true;
+    static const DXGI_FORMAT kFmt[2] = {DXGI_FORMAT_R8G8B8A8_UNORM, DXGI_FORMAT_R10G10B10A2_UNORM};
