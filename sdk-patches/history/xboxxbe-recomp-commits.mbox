-    float m = max(max(l.r, l.g), l.b);
+    // the rise above the knee goes by the brightest channel over the pixel's surroundings (nine taps two pixels
+    // apart), not the pixel's own: the curve's slope is 36 at white with a peak of 8, so a level's change in one
+    // pixel, the ray traced lighting's grain on a lit wall, was a flicker of a third of 4000 nits as the camera
+    // turned (the save room's walls and statues); over the surroundings the rise is the wall's, and the grain keeps
+    // the share of the light it has in SDR
+    float2 ts;
+    img.GetDimensions(ts.x, ts.y);
+    float m = 0;
+    [unroll] for (int y = -1; y <= 1; y++)
+        [unroll] for (int x = -1; x <= 1; x++) {
+            float3 s = img.SampleLevel(ls, i.uv + float2(x, y) * 2 / ts, 0).rgb * opts.w;
+            if (opts.x > 0) s = float3(lut.Sample(ps, float2(s.r, 0.5)).r, lut.Sample(ps, float2(s.g, 0.5)).g, lut.Sample(ps, float2(s.b, 0.5)).b);
+            s = Linear(s);
+            m += max(max(s.r, s.g), s.b);
+        }
