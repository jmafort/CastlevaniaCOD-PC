+// Ray traced light shafts (d3d12.cpp's Shafts): the light the air catches on its way to the eye. Each texel of a quarter
+// of the frame's size marches along its ray from the eye to what the frame drew (no farther than a reach), a few steps
+// a frame at places that move each frame, and at each step asks how much light reaches that bit of air: the sky's (a
+// ray toward the light above, the shadow ray of rt_ao.hlsl's characters' light: where it leaves the scene the sky's
+// colour comes in, so the open air under an arch, between trees, past a window's bars is lit and the rest is not) and
+// the scene's lights' (a torch, a fire, a spell: a point on one of them at random, its light falling off with distance,
+// a ray toward it for its shadow), the air thinning the light it passes on with distance. Three steps: the march into
+// a target of its own, gathered over the frames with the one before (moved by the frame's motion, held within what this
+// frame's neighbours span), and laid over the frame at its full size, added (the game's own fog stays as it was).
+cbuffer P : register(b0) {
+    float4 cam;   // the view's depth at the buffer's 0 and its 1, tan of half the view across, down
+    float4 part;  // the 3D's size in depth texels (rw, rh), the shafts' target's part (sw, sh)
+    float4 mode;  // 0: march, 1: gather, 2: lay over the frame; XBE_RT_VIEW; the frame's number; 1: nothing to gather from
+    float4 fog;   // the air's thickness (a part of the light caught a unit), the farthest a march reaches, its steps,
+                  // the shafts' strength
+    float4 sky;   // the light from above in view space; the SRV heap's index of the sky's colour and share (-1: none)
+    float4 ix;    // the SRV heap's indices: the depth, this frame's march (laid over: this frame's gathered), the gathered
+                  // before, the motion
+    float4 lt;    // the scene's lights listed, their brightness in the air, the sky's light's strength, the share of
+                  // the frame that is sky where it is whole
+    float4 size;  // the shafts' targets' whole size (tw, th)
+    uint4 lights[32];  // each light's draw among the scene's and its triangles (rt_gi.hlsl's)
+};
+#include "rt_scene.hlsli"
+
+Texture2D<float4> Tex(float i) { return pictures[NonUniformResourceIndex(uint(i))]; }
+float ViewZ(float d) { return cam.x * cam.y / (d * cam.x + (1 - d) * cam.y); }
+float Hash(uint3 v) {
+    v = v * 1664525u + 1013904223u;
+    v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;
+    v ^= v >> 16u;
+    v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;
+    return float(v.x & 0xFFFFFF) / 16777216.0f;
+}
+
+// one sample of the scene's lights' light at a point of the air (all ways alike), its shadow ray traced
+float3 LightIn(float3 x, uint2 id, uint frame, uint k) {
+    uint count = min(uint(lt.x), 32u);  // the list holds 32
+    if (count == 0) return 0;
+    float u0 = Hash(uint3(id, frame * 64u + k + 101u)), u1 = Hash(uint3(id.yx + 31u, frame * 64u + k + 211u));
+    float u2 = Hash(uint3(id + 977u, frame * 64u + k + 331u)), u3 = Hash(uint3(id.yx + 4111u, frame * 64u + k + 457u));
+    uint li = min(uint(u0 * count), count - 1);
+    uint geom = lights[li].x, tris = max(lights[li].y, 1u);
+    uint prim = min(uint(u1 * tris), tris - 1);
+    float su = sqrt(u2);
+    float2 bary = float2(su * (1 - u3), su * u3);
+    Spot s = SpotOf(geom, prim, bary);
+    float3 e = s.tint.rgb * s.tint.a;
+    if (geo[geom].c.w > 2.5f) {
+        // drawn flat: where it shows, before what the frame drew there; a haze over the view is none
+        if (FlatShare(s) > 0.02f) return 0;
+        FlatAt(s, 0.97f * ViewZ(Tex(ix.x).Load(int3(FlatPixel(s, bary), 0)).r));
+    }
+    float3 q = s.p[0] * (1 - bary.x - bary.y) + s.p[1] * bary.x + s.p[2] * bary.y;
+    float area = 0.5f * length(cross(s.p[1] - s.p[0], s.p[2] - s.p[0]));
+    uint pic = geo[geom].a.z;
+    if (pic != kNone) {
+        float4 c = pictures[NonUniformResourceIndex(pic)].SampleLevel(wrap, s.at, 2);
+        e *= c.rgb * (geo[geom].c.w == 1 || geo[geom].c.w == 3 ? c.a : 1.0f);
+    }
+    float3 d = q - x;
+    float d2 = dot(d, d);
+    float dist = sqrt(d2);
+    if (dist < 1e-3f || TraceScene(x, d / dist, 0, dist * 0.98f, 4) >= 0) return 0;
+    // over how likely that point was: its triangle's area, its light's triangles, the lights
+    return e * area * float(tris) * float(count) / (d2 + area * 0.25f) / 12.566371f;
+}
+
+float4 ps(float4 pos : SV_Position) : SV_Target {
+    uint2 id = uint2(pos.xy);
+    uint frame = uint(mode.z);
+    if (mode.x == 2) {
+        // laid over the frame: the gathered shafts at this pixel, read smoothly from their smaller target's drawn part
+        float2 at = clamp(pos.xy / part.xy * part.zw, 0.5f, part.zw - 0.5f);
+        float3 c = Tex(ix.y).SampleLevel(wrap, at / size.xy, 0).rgb;
+        if (mode.y == 16) return float4(c * 4, 1);  // XBE_RT_VIEW 16: the shafts alone, brightened
+        return float4(c * fog.w, 0);
+    }
+    if (mode.x == 1) {
+        // gathered: this frame's march with the frames before's, moved by the frame's motion and held within what this
+        // frame's neighbours span
+        int2 size = int2(part.zw);
+        float3 cur = Tex(ix.y).Load(int3(id, 0)).rgb;
+        float3 lo = cur, hi = cur;
+        [unroll] for (int y = -1; y <= 1; y++)
+            [unroll] for (int x = -1; x <= 1; x++) {
+                float3 a = Tex(ix.y).Load(int3(clamp(int2(id) + int2(x, y), int2(0, 0), size - 1), 0)).rgb;
+                lo = min(lo, a);
+                hi = max(hi, a);
+            }
+        if (mode.w != 0) return float4(cur, 1);
+        int2 px = int2((float2(id) + 0.5f) * part.xy / part.zw);
+        float2 uv = (float2(px) + 0.5f) / part.xy + Tex(ix.w).Load(int3(px, 0)).xy;
+        if (any(uv < 0) || any(uv > 1)) return float4(cur, 1);
+        float2 g = uv * part.zw - 0.5f;
+        int2 g0 = int2(floor(g));
+        float2 f = g - float2(g0);
+        float3 h = 0;
+        [unroll] for (int k = 0; k < 4; k++) {
+            int2 t = clamp(g0 + int2(k & 1, k >> 1), int2(0, 0), size - 1);
+            float w = ((k & 1) ? f.x : 1 - f.x) * ((k >> 1) ? f.y : 1 - f.y);
+            h += Tex(ix.z).Load(int3(t, 0)).rgb * w;
+        }
+        h = clamp(h, lo - 0.002f, hi + 0.002f);
+        return float4(lerp(h, cur, 0.12f), 1);
+    }
+    // the march: from the eye to what the frame drew there, or the reach
+    int2 px = int2((float2(id) + 0.5f) * part.xy / part.zw);
+    float d = Tex(ix.x).Load(int3(px, 0)).r;
+    float2 uv = (float2(px) + 0.5f) / part.xy;
+    float3 dir = normalize(float3((uv.x * 2 - 1) * cam.z, (1 - uv.y * 2) * cam.w, 1));
+    float z = ViewZ(d);
+    float len = min(z / max(dir.z, 1e-4f), fog.y);
+    int steps = max(int(fog.z), 1);
+    float dt = len / float(steps);
+    float jitter = Hash(uint3(id, frame));
+    // the sky's colour, as much as the frame shows sky (none indoors)
+    float3 skyc = 0;
+    if (sky.w >= 0) {
+        float4 sc = pictures[NonUniformResourceIndex(uint(sky.w))].Load(int3(0, 0, 0));
+        skyc = sc.rgb * lt.z * saturate(sc.a / max(lt.w, 1e-3f));
+    }
+    bool open = any(skyc > 0);
+    float3 sum = 0;
+    [loop] for (int i = 0; i < steps; i++) {
+        float t = (float(i) + jitter) * dt;
+        float3 x = dir * t;
+        float thin = exp(-fog.x * t);  // the air between it and the eye
+        float3 in_ = 0;
+        if (open) {
+            // the sky's light: a ray toward the light above, spread a little (the frames gather its width)
+            float3 up = sky.xyz;
+            float3 tu = normalize(abs(up.y) < 0.99f ? cross(up, float3(0, 1, 0)) : cross(up, float3(1, 0, 0)));
+            float3 bu = cross(up, tu);
+            float v1 = Hash(uint3(id, frame * 64u + uint(i) + 7u)), v2 = Hash(uint3(id.yx + 13u, frame * 64u + uint(i) + 17u));
+            float rr = sqrt(v1) * 0.15f, ra = 6.2831853f * v2;
+            float3 ld = normalize(up + tu * (rr * cos(ra)) + bu * (rr * sin(ra)));
+            if (TraceScene(x, ld, 0, 1e30f, 4) < 0) in_ += skyc;
+        }
+        in_ += LightIn(x, id, frame, uint(i)) * lt.y;
+        sum += in_ * thin * fog.x * dt;
+    }
+    return float4(sum, 1);
+}
diff --git a/runtime/gpu/rt_water.hlsl b/runtime/gpu/rt_water.hlsl
new file mode 100644
index 0000000..94b3b9f
--- /dev/null
+++ b/runtime/gpu/rt_water.hlsl
@@ -0,0 +1,89 @@
+// Ray traced reflections on water (raytrace.cpp, d3d12.cpp's Water): where a pixel's ray from the eye meets the scene's
+// water (the frame before's pools and fountains, which the port marks, Extension::Water, and which the title draws after
+// the frame is anti-aliased: Scene::LateCapture, moved into this frame's view) before what the frame drew behind
+// it, a ray along the mirror direction off the water's face, rippled by a few slow waves over it (laid in the world, so
+// they stay put as the camera moves), takes on what it meets (that draw's picture times its vertices' colour, the light
+// the game gave it) and is laid over the water in its Fresnel share: little looking straight down into it, most at a
+// low angle across it, as water is. Premultiplied over the frame (the share of the frame's own it replaces in alpha);
+// its second target, when the guides are drawn, the ray's length for DLSS Ray Reconstruction. Pixels without water are
+// left as they were, and the water is there as much as the game's own draw of it is (its picture's alpha times its
+// vertices': the pool's mesh reaches past its basin, clear there).
+cbuffer P : register(b0) {
+    float4 cam;    // the view's depth at the buffer's 0 and its 1, tan of half the view across, down
+    float4 part;   // the 3D's size (rw, rh), twice
+    float4 wt;     // strength, the farthest a ray reaches, the ripples' slope, the distance where it has faded out
+    float4 fr;     // the time in seconds, XBE_RT_VIEW, the rays' start off the surface: a constant and a part of the depth
+    float4 right;  // the view's x (right), y (up) and z (ahead) in the world, and its place; w of right: the ripples'
+    float4 up;     // length
+    float4 ahead;
+    float4 place;
+};
+#include "rt_scene.hlsli"
+Texture2D<float> depth : register(t1);
+
+float ViewZ(float d) { return cam.x * cam.y / (d * cam.x + (1 - d) * cam.y); }
+float3 ViewPos(float2 px, float d) {
+    float2 uv = (px + 0.5) / part.xy;
+    float z = ViewZ(d);
+    return float3((uv.x * 2 - 1) * cam.z * z, (1 - uv.y * 2) * cam.w * z, z);
+}
+float3 ToWorld(float3 v) { return right.xyz * v.x + up.xyz * v.y + ahead.xyz * v.z; }
+float3 ToView(float3 w) { return float3(dot(w, right.xyz), dot(w, up.xyz), dot(w, ahead.xyz)); }
+
+struct Out {
+    float4 color : SV_Target0;
+    float hit : SV_Target1;
+};
+
+Out ps(float4 pos : SV_Position) {
+    float2 px = floor(pos.xy);
+    float3 p = ViewPos(px, depth.Load(int3(int2(px), 0)));
+    // what the frame drew there (nothing: the far plane): the water must lie before it
+    float len = p.z >= 0.999 * max(cam.x, cam.y) ? 1e30f : length(p);
+    float3 dir = normalize(p);
+    float alpha;
+    float t = TraceWater(0, dir, 0, len * 0.999f, alpha);
+    // the water's face: from where its neighbours' rays met it (a pixel without water takes its own plane's tilt)
+    float3 at = dir * max(t, 0);
+    float3 n = normalize(cross(ddy(at), ddx(at)));
+    if (t < 0 || at.z >= wt.w || any(isnan(n))) discard;  // no water before it, or too far: as it was
+    if (dot(n, dir) > 0) n = -n;
+    // ripples: a few slow waves across it, laid along the world's axes over its face
+    float3 nw = ToWorld(n);
+    float3 aw = place.xyz + ToWorld(at);
+    float3 ta = normalize(cross(nw, abs(nw.x) < 0.9f ? float3(1, 0, 0) : float3(0, 0, 1)));
+    float3 tb = cross(nw, ta);
+    float2 c = float2(dot(aw, ta), dot(aw, tb)) / max(right.w, 1);
+    float time = fr.x;
+    float2 g = float2(cos(c.x * 1.0f + time * 0.9f) * 0.5f + cos(c.x * 0.6f + c.y * 0.8f + time * 0.7f) * 0.3f,
+                      cos(c.y * 1.3f - time * 0.8f) * 0.4f + cos(c.x * 0.6f + c.y * 0.8f + time * 0.7f) * 0.4f);
+    float3 bent = normalize(nw - wt.z * (ta * g.x + tb * g.y));
+    n = normalize(ToView(bent));
+    float3 r = reflect(dir, n);
+    if (dot(r, n) <= 0) r = reflect(dir, normalize(ToView(nw)));
+    float3 o = at + n * (fr.z + fr.w * t);
+    uint g2, p2;
+    float2 b2;
+    float t2 = TraceScene(o, r, 0, wt.y, 16, g2, p2, b2);
+    if (t2 < 0) discard;  // nothing within reach (the open sky): the water as the game drew it
+    Spot hs = SpotOf(g2, p2, b2);
+    float3 seen = hs.tint.rgb;
+    uint pic2 = geo[g2].a.z;
+    float pixel = 2 * cam.w / part.y;
+    if (pic2 != kNone) {
+        Texture2D<float4> pt = pictures[NonUniformResourceIndex(pic2)];
+        seen *= pt.SampleLevel(wrap, hs.at, LevelOf(pt, hs, (t + t2) * pixel)).rgb;
+    }
+    Out o2;
+    o2.hit = t2;
+    // XBE_RT_VIEW 13: the water's reflections alone (as much as the water is there), 14: how much of it is there
+    if (fr.y == 13 || fr.y == 14) {
+        o2.color = float4(fr.y == 14 ? alpha.xxx : seen * alpha, 1);
+        return o2;
+    }
+    // water's Fresnel share (Schlick's, its reflectance head on 2%), faded out with distance and near the rays' reach
+    float f = 0.02f + 0.98f * pow(1 - saturate(dot(-dir, n)), 5);
+    float k = wt.x * f * alpha * saturate(4 * (1 - t2 / wt.y)) * saturate((wt.w - at.z) / (0.25f * wt.w));
+    o2.color = float4(seen * k, k);
+    return o2;
+}
