 1 file changed, 79 insertions(+), 9 deletions(-)

diff --git a/runtime/gpu/d3d12.cpp b/runtime/gpu/d3d12.cpp
index f940a67..c863f26 100644
--- a/runtime/gpu/d3d12.cpp
+++ b/runtime/gpu/d3d12.cpp
@@ -293,7 +293,22 @@ float4 scene(O i) : SV_Target {
