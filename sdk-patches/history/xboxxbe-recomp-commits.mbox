+    float held = 0;
+    if (area > 0) {
+        float reach = max(gm2.x * sqrt(area * scale), gm2.y);
+        [loop] for (uint slot = 0; slot < uint(gm2.w); slot++) {
+            Glow g = Before(slot);
+            if (g.age >= 0 && length(g.p - at) < reach) {
+                held = 1;
+                break;
+            }
+        }
+    }
+    return float4(held, 0, 0, 0);
+}
+
+// step 1: slot s this frame, before a light new to the slots is put in a free one: the light it was matched with
+// (the nearest listed within reach) drawn this frame, else remembered while off screen
+Glow Now(uint s) {
+    Glow g = Before(s);
+    if (g.age < 0) return g;
+    // two slots come to hold one glow (the light that kept them apart gone): the later one gives way
+    [loop] for (uint k = 0; k < s; k++) {
+        Glow h = Before(k);
+        if (h.age >= 0 && length(h.p - g.p) < gm2.y) {
+            g.age = -1;
+            return g;
+        }
+    }
+    uint count = min(uint(lt.x), 128u);
+    int best = -1;
+    float bd = 1e30f;
+    [loop] for (uint li = 0; li < count; li++) {
+        float4 a = Tex(gm.y).Load(int3(li, 0, 0));
+        if (a.w <= 0) continue;
+        float d = length(a.xyz - g.p);
+        if (d < max(gm2.x * sqrt(a.w), gm2.y) && d < bd) {
+            bd = d;
+            best = int(li);
+        }
+    }
+    if (best >= 0) {
+        g.p = Tex(gm.y).Load(int3(best, 0, 0)).xyz;
+        g.age = 0;
+        g.b = Tex(gm.y).Load(int3(best, 1, 0));
+        return g;
+    }
+    if (OnScreen(g.p) || g.age + 1 > gm.w) {
+        g.age = -1;
+        return g;
+    }
+    g.age += 1;
+    return g;
+}
+
+float4 ps(float4 pos : SV_Position) : SV_Target {
+    uint2 q = uint2(pos.xy);
+    if (gm.x == 0) return Summary(q.x, q.y);
+    uint s = q.x;
+    Glow g = Now(s);
+    if (g.age < 0) {
+        // free: the free slots before it in order take the lights no slot holds in order, this one its own
+        uint rank = 0;
+        [loop] for (uint k = 0; k < s; k++)
+            if (Now(k).age < 0) rank++;
+        uint count = min(uint(lt.x), 128u);
+        [loop] for (uint li = 0; li < count; li++) {
+            float4 a = Tex(gm.y).Load(int3(li, 0, 0));
+            if (a.w <= 0 || Tex(gm.y).Load(int3(li, 2, 0)).x > 0) continue;
+            float4 b = Tex(gm.y).Load(int3(li, 1, 0));
+            if (Luma(b.rgb) <= 0) continue;
+            if (rank == 0) {
+                g.p = a.xyz;
+                g.age = 0;
+                g.b = b;
+                break;
+            }
+            rank--;
+        }
+    }
+    if (q.y == 0) return float4(g.p, g.age);
+    return g.age < 0 ? float4(0, 0, 0, 0) : g.b;
+}
