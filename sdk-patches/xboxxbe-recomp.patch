+#pragma once
+// Linux: AMD FSR 3's upscaler on Vulkan, in AMD FSR's place among the frame's anti-aliasing (framegen::AntiAlias). The
+// FidelityFX SDK 1.1.4's Vulkan backend, built for Linux (an unofficial fork's, upscaler only), runs on vkd3d's own
+// Vulkan device and queue, its inputs and output the renderer's own Vulkan images (linux/vk_images.h). Built with
+// XBE_FSR_VK (XBE_FSR_VK_DIR, the SDK's built tree); without it AMD FSR's place is the renderer's own TAA.
+#include <cstdint>
+#include <memory>
+
+#include "d3d12.h"
+#include "gpu/framegen.h"
+
+namespace gpu::linux_fsr {
+
+// AMD FSR 3 on Vulkan is in this build (XBE_FSR_VK)
+bool Built();
+
+// AMD FSR 3's upscaler on the device's Vulkan device and the queue's; null when it cannot be (logged). Its frames run
+// through AntiAlias::RunQueue, after the renderer has submitted the frame so far: its commands go on the queue after
+// the frame's, not waited for
+std::unique_ptr<framegen::AntiAlias> MakeFsr(ID3D12Device* dev, ID3D12CommandQueue* queue);
+
+}  // namespace gpu::linux_fsr
diff --git a/runtime/linux/game_code.cpp b/runtime/linux/game_code.cpp
new file mode 100644
index 0000000..ff5aebd
--- /dev/null
+++ b/runtime/linux/game_code.cpp
@@ -0,0 +1,718 @@
+// Linux: the recompiled game code built on the player's PC (app/game_code.cpp's, on Windows). xbe_recomp translates
+// each xbe of GameInfo::images to C++, clang compiles that and ld.lld links it into <exe>.so beside the executables,
+// all from the compiler folder: the library has no C runtime of its own, and the names the executable overrides
+// (compiler/<exe>.hooks, written as it was built) bind to the executable's as it is loaded. The first start does this
+// behind a progress window; finished objects are kept, so a closed window or a crash loses only the files in progress.
+#ifndef _WIN32
+#include <fcntl.h>
+#include <signal.h>
+#include <sys/file.h>
+#include <sys/prctl.h>
+#include <sys/resource.h>
+#include <sys/statvfs.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstring>
+#include <fstream>
+#include <string_view>
+#include <thread>
+
+#include <imgui.h>
+#include <backends/imgui_impl_opengl3.h>
+#include <toml++/toml.hpp>
+
+#include "app/app.h"
+#include "core/input.h"
+#include "core/log.h"
+#include "image_symbols.h"
+#include "kernel/disc.h"
+#include "linux/sdl_app.h"
+#include "linux/ui_font.h"
+
+namespace dispatch {
+bool Load(const std::filesystem::path& library);  // cpu/dispatch.cpp
+}
+
+namespace app {
+
+namespace {
+
+namespace fs = std::filesystem;
+
+struct Image {
+    std::string exe;
+    std::string xbe;
+    fs::path config;
+};
+
+// as the CMake build compiles the library (cmake/XbeRecomp.cmake)
+constexpr const char* kClangFlags[] = {"-target", "x86_64-linux-gnu", "-std=c++20", "-O2", "-march=x86-64-v2", "-fPIC",
+                                       "-fno-strict-aliasing", "-DNDEBUG", "-DX86_GAME_CODE", "-nostdinc", "-nostdinc++",
+                                       "-w"};
+constexpr uint64_t kJobMemory = 512ull << 20;  // a compiler's peak on the biggest file is about half of this
+constexpr uint64_t kDiskNeeded = 1ull << 30;    // both images' sources, objects and libraries, with room to spare
+
+enum class Stage { Translating, Compiling, Linking, Ready };
+
+struct Progress {
+    std::atomic<Stage> stage{Stage::Translating};
+    std::atomic<uint64_t> bytes_done{0};
+    std::atomic<uint64_t> bytes_total{0};
+    std::atomic<uint32_t> files_done{0};
+    std::atomic<uint32_t> files_total{0};
+    std::atomic<uint32_t> first_wave{1};
+    std::atomic<int64_t> compile_start{0};
+    std::atomic<bool> cancel{false};
+};
+
+Progress g_progress;
+std::string g_failure;
+bool g_delete_compiler = false;
+uint64_t g_compiler_bytes = 0;
+
+int64_t NowMs() {
+    using namespace std::chrono;
+    return duration_cast<milliseconds>(steady_clock::now().time_since_epoch()).count();
+}
+
+fs::path CompilerDir() { return ExeDir() / "compiler"; }
+
+// the compiler folder's tool, else the PATH's (a build from source links the library itself, and has clang there)
+std::string Tool(const char* name) {
+    std::error_code ec;
+    fs::path own = CompilerDir() / name;
+    return fs::exists(own, ec) ? own.string() : std::string(name);
+}
+
+fs::path ConfigFor(const std::string& xbe, const std::string& exe) {
+    std::error_code ec;
+    fs::path first;
+    for (auto& e : fs::directory_iterator(CompilerDir() / "config", ec)) {
+        try {
+            toml::table t = toml::parse_file(e.path().string());
+            if (fs::path(t["xbe"]["path"].value_or(std::string())).filename() != xbe) continue;
+            if (t["xbe"]["library"].value_or(std::string()) == exe + ".dll") return e.path();
+            if (first.empty()) first = e.path();
+        } catch (const toml::parse_error&) {
+        }
+    }
+    return first;
+}
+
+std::vector<Image> Images() {
+    std::vector<Image> images;
+    for (auto& [xbe, exe] : kGame.images) images.push_back({exe, xbe, ConfigFor(xbe, exe)});
+    return images;
+}
+
+fs::path WorkDir(const Image& image) { return CompilerDir() / "work" / image.exe; }
+fs::path CodeLibrary(const Image& image) { return ExeDir() / (image.exe + ".so"); }
+fs::path StampFile(const Image& image) { return WorkDir(image) / "built.txt"; }
+fs::path CompileLog() { return ExeDir() / "logs" / "compile.log"; }
+
+bool RecordFailure(const std::string& what) {
+    g_failure = what;
+    LOGE("Game code: %s", what.c_str());
+    return false;
+}
+
+struct Target {
+    const Image* image = nullptr;
+    std::vector<uint8_t> xbe;
+    std::string stamp;
+};
+
+// a library serves the executable it was linked against and the xbe it was translated from
+bool StampFor(const Image& image, const std::vector<uint8_t>& xbe, std::string& stamp) {
+    std::error_code ec;
+    fs::path path = ExeDir() / image.exe;
+    uint64_t size = fs::file_size(path, ec);
+    if (ec) return false;
+    auto time = fs::last_write_time(path, ec).time_since_epoch().count();
+    stamp = std::to_string(size) + " " + std::to_string(time) + " " + Sha1(xbe);
+    return true;
+}
+
+// a library the build linked has no stamp: it is current when not older than the executable, which the build links
+// it after (a copy keeps the times to the second only on some file systems: the Windows drive in WSL)
+bool Current(const Target& target) {
+    std::error_code ec;
+    fs::file_time_type built = fs::last_write_time(CodeLibrary(*target.image), ec);
+    if (ec) return false;
+    std::ifstream f(StampFile(*target.image));
+    if (!f) return built >= fs::last_write_time(ExeDir() / target.image->exe, ec);
+    std::string line;
+    return std::getline(f, line) && line == target.stamp;
+}
+
+bool ReadXbe(const GameFiles& game, const char* name, std::vector<uint8_t>& out) {
+    if (std::string_view(name) == IMAGE_XBE) {
+        out = game.xbe;
+        return true;
+    }
+    std::ifstream f(game.dir / name, std::ios::binary);
+    if (f) {
+        out.assign(std::istreambuf_iterator<char>(f), {});
+        return true;
+    }
+    const kernel::Disc* disc = kernel::MountedDisc();
+    return disc && disc->Load(name, out);
+}
+
+std::vector<Target> StaleTargets(const GameFiles& game, const std::vector<Image>& images) {
+    std::vector<Target> stale;
+    for (const Image& image : images) {
+        Target target{&image};
+        if (!ReadXbe(game, image.xbe.c_str(), target.xbe)) {
+            LOGR("Game code: no %s in the game files, %s is not built", image.xbe.c_str(), image.exe.c_str());
+            continue;
+        }
+        if (!StampFor(image, target.xbe, target.stamp) || Current(target)) continue;
+        stale.push_back(std::move(target));
+    }
+    return stale;
+}
+
+struct Job {
+    fs::path source;
+    fs::path object;
+    uint64_t bytes = 0;
+};
+
+uint32_t PartitionCount(const Image& image) {
+    try {
+        toml::table t = toml::parse_file(image.config.string());
+        return uint32_t(t["xbe"]["partitions"].value_or(int64_t(0)));
+    } catch (const toml::parse_error&) {
+        return 0;
+    }
+}
+
+fs::file_time_type SharedInputsTime(const Image& image) {
+    std::error_code ec;
+    fs::file_time_type newest = fs::last_write_time(WorkDir(image) / "x86_recomp_shared.h", ec);
+    newest = std::max(newest, fs::last_write_time(Tool("clang"), ec));
+    for (auto& e : fs::recursive_directory_iterator(CompilerDir() / "include", ec))
+        newest = std::max(newest, e.last_write_time(ec));
+    return newest;
+}
+
+void AddJobs(const Image& image, std::vector<Job>& jobs) {
+    fs::path work = WorkDir(image);
+    std::vector<std::string> names{"x86_func_mapping"};
+    for (uint32_t i = 0; i < PartitionCount(image); i++) names.push_back("x86_recomp." + std::to_string(i));
+    fs::file_time_type shared = SharedInputsTime(image);
+    for (const std::string& name : names) {
+        Job job{work / (name + ".cpp"), work / (name + ".o")};
+        std::error_code ec;
+        job.bytes = fs::file_size(job.source, ec);
+        fs::file_time_type built = fs::last_write_time(job.object, ec);
+        if (!ec && built > shared && built > fs::last_write_time(job.source, ec)) continue;
+        jobs.push_back(std::move(job));
+    }
+}
+
+// compilers that run at once: one a logical processor, as many as the free memory holds
+size_t Slots() {
+    uint64_t available = 0;
+    std::ifstream f("/proc/meminfo");
+    for (std::string key; f >> key;) {
+        uint64_t kb = 0;
+        f >> kb;
+        if (key == "MemAvailable:") available = kb * 1024;
+        f.ignore(256, '\n');
+    }
+    size_t by_memory = available ? size_t(available / kJobMemory) : 1;
+    size_t by_cpu = size_t(std::max(1L, sysconf(_SC_NPROCESSORS_ONLN)));
+    return std::clamp<size_t>(std::min(by_memory, by_cpu), 1, 64);
+}
+
+// the build's processes: their output to logs/compile.log, all of them ended with a cancel or this process's end
+class Processes {
+public:
+    Processes() {
+        std::error_code ec;
+        fs::create_directories(CompileLog().parent_path(), ec);
+        log_ = open(CompileLog().c_str(), O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0644);
+    }
+    ~Processes() {
+        Cancel();
+        if (log_ >= 0) close(log_);
+    }
+
+    // 0 when it did not start
+    pid_t Start(const std::vector<std::string>& args, const fs::path& dir) {
+        std::vector<char*> argv;
+        for (const std::string& a : args) argv.push_back(const_cast<char*>(a.c_str()));
+        argv.push_back(nullptr);
+        std::string where = dir.string();
+        pid_t parent = getpid();
+        pid_t pid = fork();
+        if (pid == 0) {
+            // only what is safe between fork and exec: the child ends with this process, below normal priority
+            prctl(PR_SET_PDEATHSIG, SIGKILL);
+            if (getppid() != parent) _exit(127);
+            setpriority(PRIO_PROCESS, 0, 10);
+            if (log_ >= 0) {
+                dup2(log_, 1);
+                dup2(log_, 2);
+            }
+            if (chdir(where.c_str()) != 0) _exit(127);
+            execvp(argv[0], argv.data());
+            _exit(127);
+        }
+        if (pid < 0) {
+            LOGE("game code: could not start %s (%s)", args[0].c_str(), std::strerror(errno));
+            return 0;
+        }
+        running_.push_back(pid);
+        return pid;
+    }
+
+    // its exit code once it ends, -1 while it runs
+    int Poll(pid_t pid) {
+        int status = 0;
+        pid_t r = waitpid(pid, &status, WNOHANG);
+        if (r == 0) return -1;
+        running_.erase(std::remove(running_.begin(), running_.end(), pid), running_.end());
+        if (r < 0) return 1;
+        return WIFEXITED(status) ? WEXITSTATUS(status) : 1;
+    }
+
+    // every process's exit code; false when cancelled, which ends them all
+    bool WaitAll(const std::vector<pid_t>& pids, std::vector<int>& codes) {
+        codes.assign(pids.size(), -1);
+        for (;;) {
+            bool all = true;
+            for (size_t i = 0; i < pids.size(); i++) {
+                if (codes[i] < 0) codes[i] = Poll(pids[i]);
+                all &= codes[i] >= 0;
+            }
+            if (all) return true;
+            if (g_progress.cancel) return Cancel();
+            std::this_thread::sleep_for(std::chrono::milliseconds(50));
+        }
+    }
+
+    bool Cancel() {
+        for (pid_t pid : running_) kill(pid, SIGKILL);
+        for (pid_t pid : running_) waitpid(pid, nullptr, 0);
+        running_.clear();
+        return false;
+    }
+
+private:
+    int log_ = -1;
+    std::vector<pid_t> running_;
+};
+
+bool Translate(std::vector<Target>& targets, Processes& run) {
+    std::vector<pid_t> pids;
+    for (Target& target : targets) {
+        fs::path work = WorkDir(*target.image);
+        fs::path xbe = work / target.image->xbe;
+        std::ofstream(xbe, std::ios::binary).write(reinterpret_cast<const char*>(target.xbe.data()), target.xbe.size());
+        pid_t pid = run.Start({(CompilerDir() / "xbe_recomp").string(), target.image->config.string(), xbe.string(),
+                               work.string(), "--xdk", (CompilerDir() / "xdk").string()},
+                              work);
+        if (!pid) return RecordFailure("xbe_recomp could not be started.");
+        pids.push_back(pid);
+    }
+    std::vector<int> codes;
+    if (!run.WaitAll(pids, codes)) return false;
+    bool ok = true;
+    for (size_t i = 0; i < pids.size(); i++)
+        if (codes[i]) ok = RecordFailure("Translating " + targets[i].image->xbe + " failed.");
+    return ok;
+}
+
+std::vector<std::string> CompileCommand(const Job& job) {
+    fs::path include = CompilerDir() / "include";
+    std::vector<std::string> args{Tool("clang")};
+    args.insert(args.end(), std::begin(kClangFlags), std::end(kClangFlags));
+    for (std::string a : {std::string("-isystem"), (include / "freestanding").string(), "-I" + include.string(),
+                          std::string("-c"), job.source.filename().string(), std::string("-o"),
+                          job.object.filename().string() + ".tmp"})
+        args.push_back(a);
+    return args;
+}
+
+bool FinishJob(const Job& job, int code) {
+    std::string name = job.source.parent_path().filename().string() + "/" + job.source.filename().string();
+    if (code) return RecordFailure("Compiling " + name + " failed.");
+    fs::path temp = job.object;
+    temp += ".tmp";
+    std::error_code ec;
+    fs::rename(temp, job.object, ec);
+    if (ec) return RecordFailure("Saving the compiled " + name + " failed.");
+    g_progress.bytes_done += job.bytes;
+    g_progress.files_done++;
+    return true;
+}
+
+bool Compile(std::vector<Job>& jobs, Processes& run) {
+    std::sort(jobs.begin(), jobs.end(), [](const Job& a, const Job& b) { return a.bytes > b.bytes; });
+    size_t slots = Slots();
+    LOGR("Game code: compiling %zu files, %zu at a time", jobs.size(), slots);
+    for (const Job& job : jobs) g_progress.bytes_total += job.bytes;
+    g_progress.files_total = uint32_t(jobs.size());
+    g_progress.first_wave = uint32_t(std::min(slots, jobs.size()));
+    g_progress.compile_start = NowMs();
+    g_progress.stage = Stage::Compiling;
+
+    std::vector<std::pair<pid_t, const Job*>> running;
+    size_t next = 0;
+    while (next < jobs.size() || !running.empty()) {
+        for (; running.size() < slots && next < jobs.size(); next++) {
+            pid_t pid = run.Start(CompileCommand(jobs[next]), jobs[next].source.parent_path());
+            if (!pid) {
+                RecordFailure("clang could not be started.");
+                return run.Cancel();
+            }
+            running.emplace_back(pid, &jobs[next]);
+        }
+        if (g_progress.cancel) return run.Cancel();
+        bool any = false;
+        for (size_t i = 0; i < running.size();) {
+            int code = run.Poll(running[i].first);
+            if (code < 0) {
+                i++;
+                continue;
+            }
+            any = true;
+            if (!FinishJob(*running[i].second, code)) return run.Cancel();
+            running.erase(running.begin() + long(i));
+        }
+        if (!any) std::this_thread::sleep_for(std::chrono::milliseconds(50));
+    }
+    return true;
+}
+
+// the version script: the tables and bodies global, and the names the executable overrides, so they bind to its
+bool WriteVersionScript(const Image& image, const fs::path& map) {
+    std::ifstream hooks(CompilerDir() / (image.exe + ".hooks"));
+    if (!hooks) return RecordFailure("The compiler folder is missing " + image.exe + ".hooks.");
+    std::ofstream out(map);
+    out << "{\n  global:\n    X86FuncMappings; X86Continuations; X86CodeBase; X86CodeEnd; X86ImageBase; X86ImageEnd;\n"
+           "    X86EntryPoint; X86KernelThunk; __imp__sub_*;\n";
+    for (std::string name; std::getline(hooks, name);)
+        if (!name.empty()) out << "    " << name << ";\n";
+    out << "  local: *;\n};\n";
+    return bool(out);
+}
+
+bool Link(const Target& target, Processes& run) {
+    const Image& image = *target.image;
+    fs::path work = WorkDir(image);
+    if (!WriteVersionScript(image, work / "code.map")) return false;
+    fs::path temp = CodeLibrary(image);
+    temp += ".tmp";
+    std::vector<std::string> args{Tool("ld.lld"), "-shared", "-z", "noexecstack", "--version-script=code.map", "--undefined-version", "-o",
+                                  temp.string(), "x86_func_mapping.o"};
+    for (uint32_t i = 0; i < PartitionCount(image); i++) args.push_back("x86_recomp." + std::to_string(i) + ".o");
+    std::vector<pid_t> pid{run.Start(args, work)};
+    if (!pid[0]) return RecordFailure("ld.lld could not be started.");
+    std::vector<int> codes;
+    if (!run.WaitAll(pid, codes)) return false;
+    std::string library = CodeLibrary(image).filename().string();
+    if (codes[0]) return RecordFailure("Linking " + library + " failed.");
+    // into place whole, so a running copy of the game keeps the one it has open
+    std::error_code ec;
+    fs::rename(temp, CodeLibrary(image), ec);
+    if (ec) return RecordFailure("Saving " + library + " failed.");
+    std::ofstream(StampFile(image)) << target.stamp << "\n";
+    return true;
+}
+
+bool Build(std::vector<Target>& targets) {
+    Processes run;
+    if (!Translate(targets, run)) return false;
+    std::vector<Job> jobs;
+    for (const Target& target : targets) AddJobs(*target.image, jobs);
+    if (!Compile(jobs, run)) return false;
+    g_progress.stage = Stage::Linking;
+    for (const Target& target : targets)
+        if (!Link(target, run)) return false;
+    return true;
+}
+
+std::string Blocker(const std::vector<Target>& targets) {
+    std::error_code ec;
+    for (const char* tool : {"clang", "ld.lld", "xbe_recomp"})
+        if (!fs::exists(CompilerDir() / tool, ec) && Tool(tool) == (CompilerDir() / tool).string())
+            return "The compiler folder is missing files. Extract the whole release again, then start the game.";
+    for (const Target& target : targets) {
+        if (target.image->config.empty() || !fs::exists(CompilerDir() / (target.image->exe + ".hooks"), ec))
+            return "The compiler folder is missing files. Extract the whole release again, then start the game.";
+        fs::create_directories(WorkDir(*target.image), ec);
+        if (ec) return "The game's folder cannot be written to. Move it somewhere you can write to, such as your home folder.";
+    }
+    struct statvfs v{};
+    if (statvfs(CompilerDir().c_str(), &v) == 0 && uint64_t(v.f_bavail) * v.f_frsize < kDiskNeeded)
+        return "Preparing the game needs 1 GB of free space on the drive it is on.";
+    return {};
+}
+
+std::string StageText() {
+    switch (g_progress.stage.load()) {
+        case Stage::Translating:
+            return "Translating the game's code";
+        case Stage::Compiling:
+            return "Compiling the game's code, file " +
+                   std::to_string(std::min(g_progress.files_done + 1, g_progress.files_total.load())) + " of " +
+                   std::to_string(g_progress.files_total);
+        case Stage::Linking:
+            return "Linking the game's code";
+        default:
+            return "Start the game now?";
+    }
+}
+
+std::string TimeLeftText() {
+    if (g_progress.stage != Stage::Compiling) return {};
+    uint64_t done = g_progress.bytes_done;
+    if (g_progress.files_done < g_progress.first_wave || !done) return "Working out the time left";
+    double elapsed = double(NowMs() - g_progress.compile_start);
+    double left = elapsed * double(g_progress.bytes_total - done) / double(done);
+    int minutes = int(left / 60000.0 + 0.5);
+    if (minutes < 1) return "Less than a minute left";
+    return "About " + std::to_string(minutes) + (minutes == 1 ? " minute left" : " minutes left");
+}
+
+float Fraction() {
+    switch (g_progress.stage.load()) {
+        case Stage::Translating:
+            return 0.0f;
+        case Stage::Compiling:
+            return g_progress.bytes_total ? float(g_progress.bytes_done) / float(g_progress.bytes_total) : 0.0f;
+        default:
+            return 1.0f;
+    }
+}
+
+uint64_t CompilerBytes() {
+    uint64_t bytes = 0;
+    std::error_code ec;
+    for (auto& e : fs::recursive_directory_iterator(CompilerDir(), ec))
+        if (e.is_regular_file(ec)) bytes += e.file_size(ec);
+    return bytes;
+}
+
+void DeleteCompiler() {
+    std::error_code ec;
+    fs::remove_all(CompilerDir(), ec);
+    if (ec) LOGE("Game code: deleting the compiler folder failed: %s", ec.message().c_str());
+    else LOGR("Game code: compiler folder deleted");
+}
+
+std::string CompileLogTail() {
+    constexpr size_t kTailBytes = 1500;
+    std::ifstream f(CompileLog(), std::ios::binary | std::ios::ate);
+    if (!f) return {};
+    std::streamoff size = f.tellg();
+    std::streamoff start = size > std::streamoff(kTailBytes) ? size - std::streamoff(kTailBytes) : 0;
+    std::string tail(size_t(size - start), '\0');
+    f.seekg(start);
+    f.read(tail.data(), std::streamsize(tail.size()));
+    if (start) tail.erase(0, tail.find('\n') + 1);
+    return tail;
+}
+
+void ShowFailure() {
+    std::string text = "Preparing the game failed. " + g_failure;
+    if (std::string tail = CompileLogTail(); !tail.empty()) text += "\n\nThe last lines of the log:\n\n" + tail;
+    text += "\n\nThe full details are in logs/compile.log.";
+    SDL_ShowSimpleMessageBox(SDL_MESSAGEBOX_ERROR, linuxapp::Utf8(kGame.title).c_str(), text.c_str(), nullptr);
+}
+
+// the window's colours, as on Windows
+constexpr ImU32 Rgb(int r, int g, int b) { return IM_COL32(r, g, b, 255); }
+constexpr ImU32 kBackground = Rgb(10, 11, 10), kText = Rgb(227, 232, 219), kDim = Rgb(145, 153, 138);
+constexpr ImU32 kBarEmpty = Rgb(28, 33, 26), kBarFull = Rgb(145, 158, 130);
+
+// top to bottom: a heading, the stage, the bar, then the percentage and time left, or the choices once ready.
+// Returns 1 for Start, 0 for Exit, -1 while it stays up.
+int Paint(float unit) {
+    ImGuiIO& io = ImGui::GetIO();
+    ImDrawList* dl = ImGui::GetBackgroundDrawList();
+    ImVec2 size = io.DisplaySize;
+    dl->AddRectFilled({0, 0}, size, kBackground);
+    bool ready = g_progress.stage == Stage::Ready;
+    float left = unit, right = size.x - unit, y = unit;
+    auto line = [&](float at, const std::string& text, ImU32 color, bool align_right = false) {
+        ImVec2 ts = ImGui::CalcTextSize(text.c_str());
+        float x = align_right ? right - ts.x : left;
+        dl->AddText({x, at + (unit * 2 - ts.y) / 2}, color, text.c_str());
+    };
+    line(y, ready ? "The game is ready." : "Preparing the game for this PC. This only happens once.", kText);
+    y += unit * 2;
+    line(y, StageText(), kDim);
+    y += unit * 2.5f;
+    dl->AddRectFilled({left, y}, {right, y + unit}, kBarEmpty);
+    dl->AddRectFilled({left, y}, {left + (right - left) * Fraction(), y + unit}, kBarFull);
+    y += unit * 1.5f;
+    if (!ready) {
+        line(y, std::to_string(int(Fraction() * 100.0f)) + "%", kDim);
+        line(y, TimeLeftText(), kDim, true);
+        return -1;
+    }
+    // Start (A), Exit (B), and the box that deletes the compiler files (X)
+    ImVec2 exit0{right - unit * 8, y}, exit1{right, y + unit * 2};
+    ImVec2 start0{exit0.x - unit * 9, y}, start1{exit0.x - unit, y + unit * 2};
+    ImVec2 box0{left, y + unit / 2}, box1{left + unit, y + unit * 1.5f};
+    auto inside = [&](ImVec2 a, ImVec2 b) {
+        ImVec2 m = io.MousePos;
+        return m.x >= a.x && m.x < b.x && m.y >= a.y && m.y < b.y;
+    };
+    auto button = [&](ImVec2 a, ImVec2 b, const char* text, ImU32 fill, ImU32 color) {
+        dl->AddRectFilled(a, b, fill);
+        ImVec2 ts = ImGui::CalcTextSize(text);
+        dl->AddText({(a.x + b.x - ts.x) / 2, (a.y + b.y - ts.y) / 2}, color, text);
+    };
+    button(start0, start1, "Start (A)", kBarFull, kBackground);
+    button(exit0, exit1, "Exit (B)", kBarEmpty, kText);
+    dl->AddRectFilled(box0, box1, kBarEmpty);
+    if (g_delete_compiler) dl->AddRectFilled({box0.x + unit / 4, box0.y + unit / 4}, {box1.x - unit / 4, box1.y - unit / 4}, kBarFull);
+    std::string label = "Delete the compiler files, " + std::to_string(g_compiler_bytes >> 20) + " MB (X)";
+    ImVec2 ts = ImGui::CalcTextSize(label.c_str());
+    dl->AddText({box1.x + unit / 2, y + (unit * 2 - ts.y) / 2}, kText, label.c_str());
+
+    static uint16_t held = 0;
+    uint16_t now = input::HeldOnAnyController(), pressed = now & ~held;
+    held = now;
+    constexpr uint16_t kPadA = 0x1000, kPadB = 0x2000, kPadX = 0x4000;
+    bool click = ImGui::IsMouseReleased(0);
+    if ((click && inside(box0, {start0.x - unit, box1.y + unit / 2})) || (pressed & kPadX) ||
+        ImGui::IsKeyPressed(ImGuiKey_Space, false))
+        g_delete_compiler = !g_delete_compiler;
+    if ((click && inside(start0, start1)) || (pressed & kPadA) || ImGui::IsKeyPressed(ImGuiKey_Enter, false)) return 1;
+    if ((click && inside(exit0, exit1)) || (pressed & kPadB) || ImGui::IsKeyPressed(ImGuiKey_Escape, false)) return 0;
+    return -1;
+}
+
+// the build on its own thread, the window on this one; false when it failed, the player stopped it, or chose Exit
+bool BuildWithWindow(std::vector<Target>& targets) {
+    if (std::string blocker = Blocker(targets); !blocker.empty()) {
+        SDL_ShowSimpleMessageBox(SDL_MESSAGEBOX_ERROR, linuxapp::Utf8(kGame.title).c_str(), blocker.c_str(), nullptr);
+        return false;
+    }
+    input::Init();
+    // 520 x 130 at the display's scale, as the Windows window is at its DPI
+    SDL_DisplayID display = SDL_GetPrimaryDisplay();
+    float scale = std::max(1.0f, SDL_GetDisplayContentScale(display));
+    SDL_GL_SetAttribute(SDL_GL_CONTEXT_MAJOR_VERSION, 3);
+    SDL_GL_SetAttribute(SDL_GL_CONTEXT_MINOR_VERSION, 0);
+    SDL_Window* window = SDL_CreateWindow(linuxapp::Utf8(kGame.title).c_str(), int(520 * scale), int(130 * scale),
+                                          SDL_WINDOW_OPENGL | SDL_WINDOW_HIGH_PIXEL_DENSITY);
+    SDL_GLContext gl = window ? SDL_GL_CreateContext(window) : nullptr;
+    if (!gl) {
+        LOGE("Game code: no window for the build (%s), building without one", SDL_GetError());
+        if (window) SDL_DestroyWindow(window);
+        bool ok = Build(targets);
+        if (!ok) ShowFailure();
+        return ok;
+    }
+    SDL_GL_MakeCurrent(window, gl);
+    SDL_GL_SetSwapInterval(1);
+    ImGuiContext* ctx = ImGui::CreateContext();
+    ImGuiIO& io = ImGui::GetIO();
+    io.IniFilename = nullptr;
+    float unit = 10.0f * scale * SDL_GetWindowPixelDensity(window);
+    linuxapp::LoadUiFont(io, unit * 1.5f);
+    ImGui_ImplOpenGL3_Init("#version 130");
+    linuxapp::ImGuiInit(window);
+
+    bool ok = false, done = false;
+    std::atomic<bool> finished{false};
+    std::thread worker([&] {
+        ok = Build(targets);
+        if (ok) {
+            g_compiler_bytes = CompilerBytes();
+            g_progress.stage = Stage::Ready;
+        }
+        finished = true;
+    });
+    int choice = -1;
+    bool flashed = false;
+    while (!done) {
+        SDL_Event e;
+        while (SDL_PollEvent(&e)) {
+            linuxapp::ImGuiEvent(e);
+            // asked to quit (a signal, the session ending): stopped, what is done kept
+            if (e.type == SDL_EVENT_QUIT) {
+                g_progress.cancel = true;
+                choice = 0;
+            } else if (e.type == SDL_EVENT_WINDOW_CLOSE_REQUESTED) {
+                if (g_progress.stage == Stage::Ready) {
+                    choice = 0;
+                } else {
+                    const SDL_MessageBoxButtonData buttons[] = {
+                        {SDL_MESSAGEBOX_BUTTON_RETURNKEY_DEFAULT, 1, "Yes"},
+                        {SDL_MESSAGEBOX_BUTTON_ESCAPEKEY_DEFAULT, 0, "No"}};
+                    std::string title = linuxapp::Utf8(kGame.title);
+                    SDL_MessageBoxData data{SDL_MESSAGEBOX_INFORMATION, window, title.c_str(),
+                                            "Stop preparing the game? What is done so far is kept, and the next start "
+                                            "carries on.",
+                                            2, buttons, nullptr};
+                    int yes = 0;
+                    if (SDL_ShowMessageBox(&data, &yes) && yes) g_progress.cancel = true;
+                }
+            }
+        }
+        int w = 0, h = 0;
+        SDL_GetWindowSizeInPixels(window, &w, &h);
+        linuxapp::g_pixel_w = uint32_t(w);
+        linuxapp::g_pixel_h = uint32_t(h);
+        ImGui_ImplOpenGL3_NewFrame();
+        linuxapp::ImGuiNewFrame();
+        ImGui::NewFrame();
+        int pick = Paint(unit);
+        if (choice < 0) choice = pick;
+        ImGui::Render();
+        ImGui_ImplOpenGL3_RenderDrawData(ImGui::GetDrawData());
+        SDL_GL_SwapWindow(window);
+        if (finished && !flashed) {
+            flashed = true;
+            SDL_FlashWindow(window, SDL_FLASH_UNTIL_FOCUSED);
+        }
+        // failed or stopped: the window goes; ready, it stays up for the player's pick
+        done = (finished && !ok) || choice >= 0;
+    }
+    if (choice >= 0 && !finished) g_progress.cancel = true;
+    worker.join();
+    if (ok && choice >= 0 && g_delete_compiler) DeleteCompiler();
+    ImGui_ImplOpenGL3_Shutdown();
+    ImGui::DestroyContext(ctx);
+    SDL_GL_DestroyContext(gl);
+    SDL_DestroyWindow(window);
+    if (!ok && !g_progress.cancel) ShowFailure();
+    return ok && choice == 1;
+}
+
+}  // namespace
+
+bool PrepareGameCode(const GameFiles& game) {
+    // one build at a time: a second copy of the game started meanwhile waits for it, then finds the library current
+    std::error_code ec;
+    fs::create_directories(CompilerDir() / "work", ec);
+    int lock = open((CompilerDir() / "work" / ".lock").c_str(), O_RDWR | O_CREAT | O_CLOEXEC, 0644);
+    if (lock >= 0) flock(lock, LOCK_EX);
+    std::vector<Image> images = Images();
+    std::vector<Target> stale = StaleTargets(game, images);
+    for (const Target& target : stale) LOGR("Game code: building %s.so", target.image->exe.c_str());
+    bool built = stale.empty() || BuildWithWindow(stale);
+    if (lock >= 0) close(lock);
+    if (!built) return false;
+    for (const Image& image : images)
+        if (image.xbe == IMAGE_XBE && dispatch::Load(CodeLibrary(image))) return true;
+    SDL_ShowSimpleMessageBox(SDL_MESSAGEBOX_ERROR, linuxapp::Utf8(kGame.title).c_str(),
+                             "The game's code could not be loaded, see the log in the logs folder.", nullptr);
+    return false;
+}
+
+}  // namespace app
