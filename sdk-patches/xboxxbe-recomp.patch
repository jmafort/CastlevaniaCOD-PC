+// the game window, null until it is made; its keyboard focus
+inline std::atomic<SDL_Window*> g_window{nullptr};
+inline std::atomic<bool> g_focused{false};
+// the window's size in pixels as the main loop last saw it, for the render thread
+inline std::atomic<uint32_t> g_pixel_w{0}, g_pixel_h{0};
