--- /dev/null
+++ b/runtime/gpu/framegen.h
@@ -0,0 +1,151 @@
+// Frame generation: a frame made between each two the title draws, by AMD FidelityFX Super Resolution 3 frame
+// generation (any Direct3D 12 card) or NVIDIA DLSS frame generation through Streamline (GeForce RTX 40 and 50). And
+// the frame's anti-aliasing and upscaling (AntiAlias), by AMD FSR or NVIDIA DLSS.
+//
+// Neither vendor's libraries come with the game. They are loaded at start from beside the executable when the player
+// put them there (the launcher downloads them from AMD's and NVIDIA's own releases, with their licences):
+//   FSR 3:  amd_fidelityfx_loader_dx12.dll, amd_fidelityfx_framegeneration_dx12.dll, amd_fidelityfx_upscaler_dx12.dll
+//   DLSS:   streamline\sl.interposer.dll, sl.common.dll, sl.dlss_g.dll, sl.reflex.dll, sl.pcl.dll, nvngx_dlssg.dll;
+//           for DLSS anti-aliasing and upscaling sl.dlss.dll and nvngx_dlss.dll too
+// Without them, or on a card that cannot, the setting does nothing and the log says why.
+//
+// Both take the frame as the back buffer has it, its depth and motion vectors at the same size, and the frame as it
+// was before its UI, so the HUD and menus are not warped. The motion is each 3D draw's own where one drew the pixel:
+// the title's vertex program run again on the same draw's constants of the frame before (PrevPositionHlsl and MotionOut in shaders.cpp),
+// so a character moves as its bones did and the world as the camera did; elsewhere the camera's, from the depth buffer
+// and the extension's view (Extension::View). The headers are the vendors' own (third_party, MIT).
+#pragma once
+
+#include <d3d12.h>
+#include <dxgi1_6.h>
+#include <wrl/client.h>
+
+#include <cstdint>
+#include <memory>
+
+#include "gpu/ext.h"
+
+namespace gpu::framegen {
+
+enum Kind : uint32_t { kOff = 0, kFsr = 1, kDlss = 2 };
+
+const char* KindName(uint32_t kind);  // "AMD FSR 3", "NVIDIA DLSS"
+
+// the frame's inputs, on the back buffer at the frame's place in it (rect)
+struct Inputs {
+    ID3D12Resource* back = nullptr;     // the back buffer being drawn, in RENDER_TARGET
+    ID3D12Resource* depth = nullptr;    // R32_FLOAT, rect's size, in PIXEL_SHADER_RESOURCE; null without 3D
+    ID3D12Resource* motion = nullptr;   // R16G16_FLOAT, rect's size: to the frame before, in UV units
+    ID3D12Resource* hudless = nullptr;  // the back buffer's format and size, the frame before its UI; may be null
+    D3D12_RECT rect{};                  // the frame's part of the back buffer (the rest is black bars)
+    FrameView view;
+    float frame_ms = 16.7f;
+    bool reset = false;  // nothing to interpolate from: the first frame, a cut
+    bool hdr = false;    // HDR back buffer: scRGB, or HDR10 when Hdr10()
+    float peak_nits = 1000;
+    bool menu = false;   // the settings menu is up over the frame
+    float jitter[2] = {};  // anti-aliasing's sub-pixel offset of the frame's 3D (AntiAlias), in pixels at rect's size
+};
+
+class FrameGen {
+public:
+    virtual ~FrameGen() = default;
+    virtual uint32_t Kind() const = 0;
+#ifdef _WIN32
+    // the factory and device through the vendor's library where it must see them made (Streamline); false: the
+    // usual way
+    virtual bool CreateFactory(Microsoft::WRL::ComPtr<IDXGIFactory4>&) { return false; }
+    virtual bool CreateDevice(IDXGIAdapter1*, Microsoft::WRL::ComPtr<ID3D12Device>&) { return false; }
+    virtual void DeviceReady(ID3D12Device*, ID3D12CommandQueue*) {}
+    // the swap chain through the vendor's library; false: the usual way
+    virtual bool CreateSwapChain(IDXGIFactory4*, ID3D12CommandQueue*, HWND, const DXGI_SWAP_CHAIN_DESC1&,
+                                 Microsoft::WRL::ComPtr<IDXGISwapChain3>&) {
+        return false;
+    }
+#endif
+    virtual void BeforeResize() {}
+    virtual void Resized(uint32_t /*w*/, uint32_t /*h*/, DXGI_FORMAT) {}
+    // the frame's inputs, recorded into its command list before it is submitted
+    virtual void Frame(ID3D12GraphicsCommandList*, const Inputs&) = 0;
+    virtual void PresentStart() {}
+    virtual void PresentEnd() {}
+    virtual bool Active() const = 0;  // a frame is being generated
+    // HDR as HDR10 (10 bit, PQ, BT.2020) rather than scRGB half floats, which this kind cannot take
+    virtual bool Hdr10() const { return false; }
+    // the frames that reached the screen since the start, the game's and the generated ones; 0 when it can't tell
+    virtual uint64_t Shown() const { return 0; }
+    virtual void Shutdown() {}
+};
+
+// NVIDIA's Streamline, which DLSS frame generation and DLSS share: loaded before the Direct3D device is made, for what
+// the settings ask of it at the start (frame generation by DLSS, anti-aliasing by DLSS); false when neither, or when
+// its files are not there (logged). The factory and device are made through it then (StreamlineFactory and
+// StreamlineDevice: frame generation's factory, either's device), and it is given the device (StreamlineDeviceReady).
+#ifdef _WIN32
+bool LoadStreamline(bool frame_generation, bool dlss);
+bool StreamlineFactory(Microsoft::WRL::ComPtr<IDXGIFactory4>& out);
+bool StreamlineDevice(IDXGIAdapter1* adapter, Microsoft::WRL::ComPtr<ID3D12Device>& out);
+void StreamlineDeviceReady(ID3D12Device* dev);
+#endif
+
+// the setting's (app::Settings::frame_generation), with its libraries loaded and checked; null when off or when they
+// cannot be (logged). Before the Direct3D device is made, after LoadStreamline.
+std::unique_ptr<FrameGen> Make(uint32_t kind);
+
+// Anti-aliasing of the frame's 3D, before its UI, and its upscaling: AMD FSR's upscaler (any card: AMD's
+// amd_fidelityfx_loader_dx12.dll and amd_fidelityfx_upscaler_dx12.dll beside the game) or NVIDIA DLSS (a GeForce RTX:
+// streamline\sl.dlss.dll and nvngx_dlss.dll, Streamline loaded for it at the start). The title's 3D draws are moved by
+// a sub-pixel offset each frame (Jitter), which it gathers over the frames into smooth edges. Upscaling, the 3D is
+// drawn into the top left part of the frame's target (RenderSize), which the pass makes up to the whole.
+enum AntiAliasKind : uint32_t { kAaOff = 0, kAaFsr = 1, kAaDlss = 2 };
+// how much of the frame's size the 3D is drawn at: the whole (anti-aliasing only), or less and made up to it
+enum Upscale : uint32_t { kUpNative = 0, kUpQuality = 1, kUpBalanced = 2, kUpPerformance = 3 };
+
+class AntiAlias {
+public:
+    struct Frame {
+        ID3D12Resource* color = nullptr;   // the frame's colour, in ALL_SHADER_RESOURCE
+        ID3D12Resource* depth = nullptr;   // R32_FLOAT, the colour's size, ALL_SHADER_RESOURCE: the view's near_w at 0
+                                           // and far_w at 1 (FrameView)
+        ID3D12Resource* motion = nullptr;  // R16G16_FLOAT, the colour's size: to the frame before in UV units
+        // R8_UNORM, the colour's size, ALL_SHADER_RESOURCE: the effects' share of each pixel (sparks, fire, glows: no
+        // depth or motion of their own), 0 to 0.9, taken from this frame rather than gathered; may be null
+        ID3D12Resource* reactive = nullptr;
+        ID3D12Resource* output = nullptr;  // the colour's size, in UNORDERED_ACCESS
+        uint32_t w = 0, h = 0;             // the output's size, and the colour's
+        uint32_t rw = 0, rh = 0;           // the part of the colour, depth and motion drawn, from the top left
+        uint32_t quality = kUpNative;      // what rw and rh came from (RenderSize)
+        float jitter[2] = {};  // pixels of the part drawn, as Jitter gave them for this frame
+        bool reset = false;    // nothing to gather from: a cut, the first frame
+        FrameView view;
+        float frame_ms = 16.7f;
+        float sharpness = 0.3f;  // AMD's sharpening after, 0 none
+    };
+    virtual ~AntiAlias() = default;
+    virtual uint32_t Kind() const = 0;  // AntiAliasKind
+    // the size the 3D is drawn at for an output of w x h at a quality (Upscale); w x h itself for kUpNative
+    virtual void RenderSize(uint32_t w, uint32_t h, uint32_t quality, uint32_t& rw, uint32_t& rh) = 0;
+    // the frame's offset in pixels of the size drawn, each -0.5 to 0.5; its sequence longer the more it upscales
+    // (ratio: the output's width over the width drawn)
+    virtual void Jitter(uint64_t frame, float ratio, float& x, float& y) const = 0;
+    // recorded into cl; false when it can't (logged)
+    virtual bool Run(ID3D12GraphicsCommandList* cl, const Frame& f) = 0;
+    // after each present: Streamline's frame, when DLSS frame generation does not count them
+    virtual void FrameDone() {}
+    // the renderer's own pass rather than a vendor's: Run records nothing, the renderer draws it (MakeOwnTaa)
+    virtual bool Own() const { return false; }
+    // Linux's AMD FSR and NVIDIA DLSS on Vulkan (linux/fsr_vk.h, linux/dlss_vk.h): their inputs and output are the
+    // renderer's own Vulkan images (linux_vk::MakeImage), and they run on the queue (RunQueue) once the renderer has
+    // submitted the frame so far, after it on the queue and each in COMMON, rather than in the command list (Run)
+    virtual bool VulkanImages() const { return false; }
+    virtual bool RunQueue(const Frame&) { return false; }
+};
+
+// AntiAliasKind's, null when its files are not there or the card cannot (logged)
+std::unique_ptr<AntiAlias> MakeAntiAlias(ID3D12Device* dev, uint32_t kind);
+const char* AntiAliasName(uint32_t kind);  // "AMD FSR", "NVIDIA DLSS"; on Linux kAaFsr is "TAA"
+// the renderer's own temporal anti-aliasing and upscaling, in AMD FSR's place (kAaFsr) where AMD's library can't load:
+// Linux's, and Windows' with XBE_TAA=1. Its sizes and offsets as AMD's, its pass the renderer's (D3D12Backend::TaaFrame)
+std::unique_ptr<AntiAlias> MakeOwnTaa();
+
+}  // namespace gpu::framegen
