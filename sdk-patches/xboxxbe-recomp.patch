diff --git a/runtime/linux/fsr_vk.cpp b/runtime/linux/fsr_vk.cpp
new file mode 100644
index 0000000..c05bb04
--- /dev/null
+++ b/runtime/linux/fsr_vk.cpp
@@ -0,0 +1,268 @@
+// Linux: AMD FSR 3's upscaler on Vulkan (linux/fsr_vk.h)
+#ifndef _WIN32
+#include "linux/fsr_vk.h"
+
+#include "linux/vk_images.h"
+
+#ifdef XBE_FSR_VK
+#include <FidelityFX/host/backends/vk/ffx_vk.h>
+#include <FidelityFX/host/ffx_fsr3upscaler.h>
+#include <vkd3d.h>
+
+#include <algorithm>
+#include <cmath>
+#include <vector>
+
+#include "core/log.h"
+
+namespace gpu::linux_fsr {
+
+namespace {
+
+using linux_vk::Find;
+using linux_vk::Image;
+
+void Message(FfxMsgType type, const wchar_t* text) {
+    char b[512];
+    std::snprintf(b, sizeof(b), "%ls", text);
+    LOGR("antialias: AMD FSR %s: %s", type == FFX_MESSAGE_TYPE_ERROR ? "error" : "warning", b);
+}
+
+// AMD's ratios of the output's size to the size drawn, by quality: FSR's Quality, Balanced, Performance
+float Ratio(uint32_t quality) {
+    using namespace framegen;
+    return quality == kUpQuality ? 1.5f : quality == kUpBalanced ? 1.7f : quality == kUpPerformance ? 2.0f : 1.0f;
+}
+
+class Fsr final : public framegen::AntiAlias {
+public:
+    ~Fsr() override {
+        if (vkd_) vkDeviceWaitIdle(vkd_);
+        Unmake();
+        if (fence_) vkDestroyFence(vkd_, fence_, nullptr);
+        if (pool_) vkDestroyCommandPool(vkd_, pool_, nullptr);
+    }
+
+    bool Init(ID3D12Device* dev, ID3D12CommandQueue* queue) {
+        queue_ = queue;
+        vkd_ = vkd3d_get_vk_device(dev);
+        pd_ = vkd3d_get_vk_physical_device(dev);
+        family_ = vkd3d_get_vk_queue_family_index(queue);
+        // the backend's scratch, 64 byte aligned as its arrays in it are (the fork built with them aligned so), for two
+        // effect contexts: the upscaler's and its shared images' (the dilated depth and motion it keeps between frames)
+        size_t n = ffxGetScratchMemorySizeVK(pd_, kContexts);
+        scratch_.assign(n + 64, 0);
+        void* base = reinterpret_cast<void*>((reinterpret_cast<uintptr_t>(scratch_.data()) + 63) & ~uintptr_t(63));
+        // the backend keeps the device's description, not a copy: a member, alive as long as it
+        dc_ = {vkd_, pd_, vkGetDeviceProcAddr};
+        FfxErrorCode e = ffxGetInterfaceVK(&iface_, ffxGetDeviceVK(&dc_), base, n, kContexts);
+        if (e != FFX_OK) {
+            LOGR("antialias: AMD FSR's Vulkan backend did not start (%d)", int(e));
+            return false;
+        }
+        VkCommandPoolCreateInfo pci{VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO};
+        pci.flags = VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT;
+        pci.queueFamilyIndex = family_;
+        VkCommandBufferAllocateInfo ai{VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO};
+        VkFenceCreateInfo fci{VK_STRUCTURE_TYPE_FENCE_CREATE_INFO};
+        fci.flags = VK_FENCE_CREATE_SIGNALED_BIT;
+        if (vkCreateCommandPool(vkd_, &pci, nullptr, &pool_) != VK_SUCCESS) return false;
+        ai.commandPool = pool_;
+        ai.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+        ai.commandBufferCount = 1;
+        if (vkAllocateCommandBuffers(vkd_, &ai, &cmd_) != VK_SUCCESS) return false;
+        if (vkCreateFence(vkd_, &fci, nullptr, &fence_) != VK_SUCCESS) return false;
+        return true;
+    }
+
+    uint32_t Kind() const override { return framegen::kAaFsr; }
+
+    void RenderSize(uint32_t w, uint32_t h, uint32_t quality, uint32_t& rw, uint32_t& rh) override {
+        float ratio = Ratio(quality);
+        rw = std::max(1u, uint32_t(float(w) / ratio));
+        rh = std::max(1u, uint32_t(float(h) / ratio));
+    }
+
+    void Jitter(uint64_t frame, float ratio, float& x, float& y) const override {
+        int32_t phases = std::max(8, int32_t(8.0f * ratio * ratio));
+        if (ffxFsr3UpscalerGetJitterOffset(&x, &y, int32_t(frame % uint64_t(phases)), phases) != FFX_OK) x = y = 0;
+    }
+
+    bool VulkanImages() const override { return true; }
+    bool Run(ID3D12GraphicsCommandList*, const Frame&) override { return false; }  // RunQueue's
+
+    bool RunQueue(const Frame& f) override {
+        Image color, depth, motion, reactive, output;
+        if (!Find(f.color, color) || !Find(f.depth, depth) || !Find(f.motion, motion) || !Find(f.output, output) ||
+            !f.w || !f.h || !f.rw || !f.rh) {
+            LOG_FIRST(2, "antialias: AMD FSR's inputs are not its own images");
+            return false;
+        }
+        bool have_rx = Find(f.reactive, reactive);
+        bool inverted = f.view.near_w > f.view.far_w;
+        if (made_ && (f.w != w_ || f.h != h_ || inverted != inverted_)) {
+            vkDeviceWaitIdle(vkd_);
+            Unmake();
+        }
+        bool fresh = !made_;
+        if (!made_) {
+            FfxFsr3UpscalerContextDescription c{};
+            // gamma-encoded colour as the game drew it, exposure found by AMD, depth as the view says; the size drawn
+            // changes with the setting
+            c.flags = FFX_FSR3UPSCALER_ENABLE_AUTO_EXPOSURE | FFX_FSR3UPSCALER_ENABLE_DYNAMIC_RESOLUTION |
+                      (inverted ? FFX_FSR3UPSCALER_ENABLE_DEPTH_INVERTED : 0u);
+            c.maxRenderSize = {f.w, f.h};
+            c.maxUpscaleSize = {f.w, f.h};
+            c.fpMessage = Message;
+            c.backendInterface = iface_;
+            FfxErrorCode e = ffxFsr3UpscalerContextCreate(&ctx_, &c);
+            if (e != FFX_OK) {
+                LOG_FIRST(4, "antialias: AMD FSR's context was not made (%d) at %ux%u", int(e), f.w, f.h);
+                return false;
+            }
+            made_ = true;
+            // the images the upscaler shares with what follows it (FSR's frame generation; here only itself): made by
+            // the caller in this API, in an effect context of their own
+            FfxFsr3UpscalerSharedResourceDescriptions sd{};
+            if (iface_.fpCreateBackendContext(&iface_, FFX_EFFECT_SHAREDRESOURCES, nullptr, &shared_id_) != FFX_OK ||
+                ffxFsr3UpscalerGetSharedResourceDescriptions(&ctx_, &sd) != FFX_OK ||
+                iface_.fpCreateResource(&iface_, &sd.dilatedDepth, shared_id_, &shared_[0]) != FFX_OK ||
+                iface_.fpCreateResource(&iface_, &sd.dilatedMotionVectors, shared_id_, &shared_[1]) != FFX_OK ||
+                iface_.fpCreateResource(&iface_, &sd.reconstructedPrevNearestDepth, shared_id_, &shared_[2]) != FFX_OK) {
+                LOG_FIRST(4, "antialias: AMD FSR's shared images were not made at %ux%u", f.w, f.h);
+                Unmake();
+                return false;
+            }
+            shared_made_ = true;
+            w_ = f.w;
+            h_ = f.h;
+            inverted_ = inverted;
+            LOGR("antialias: AMD FSR 3 on Vulkan, at %ux%u", f.w, f.h);
+        }
+        // the last frame's commands done with before they are recorded again (long done by now: a frame back)
+        if (pending_) {
+            vkWaitForFences(vkd_, 1, &fence_, VK_TRUE, UINT64_MAX);
+            pending_ = false;
+        }
+        vkResetCommandBuffer(cmd_, 0);
+        VkCommandBufferBeginInfo bi{VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+        bi.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+        vkBeginCommandBuffer(cmd_, &bi);
+        // what the frame's commands wrote, seen by FSR's; and FSR's by what follows it on the queue
+        VkMemoryBarrier mb{VK_STRUCTURE_TYPE_MEMORY_BARRIER};
+        mb.srcAccessMask = VK_ACCESS_MEMORY_WRITE_BIT;
+        mb.dstAccessMask = VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT;
+        vkCmdPipelineBarrier(cmd_, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 1, &mb,
+                             0, nullptr, 0, nullptr);
+        // every image in GENERAL, the layout vkd3d keeps them in while COMMON; FSR puts each back in the state given
+        auto res = [&](const Image& im, const wchar_t* name, bool uav) {
+            FfxResourceDescription d =
+                ffxGetImageResourceDescriptionVK(im.image, im.info, uav ? FFX_RESOURCE_USAGE_UAV : FFX_RESOURCE_USAGE_READ_ONLY);
+            return ffxGetResourceVK(reinterpret_cast<void*>(im.image), d, name, FFX_RESOURCE_STATE_UNORDERED_ACCESS);
+        };
+        FfxFsr3UpscalerDispatchDescription d{};
+        d.commandList = ffxGetCommandListVK(cmd_);
+        d.color = res(color, L"FSR color", false);
+        d.depth = res(depth, L"FSR depth", false);
+        d.motionVectors = res(motion, L"FSR motion", false);
+        if (have_rx) d.reactive = res(reactive, L"FSR reactive", false);
+        d.output = res(output, L"FSR output", true);
+        d.dilatedDepth = iface_.fpGetResource(&iface_, shared_[0]);
+        d.dilatedMotionVectors = iface_.fpGetResource(&iface_, shared_[1]);
+        d.reconstructedPrevNearestDepth = iface_.fpGetResource(&iface_, shared_[2]);
+        d.jitterOffset = {f.jitter[0], f.jitter[1]};
+        d.motionVectorScale = {float(f.rw), float(f.rh)};  // UV units to pixels of the size drawn
+        d.renderSize = {f.rw, f.rh};
+        d.upscaleSize = {f.w, f.h};
+        d.enableSharpening = f.sharpness > 0;
+        d.sharpness = f.sharpness;
+        d.frameTimeDelta = f.frame_ms;
+        d.preExposure = 1;
+        d.reset = f.reset || fresh;
+        d.cameraNear = f.view.near_w;
+        d.cameraFar = f.view.far_w;
+        d.cameraFovAngleVertical = f.view.fov_y;
+        d.viewSpaceToMetersFactor = 0.01f;  // the title's units are about centimetres
+        FfxErrorCode e = ffxFsr3UpscalerContextDispatch(&ctx_, &d);
+        vkCmdPipelineBarrier(cmd_, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 1, &mb,
+                             0, nullptr, 0, nullptr);
+        vkEndCommandBuffer(cmd_);
+        if (e != FFX_OK) {
+            LOG_FIRST(4, "antialias: AMD FSR dispatch %d at %ux%u from %ux%u", int(e), f.w, f.h, f.rw, f.rh);
+            return false;  // not submitted, so the fence is not waited for
+        }
+        // the fence reset only for a submit, so one never submitted is never waited for
+        vkResetFences(vkd_, 1, &fence_);
+        VkQueue q = vkd3d_acquire_vk_queue(queue_);
+        VkSubmitInfo si{VK_STRUCTURE_TYPE_SUBMIT_INFO};
+        si.commandBufferCount = 1;
+        si.pCommandBuffers = &cmd_;
+        VkResult r = vkQueueSubmit(q, 1, &si, fence_);
+        vkd3d_release_vk_queue(queue_);
+        if (r != VK_SUCCESS) {
+            LOG_FIRST(4, "antialias: AMD FSR's commands were not submitted (%d)", int(r));
+            // the fence stays unsignalled: a new one
+            vkDestroyFence(vkd_, fence_, nullptr);
+            VkFenceCreateInfo fci{VK_STRUCTURE_TYPE_FENCE_CREATE_INFO};
+            if (vkCreateFence(vkd_, &fci, nullptr, &fence_) != VK_SUCCESS) fence_ = VK_NULL_HANDLE;
+            return false;
+        }
+        // not waited for: the renderer's own commands after it, which read its output, go on the same queue after
+        // it, and the barrier at its end has them see what it wrote. The processor goes on with the frame meanwhile
+        pending_ = true;
+        return true;
+    }
+
+private:
+    static constexpr size_t kContexts = 2;
+
+    void Unmake() {
+        if (shared_made_) {
+            for (FfxResourceInternal& r : shared_) iface_.fpDestroyResource(&iface_, r, shared_id_);
+            iface_.fpDestroyBackendContext(&iface_, shared_id_);
+            shared_made_ = false;
+        }
+        if (made_) ffxFsr3UpscalerContextDestroy(&ctx_);
+        made_ = false;
+    }
+
+    ID3D12CommandQueue* queue_ = nullptr;
+    VkDevice vkd_ = VK_NULL_HANDLE;
+    VkPhysicalDevice pd_ = VK_NULL_HANDLE;
+    uint32_t family_ = 0;
+    std::vector<uint8_t> scratch_;
+    VkDeviceContext dc_{};
+    FfxInterface iface_{};
+    FfxFsr3UpscalerContext ctx_{};
+    bool made_ = false, inverted_ = false;
+    FfxUInt32 shared_id_ = 0;
+    FfxResourceInternal shared_[3] = {};
+    bool shared_made_ = false;
+    uint32_t w_ = 0, h_ = 0;
+    VkCommandPool pool_ = VK_NULL_HANDLE;
+    VkCommandBuffer cmd_ = VK_NULL_HANDLE;
+    VkFence fence_ = VK_NULL_HANDLE;
+    bool pending_ = false;  // submitted, its fence not yet waited for
+};
+
+}  // namespace
+
+bool Built() { return true; }
+
+std::unique_ptr<framegen::AntiAlias> MakeFsr(ID3D12Device* dev, ID3D12CommandQueue* queue) {
+    auto fsr = std::make_unique<Fsr>();
+    if (!fsr->Init(dev, queue)) return nullptr;
+    return fsr;
+}
+
+}  // namespace gpu::linux_fsr
+
+#else
+
+namespace gpu::linux_fsr {
+bool Built() { return false; }
+std::unique_ptr<framegen::AntiAlias> MakeFsr(ID3D12Device*, ID3D12CommandQueue*) { return nullptr; }
+}  // namespace gpu::linux_fsr
+
+#endif
+#endif
