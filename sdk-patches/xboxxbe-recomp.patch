diff --git a/runtime/linux/ui_font.h b/runtime/linux/ui_font.h
new file mode 100644
index 0000000..e192049
--- /dev/null
+++ b/runtime/linux/ui_font.h
@@ -0,0 +1,30 @@
+#pragma once
+// Linux: a sans serif font of the system's for the SDK's own windows (the first start's build), as Windows draws them
+// in its message font; ImGui's built in one when the system has none of these
+#include <imgui.h>
+
+#include <filesystem>
+
+namespace linuxapp {
+
+inline void LoadUiFont(ImGuiIO& io, float pixels) {
+    static const char* kFonts[] = {
+        "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",          // Debian, Ubuntu
+        "/usr/share/fonts/TTF/DejaVuSans.ttf",                      // Arch
+        "/usr/share/fonts/dejavu-sans-fonts/DejaVuSans.ttf",        // Fedora
+        "/usr/share/fonts/truetype/noto/NotoSans-Regular.ttf",
+        "/usr/share/fonts/noto/NotoSans-Regular.ttf",
+        "/usr/share/fonts/google-noto/NotoSans-Regular.ttf",
+        "/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf",
+        "/usr/share/fonts/liberation-sans/LiberationSans-Regular.ttf",
+        "/usr/share/fonts/truetype/ubuntu/Ubuntu-R.ttf",
+    };
+    std::error_code ec;
+    for (const char* path : kFonts)
+        if (std::filesystem::exists(path, ec) && io.Fonts->AddFontFromFileTTF(path, pixels)) return;
+    ImFontConfig config;
+    config.SizePixels = pixels;
+    io.Fonts->AddFontDefault(&config);
+}
+
+}  // namespace linuxapp
diff --git a/runtime/linux/vk_images.cpp b/runtime/linux/vk_images.cpp
new file mode 100644
index 0000000..7ded624
--- /dev/null
+++ b/runtime/linux/vk_images.cpp
@@ -0,0 +1,125 @@
+// Linux: Vulkan images of the renderer's own as D3D12 resources (linux/vk_images.h)
+#ifndef _WIN32
+#include "linux/vk_images.h"
+
+#include <vkd3d.h>
+
+#include <mutex>
+#include <unordered_map>
+
+#include "core/log.h"
+
+namespace gpu::linux_vk {
+
+namespace {
+
+std::mutex g_images_m;
+std::unordered_map<ID3D12Resource*, Image> g_images;
+
+uint32_t MemoryType(VkPhysicalDevice pd, uint32_t bits, VkMemoryPropertyFlags want) {
+    VkPhysicalDeviceMemoryProperties mp;
+    vkGetPhysicalDeviceMemoryProperties(pd, &mp);
+    for (uint32_t i = 0; i < mp.memoryTypeCount; i++)
+        if ((bits >> i & 1) && (mp.memoryTypes[i].propertyFlags & want) == want) return i;
+    return UINT32_MAX;
+}
+
+void Free(const Image& im) {
+    if (im.view) vkDestroyImageView(im.device, im.view, nullptr);
+    if (im.image) vkDestroyImage(im.device, im.image, nullptr);
+    if (im.memory) vkFreeMemory(im.device, im.memory, nullptr);
+}
+
+}  // namespace
+
+ID3D12Resource* MakeImage(ID3D12Device* dev, uint32_t w, uint32_t h, DXGI_FORMAT format, bool render_target) {
+    VkDevice vkd = vkd3d_get_vk_device(dev);
+    VkPhysicalDevice pd = vkd3d_get_vk_physical_device(dev);
+    VkFormat vf = vkd3d_get_vk_format(format);
+    VkFormatProperties fp;
+    vkGetPhysicalDeviceFormatProperties(pd, vf, &fp);
+    bool storage = (fp.optimalTilingFeatures & VK_FORMAT_FEATURE_STORAGE_IMAGE_BIT) != 0;
+    Image im;
+    im.device = vkd;
+    im.storage = storage;
+    im.info = {VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+    im.info.imageType = VK_IMAGE_TYPE_2D;
+    im.info.format = vf;
+    im.info.extent = {w, h, 1};
+    im.info.mipLevels = 1;
+    im.info.arrayLayers = 1;
+    im.info.samples = VK_SAMPLE_COUNT_1_BIT;
+    im.info.tiling = VK_IMAGE_TILING_OPTIMAL;
+    im.info.usage = VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT |
+                    (storage ? VK_IMAGE_USAGE_STORAGE_BIT : 0) | (render_target ? VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT : 0);
+    im.info.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+    if (vkCreateImage(vkd, &im.info, nullptr, &im.image) != VK_SUCCESS) {
+        LOGR("antialias: no %ux%u Vulkan image of format %d", w, h, int(vf));
+        return nullptr;
+    }
+    VkMemoryRequirements req;
+    vkGetImageMemoryRequirements(vkd, im.image, &req);
+    VkMemoryAllocateInfo mi{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+    mi.allocationSize = req.size;
+    mi.memoryTypeIndex = MemoryType(pd, req.memoryTypeBits, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+    if (mi.memoryTypeIndex == UINT32_MAX) mi.memoryTypeIndex = MemoryType(pd, req.memoryTypeBits, 0);
+    if (vkAllocateMemory(vkd, &mi, nullptr, &im.memory) != VK_SUCCESS) {
+        Free(im);
+        return nullptr;
+    }
+    vkBindImageMemory(vkd, im.image, im.memory, 0);
+    VkImageViewCreateInfo vi{VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO};
+    vi.image = im.image;
+    vi.viewType = VK_IMAGE_VIEW_TYPE_2D;
+    vi.format = vf;
+    vi.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+    if (vkCreateImageView(vkd, &vi, nullptr, &im.view) != VK_SUCCESS) {
+        Free(im);
+        return nullptr;
+    }
+    vkd3d_image_resource_create_info ri{};
+    ri.type = VKD3D_STRUCTURE_TYPE_IMAGE_RESOURCE_CREATE_INFO;
+    ri.vk_image = im.image;
+    ri.desc.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    ri.desc.Width = w;
+    ri.desc.Height = h;
+    ri.desc.DepthOrArraySize = 1;
+    ri.desc.MipLevels = 1;
+    ri.desc.Format = format;
+    ri.desc.SampleDesc.Count = 1;
+    ri.desc.Flags = (render_target ? D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET : D3D12_RESOURCE_FLAG_NONE) |
+                    (storage ? D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS : D3D12_RESOURCE_FLAG_NONE);
+    ri.flags = VKD3D_RESOURCE_INITIAL_STATE_TRANSITION;
+    ID3D12Resource* r = nullptr;
+    if (FAILED(vkd3d_create_image_resource(dev, &ri, &r))) {
+        Free(im);
+        return nullptr;
+    }
+    std::lock_guard lock(g_images_m);
+    g_images[r] = im;
+    return r;
+}
+
+void DropImage(ID3D12Resource* resource) {
+    Image im;
+    {
+        std::lock_guard lock(g_images_m);
+        auto it = g_images.find(resource);
+        if (it == g_images.end()) return;
+        im = it->second;
+        g_images.erase(it);
+    }
+    Free(im);
+}
+
+bool Find(ID3D12Resource* resource, Image& out) {
+    if (!resource) return false;
+    std::lock_guard lock(g_images_m);
+    auto it = g_images.find(resource);
+    if (it == g_images.end()) return false;
+    out = it->second;
+    return true;
+}
+
+}  // namespace gpu::linux_vk
+#endif
diff --git a/runtime/linux/vk_images.h b/runtime/linux/vk_images.h
new file mode 100644
index 0000000..ecdacf9
--- /dev/null
+++ b/runtime/linux/vk_images.h
@@ -0,0 +1,35 @@
+#pragma once
+// Linux: Vulkan images of the renderer's own as D3D12 resources, for the anti-aliasing that runs on Vulkan itself rather
+// than through vkd3d (AMD FSR 3, linux/fsr_vk.h; NVIDIA DLSS, linux/dlss_vk.h). Those take Vulkan images, and vkd3d gives
+// no image of a resource it made, so the inputs and the output are images made here, wrapped as D3D12 resources for the
+// renderer: it draws its depth and motion into them and copies the frame's colour in.
+#include <vulkan/vulkan.h>
+
+#include <cstdint>
+
+#include "d3d12.h"
+
+namespace gpu::linux_vk {
+
+// a w x h image as a D3D12 resource in COMMON (Vulkan's GENERAL layout), sampled, stored to (where the format allows:
+// render_target formats and RGBA always) and copied to or from; a render target too when asked. Null when it cannot be
+// made (logged)
+ID3D12Resource* MakeImage(ID3D12Device* dev, uint32_t w, uint32_t h, DXGI_FORMAT format, bool render_target);
+
+// an image MakeImage made, its resource released and the GPU done with it: its Vulkan image, view and memory freed
+void DropImage(ID3D12Resource* resource);
+
+// a MakeImage image's Vulkan side
+struct Image {
+    VkDevice device = VK_NULL_HANDLE;
+    VkImage image = VK_NULL_HANDLE;
+    VkImageView view = VK_NULL_HANDLE;  // all of it, its colour
+    VkDeviceMemory memory = VK_NULL_HANDLE;
+    VkImageCreateInfo info{};
+    bool storage = false;
+};
+
+// the image under a resource MakeImage made; false for any other
+bool Find(ID3D12Resource* resource, Image& out);
+
+}  // namespace gpu::linux_vk
diff --git a/runtime/linux/win32.cpp b/runtime/linux/win32.cpp
new file mode 100644
index 0000000..4af696d
--- /dev/null
+++ b/runtime/linux/win32.cpp
@@ -0,0 +1,234 @@
+// Linux: the Win32 functions the shared sources call (linux/windows.h), over SDL's window, keyboard and message boxes
+#ifndef _WIN32
+#include "windows.h"
+
+#include <dlfcn.h>
+#include <spawn.h>
+#include <sys/wait.h>
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include "linux/sdl_app.h"
+
+extern char** environ;
+
+namespace linuxapp {
+
+namespace {
+
+// SDL scancode to virtual key: letters, digits and the keys the shared sources name
+struct KeyPair {
+    SDL_Scancode sc;
+    int vk;
+};
+constexpr KeyPair kKeys[] = {
+    {SDL_SCANCODE_BACKSPACE, VK_BACK},     {SDL_SCANCODE_TAB, VK_TAB},          {SDL_SCANCODE_RETURN, VK_RETURN},
+    {SDL_SCANCODE_KP_ENTER, VK_RETURN},    {SDL_SCANCODE_PAUSE, VK_PAUSE},      {SDL_SCANCODE_CAPSLOCK, VK_CAPITAL},
+    {SDL_SCANCODE_ESCAPE, VK_ESCAPE},      {SDL_SCANCODE_SPACE, VK_SPACE},      {SDL_SCANCODE_PAGEUP, VK_PRIOR},
+    {SDL_SCANCODE_PAGEDOWN, VK_NEXT},      {SDL_SCANCODE_END, VK_END},          {SDL_SCANCODE_HOME, VK_HOME},
+    {SDL_SCANCODE_LEFT, VK_LEFT},          {SDL_SCANCODE_UP, VK_UP},            {SDL_SCANCODE_RIGHT, VK_RIGHT},
+    {SDL_SCANCODE_DOWN, VK_DOWN},          {SDL_SCANCODE_PRINTSCREEN, VK_SNAPSHOT}, {SDL_SCANCODE_INSERT, VK_INSERT},
+    {SDL_SCANCODE_DELETE, VK_DELETE},      {SDL_SCANCODE_LGUI, VK_LWIN},        {SDL_SCANCODE_RGUI, VK_RWIN},
+    {SDL_SCANCODE_KP_0, VK_NUMPAD0},       {SDL_SCANCODE_KP_1, VK_NUMPAD1},     {SDL_SCANCODE_KP_2, VK_NUMPAD2},
+    {SDL_SCANCODE_KP_3, VK_NUMPAD3},       {SDL_SCANCODE_KP_4, VK_NUMPAD4},     {SDL_SCANCODE_KP_5, VK_NUMPAD5},
+    {SDL_SCANCODE_KP_6, VK_NUMPAD6},       {SDL_SCANCODE_KP_7, VK_NUMPAD7},     {SDL_SCANCODE_KP_8, VK_NUMPAD8},
+    {SDL_SCANCODE_KP_9, VK_NUMPAD9},       {SDL_SCANCODE_KP_MULTIPLY, VK_MULTIPLY}, {SDL_SCANCODE_KP_PLUS, VK_ADD},
+    {SDL_SCANCODE_KP_MINUS, VK_SUBTRACT},  {SDL_SCANCODE_KP_PERIOD, VK_DECIMAL}, {SDL_SCANCODE_KP_DIVIDE, VK_DIVIDE},
+    {SDL_SCANCODE_F1, VK_F1},              {SDL_SCANCODE_F2, VK_F2},            {SDL_SCANCODE_F3, VK_F3},
+    {SDL_SCANCODE_F4, VK_F4},              {SDL_SCANCODE_F5, VK_F5},            {SDL_SCANCODE_F6, VK_F6},
+    {SDL_SCANCODE_F7, VK_F7},              {SDL_SCANCODE_F8, VK_F8},            {SDL_SCANCODE_F9, VK_F9},
+    {SDL_SCANCODE_F10, VK_F10},            {SDL_SCANCODE_F11, VK_F11},          {SDL_SCANCODE_F12, VK_F12},
+    {SDL_SCANCODE_NUMLOCKCLEAR, VK_NUMLOCK}, {SDL_SCANCODE_SCROLLLOCK, VK_SCROLL}, {SDL_SCANCODE_LSHIFT, VK_LSHIFT},
+    {SDL_SCANCODE_RSHIFT, VK_RSHIFT},      {SDL_SCANCODE_LCTRL, VK_LCONTROL},   {SDL_SCANCODE_RCTRL, VK_RCONTROL},
+    {SDL_SCANCODE_LALT, VK_LMENU},         {SDL_SCANCODE_RALT, VK_RMENU},       {SDL_SCANCODE_SEMICOLON, VK_OEM_1},
+    {SDL_SCANCODE_EQUALS, VK_OEM_PLUS},    {SDL_SCANCODE_COMMA, VK_OEM_COMMA},  {SDL_SCANCODE_MINUS, VK_OEM_MINUS},
+    {SDL_SCANCODE_PERIOD, VK_OEM_PERIOD},  {SDL_SCANCODE_SLASH, VK_OEM_2},      {SDL_SCANCODE_GRAVE, VK_OEM_3},
+    {SDL_SCANCODE_LEFTBRACKET, VK_OEM_4},  {SDL_SCANCODE_BACKSLASH, VK_OEM_5},  {SDL_SCANCODE_RIGHTBRACKET, VK_OEM_6},
+    {SDL_SCANCODE_APOSTROPHE, VK_OEM_7},   {SDL_SCANCODE_NONUSBACKSLASH, VK_OEM_102},
+};
+
+bool Held(SDL_Scancode sc) {
+    int n = 0;
+    const bool* keys = SDL_GetKeyboardState(&n);
+    return keys && int(sc) < n && keys[sc];
+}
+
+}  // namespace
+
+int VirtualKey(SDL_Scancode sc) {
+    if (sc >= SDL_SCANCODE_A && sc <= SDL_SCANCODE_Z) return 'A' + (sc - SDL_SCANCODE_A);
+    if (sc >= SDL_SCANCODE_1 && sc <= SDL_SCANCODE_9) return '1' + (sc - SDL_SCANCODE_1);
+    if (sc == SDL_SCANCODE_0) return '0';
+    for (const KeyPair& k : kKeys)
+        if (k.sc == sc) return k.vk;
+    return 0;
+}
+
+std::string Utf8(const wchar_t* text) {
+    std::string out;
+    for (; text && *text; text++) {
+        uint32_t c = uint32_t(*text);
+        if (c < 0x80) {
+            out += char(c);
+        } else if (c < 0x800) {
+            out += char(0xC0 | c >> 6);
+            out += char(0x80 | (c & 0x3F));
+        } else if (c < 0x10000) {
+            out += char(0xE0 | c >> 12);
+            out += char(0x80 | (c >> 6 & 0x3F));
+            out += char(0x80 | (c & 0x3F));
+        } else {
+            out += char(0xF0 | c >> 18);
+            out += char(0x80 | (c >> 12 & 0x3F));
+            out += char(0x80 | (c >> 6 & 0x3F));
+            out += char(0x80 | (c & 0x3F));
+        }
+    }
+    return out;
+}
+
+std::wstring Wide(const std::string& text) {
+    std::wstring out;
+    for (size_t i = 0; i < text.size();) {
+        uint8_t b = uint8_t(text[i]);
+        int more = b >= 0xF0 ? 3 : b >= 0xE0 ? 2 : b >= 0xC0 ? 1 : 0;
+        uint32_t c = more ? b & (0x3F >> more) : b;
+        for (i++; more-- > 0 && i < text.size(); i++) c = c << 6 | (uint8_t(text[i]) & 0x3F);
+        out += wchar_t(c);
+    }
+    return out;
+}
+
+void Spawn(const char* program, const char* arg) {
+    pid_t pid = 0;
+    char* argv[] = {const_cast<char*>(program), const_cast<char*>(arg), nullptr};
+    if (posix_spawnp(&pid, program, nullptr, nullptr, argv, environ) == 0) {
+        // reaped by a thread of its own, so it leaves no zombie
+        std::thread([pid] { waitpid(pid, nullptr, 0); }).detach();
+    }
+}
+
+}  // namespace linuxapp
+
+using namespace linuxapp;
+
+HMODULE GetModuleHandleA(const char* name) {
+    // D3D12SerializeRootSignature is vkd3d-utils' here
+    return name && !std::strcmp(name, "d3d12.dll") ? dlopen("libvkd3d-utils.so.1", RTLD_NOW) : nullptr;
+}
+HMODULE LoadLibraryA(const char* name) { return GetModuleHandleA(name); }
+void* GetProcAddress(HMODULE module, const char* name) { return module ? dlsym(module, name) : nullptr; }
+
+HWND GetForegroundWindow() { return g_focused ? g_window.load() : nullptr; }
+BOOL IsWindow(HWND hwnd) { return hwnd && hwnd == g_window.load(); }
+uint32_t GetWindowThreadProcessId(HWND, DWORD* pid) {
+    if (pid) *pid = DWORD(getpid());
+    return 1;
+}
+
+short GetAsyncKeyState(int vk) {
+    bool down = false;
+    switch (vk) {
+        case VK_SHIFT:
+            down = Held(SDL_SCANCODE_LSHIFT) || Held(SDL_SCANCODE_RSHIFT);
+            break;
+        case VK_CONTROL:
+            down = Held(SDL_SCANCODE_LCTRL) || Held(SDL_SCANCODE_RCTRL);
+            break;
+        case VK_MENU:
+            down = Held(SDL_SCANCODE_LALT) || Held(SDL_SCANCODE_RALT);
+            break;
+        case VK_LBUTTON:
+            down = (SDL_GetMouseState(nullptr, nullptr) & SDL_BUTTON_LMASK) != 0;
+            break;
+        default:
+            for (int sc = 0; sc < SDL_SCANCODE_COUNT && !down; sc++)
+                down = VirtualKey(SDL_Scancode(sc)) == vk && Held(SDL_Scancode(sc));
+    }
+    return down ? short(0x8000) : 0;
+}
+
+int GetKeyNameTextW(LONG lp, wchar_t* name, int size) {
+    int vk = (lp >> 16) & 0xFF;  // bit 24, the extended key, left out
+    for (int sc = 0; sc < SDL_SCANCODE_COUNT; sc++) {
+        if (VirtualKey(SDL_Scancode(sc)) != vk) continue;
+        const char* key = SDL_GetKeyName(SDL_GetKeyFromScancode(SDL_Scancode(sc), SDL_KMOD_NONE, false));
+        std::wstring w = Wide(key ? key : "");
+        if (w.empty() || size <= 0) return 0;
+        int n = std::min<int>(int(w.size()), size - 1);
+        std::wmemcpy(name, w.c_str(), size_t(n));
+        name[n] = 0;
+        return n;
+    }
+    return 0;
+}
+
+int MessageBoxW(HWND, const wchar_t* text, const wchar_t* title, uint32_t type) {
+    std::string t = Utf8(text), caption = Utf8(title);
+    SDL_MessageBoxFlags flags = (type & 0xF0) == MB_ICONERROR     ? SDL_MESSAGEBOX_ERROR
+                                : (type & 0xF0) == MB_ICONWARNING ? SDL_MESSAGEBOX_WARNING
+                                                                  : SDL_MESSAGEBOX_INFORMATION;
+    std::vector<SDL_MessageBoxButtonData> buttons;
+    if ((type & 0xF) == MB_YESNO) {
+        bool no_first = type & MB_DEFBUTTON2;
+        buttons.push_back({Uint32(no_first ? 0 : SDL_MESSAGEBOX_BUTTON_RETURNKEY_DEFAULT), IDYES, "Yes"});
+        buttons.push_back({Uint32(SDL_MESSAGEBOX_BUTTON_ESCAPEKEY_DEFAULT |
+                                      (no_first ? SDL_MESSAGEBOX_BUTTON_RETURNKEY_DEFAULT : 0)),
+                           IDNO, "No"});
+    } else {
+        buttons.push_back({SDL_MESSAGEBOX_BUTTON_RETURNKEY_DEFAULT | SDL_MESSAGEBOX_BUTTON_ESCAPEKEY_DEFAULT, IDOK, "OK"});
+    }
+    SDL_MessageBoxData data{flags, g_window.load(), caption.c_str(), t.c_str(), int(buttons.size()), buttons.data(),
+                            nullptr};
+    int pressed = (type & 0xF) == MB_YESNO ? IDNO : IDOK;
+    if (!SDL_ShowMessageBox(&data, &pressed)) {
+        // no display to show it on: the log has it
+        std::fprintf(stderr, "%s: %s\n", caption.c_str(), t.c_str());
+    }
+    return pressed;
+}
+
+HINSTANCE ShellExecuteW(HWND, const wchar_t*, const wchar_t* file, const wchar_t*, const wchar_t*, int) {
+    std::string path = Utf8(file);
+    Spawn("xdg-open", path.c_str());
+    return reinterpret_cast<HINSTANCE>(intptr_t(33));  // above 32: started
+}
+
+const wchar_t* _wgetenv(const wchar_t* name) {
+    const char* v = std::getenv(Utf8(name).c_str());
+    if (!v) return nullptr;
+    thread_local std::wstring value;
+    value = Wide(v);
+    return value.c_str();
+}
+
+HINSTANCE ShellExecuteW(HWND, const wchar_t*, const char* file, const wchar_t*, const wchar_t*, int) {
+    Spawn("xdg-open", file);
+    return reinterpret_cast<HINSTANCE>(intptr_t(33));
+}
+
+int WideCharToMultiByte(uint32_t, uint32_t, const wchar_t* in, int in_len, char* out, int out_size, const char*, BOOL*) {
+    std::wstring w = in_len < 0 ? std::wstring(in) : std::wstring(in, size_t(in_len));
+    std::string s = Utf8(w.c_str());
+    if (in_len < 0) s.push_back('\0');
+    if (!out_size) return int(s.size());
+    int n = std::min<int>(int(s.size()), out_size);
+    std::memcpy(out, s.data(), size_t(n));
+    return n;
+}
+
+int MultiByteToWideChar(uint32_t, uint32_t, const char* in, int in_len, wchar_t* out, int out_size) {
+    std::wstring w = Wide(in_len < 0 ? std::string(in) : std::string(in, size_t(in_len)));
+    if (in_len < 0) w.push_back(L'\0');
+    if (!out_size) return int(w.size());
+    int n = std::min<int>(int(w.size()), out_size);
+    std::wmemcpy(out, w.data(), size_t(n));
+    return n;
+}
+#endif
diff --git a/runtime/linux/windows.h b/runtime/linux/windows.h
new file mode 100644
index 0000000..a05d424
--- /dev/null
+++ b/runtime/linux/windows.h
@@ -0,0 +1,130 @@
+#pragma once
+// Linux: the Win32 names the shared sources use. The COM and base types are vkd3d's (D3D12 runs on it here); the few
+// functions are SDL's window and keyboard underneath (linux/win32.cpp), the main loop's (app/main.cpp).
+#include <vkd3d_windows.h>
+
+#include <climits>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <cwchar>
+#include <cwctype>
+#include <unistd.h>
+
+typedef void* HWND;
+typedef void* HMODULE;
+typedef void* HINSTANCE;
+typedef void* HCURSOR;
+typedef void* HMONITOR;
+typedef const wchar_t* PCWSTR;
+typedef const wchar_t* LPCWSTR;
+typedef const char* LPCSTR;
+typedef intptr_t LRESULT;
+typedef uintptr_t WPARAM;
+typedef intptr_t LPARAM;
+typedef int64_t LONG_PTR;
+typedef unsigned short WORD;
+#ifndef TRUE
+#define TRUE 1
+#endif
+#ifndef FALSE
+#define FALSE 0
+#endif
+#ifndef MAX_PATH
+#define MAX_PATH 260
+#endif
+
+// modules: "d3d12.dll" is vkd3d's (ImGui's DX12 backend looks up D3D12SerializeRootSignature in it); no others
+HMODULE GetModuleHandleA(const char* name);
+HMODULE LoadLibraryA(const char* name);
+inline HMODULE GetModuleHandleW(const wchar_t*) { return nullptr; }
+void* GetProcAddress(HMODULE module, const char* name);
+inline HANDLE GetCurrentThread() { return nullptr; }
+#define INVALID_HANDLE_VALUE ((HANDLE)(intptr_t)-1)
+inline uint32_t GetCurrentProcessId() { return uint32_t(getpid()); }
+inline uint32_t GetCurrentThreadId() { return uint32_t(gettid()); }
+// a thread's priority: Linux's threads keep theirs (the pipelines made ahead ask for below normal)
+enum { THREAD_PRIORITY_BELOW_NORMAL = -1 };
+inline BOOL SetThreadPriority(HANDLE, int) { return TRUE; }
+// the C runtime's 64 bit seeks
+inline int _fseeki64(FILE* f, int64_t at, int whence) { return fseeko(f, off_t(at), whence); }
+inline int64_t _ftelli64(FILE* f) { return int64_t(ftello(f)); }
+inline void Sleep(uint32_t ms) { usleep(useconds_t(ms) * 1000); }
+[[noreturn]] inline void ExitProcess(uint32_t code) { std::exit(int(code)); }
+inline int _wcsicmp(const wchar_t* a, const wchar_t* b) { return wcscasecmp(a, b); }
+
+// the C runtime's wide forms: paths here are UTF-8 bytes (std::filesystem::path::c_str() is char), modes are ASCII
+inline FILE* _wfopen(const char* path, const wchar_t* mode) {
+    char m[8] = {};
+    for (int i = 0; i < 7 && mode[i]; i++) m[i] = char(mode[i]);
+    return std::fopen(path, m);
+}
+const wchar_t* _wgetenv(const wchar_t* name);  // the environment's value, null when unset
+inline DWORD GetEnvironmentVariableW(const wchar_t* name, wchar_t*, DWORD) { return _wgetenv(name) ? 1 : 0; }
+
+// fence events (vkd3d signals them, linux/present.cpp): auto reset, waited on in full
+HANDLE CreateEventW(void* security, BOOL manual, BOOL initial, const wchar_t* name);
+#define CreateEvent CreateEventW
+enum : uint32_t { INFINITE = 0xFFFFFFFF, WAIT_OBJECT_0 = 0 };
+uint32_t WaitForSingleObject(HANDLE handle, uint32_t ms);
+BOOL CloseHandle(HANDLE handle);
+#define ZeroMemory(p, n) std::memset((p), 0, (n))
+#define _countof(a) (sizeof(a) / sizeof((a)[0]))
+
+// the game window, as its keyboard focus has it
+HWND GetForegroundWindow();
+BOOL IsWindow(HWND hwnd);
+uint32_t GetWindowThreadProcessId(HWND hwnd, DWORD* pid);
+// a key held now, by its Win32 virtual key code: bit 15 set while down
+short GetAsyncKeyState(int vk);
+// a key's name for a menu, by its virtual key code in bits 16 to 24 of lp (the scan code there on Windows)
+int GetKeyNameTextW(LONG lp, wchar_t* name, int size);
+enum : uint32_t { MAPVK_VK_TO_VSC = 0 };
+inline uint32_t MapVirtualKeyW(uint32_t vk, uint32_t) { return vk; }  // the key's own code stands in for its scan code
+
+// a message to the player; MB_YESNO answers IDYES or IDNO
+enum : uint32_t {
+    MB_OK = 0, MB_YESNO = 4, MB_ICONERROR = 0x10, MB_ICONQUESTION = 0x20, MB_ICONWARNING = 0x30, MB_ICONINFORMATION = 0x40,
+    MB_DEFBUTTON2 = 0x100, MB_SETFOREGROUND = 0x10000, MB_TOPMOST = 0x40000,
+};
+enum { IDOK = 1, IDCANCEL = 2, IDYES = 6, IDNO = 7 };
+int MessageBoxW(HWND parent, const wchar_t* text, const wchar_t* title, uint32_t type);
+// open a folder or a page in the desktop's own program (xdg-open)
+HINSTANCE ShellExecuteW(HWND, const wchar_t* verb, const wchar_t* file, const wchar_t* args, const wchar_t* dir, int show);
+// a path as std::filesystem gives it here (bytes)
+HINSTANCE ShellExecuteW(HWND, const wchar_t* verb, const char* file, const wchar_t* args, const wchar_t* dir, int show);
+enum { SW_HIDE = 0, SW_SHOWNORMAL = 1, SW_SHOW = 5 };
+
+// UTF-8 to and from wide text, as CP_UTF8 converts it
+enum : uint32_t { CP_UTF8 = 65001 };
+int WideCharToMultiByte(uint32_t cp, uint32_t flags, const wchar_t* in, int in_len, char* out, int out_size,
+                        const char*, BOOL*);
