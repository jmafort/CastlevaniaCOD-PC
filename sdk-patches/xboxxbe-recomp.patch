+        ComPtr<IDXGIFactory4> f;
+        ComPtr<IDXGIAdapter1> a;
+        if (SUCCEEDED(CreateDXGIFactory2(0, IID_PPV_ARGS(&f))) &&
+            SUCCEEDED(f->EnumAdapterByLuid(dev_->GetAdapterLuid(), IID_PPV_ARGS(&a))))
