--- /dev/null
+++ b/runtime/app/icon.cpp
@@ -0,0 +1,68 @@
+// The windows' icon (the taskbar's, the title bar's, Alt+Tab's) made at run time from the game's files
+// (GameInfo::icon) when the executable carries none of its own: a release, which packs nothing of the game.
+#include "app/app.h"
+#include "app/window_icon.h"
+#include "core/log.h"
+
+#ifndef _WIN32
+#include <SDL3/SDL.h>
+#endif
+
+namespace app {
+
+namespace {
+std::vector<uint8_t> g_icon;  // BGRA, g_icon_size square; empty with the executable's own icon, or none
+int g_icon_size = 0;
+#ifdef _WIN32
+HICON g_big = nullptr, g_small = nullptr;
+#endif
+}  // namespace
+
+void MakeWindowIcon(const GameFiles& game) {
+#ifdef _WIN32
+    if (LoadIconW(GetModuleHandleW(nullptr), MAKEINTRESOURCEW(1))) return;  // the build's own (a dev build's)
+#endif
+    if (!kGame.icon || !g_icon.empty()) return;
+    std::vector<uint8_t> px;
+    int size = 0;
+    if (!kGame.icon(game.xbe, px, size) || size <= 0 || px.size() < size_t(size) * size * 4) {
+        LOGR("window icon: none made from the game's files");
+        return;
+    }
+    g_icon = std::move(px);
+    g_icon_size = size;
+#ifdef _WIN32
+    UINT dpi = GetDpiForSystem();
+    g_big = icon::Make(g_icon, size, GetSystemMetricsForDpi(SM_CXICON, dpi));
+    g_small = icon::Make(g_icon, size, GetSystemMetricsForDpi(SM_CXSMICON, dpi));
+    LOGR("window icon: made from the game's files (%dx%d, %d and %d pixels)", size, size,
+         GetSystemMetricsForDpi(SM_CXICON, dpi), GetSystemMetricsForDpi(SM_CXSMICON, dpi));
+#else
+    LOGR("window icon: made from the game's files (%dx%d)", size, size);
+#endif
+}
+
+void* WindowIcon(bool title_bar) {
+#ifdef _WIN32
+    return title_bar ? g_small : g_big;
+#else
+    (void)title_bar;
+    return nullptr;
+#endif
+}
+
+void ApplyWindowIcon(void* window) {
+    if (!window || g_icon.empty()) return;
+#ifdef _WIN32
+    HWND hwnd = static_cast<HWND>(window);
+    if (g_big) SendMessageW(hwnd, WM_SETICON, ICON_BIG, LPARAM(g_big));
+    if (g_small) SendMessageW(hwnd, WM_SETICON, ICON_SMALL, LPARAM(g_small));
+#else
+    SDL_Surface* s = SDL_CreateSurfaceFrom(g_icon_size, g_icon_size, SDL_PIXELFORMAT_BGRA32, g_icon.data(), g_icon_size * 4);
+    if (!s) return;
+    SDL_SetWindowIcon(static_cast<SDL_Window*>(window), s);
+    SDL_DestroySurface(s);
+#endif
+}
+
+}  // namespace app
