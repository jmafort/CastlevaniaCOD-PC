 };
 )";
 
@@ -68,13 +74,18 @@ std::string Common() { return kCommonHead + Hooks().Constants() + kCommonTail; }
 // vertex programs
 
 const char* kVsHelpers = R"(
+// ray tracing's scene (raytrace.h): with rtc.y set, each vertex as drawn goes to the frame's capture buffer from slot
+// rtc.x (kRtCapture)
+RWByteAddressBuffer rtcap : register(u0);
