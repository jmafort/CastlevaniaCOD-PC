--- /dev/null
+++ b/runtime/linux/image.h
@@ -0,0 +1,21 @@
+#pragma once
+// Linux: pictures as WIC reads and writes them on Windows: PNG files (stb), and BC1 to BC3 blocks unpacked, as WIC's
+// DDS decoder does. Pixels are BGRA, rows of width * 4 bytes.
+#include <cstdint>
+#include <filesystem>
+#include <vector>
+
+namespace linuximage {
+
+// a PNG (or another stb reads: BMP, JPEG, TGA) as BGRA; false when it cannot be read
+bool ReadFile(const std::filesystem::path& path, std::vector<uint8_t>& bgra, uint32_t& w, uint32_t& h);
+bool ReadMemory(const uint8_t* data, size_t size, std::vector<uint8_t>& bgra, uint32_t& w, uint32_t& h);
+// a PNG from BGRA rows of pitch bytes
+bool WritePng(const std::filesystem::path& path, const uint8_t* bgra, uint32_t w, uint32_t h, uint32_t pitch);
+
+// BC1 (DXT1), BC2 (DXT3), BC3 (DXT5) blocks as BGRA; bc is 1, 2 or 3
+void DecodeBc(int bc, const uint8_t* blocks, uint32_t w, uint32_t h, std::vector<uint8_t>& bgra);
+// a .dds file's first level as BGRA: uncompressed 32 bit, or BC1 to BC3
+bool ReadDds(const std::vector<uint8_t>& file, std::vector<uint8_t>& bgra, uint32_t& w, uint32_t& h);
+
+}  // namespace linuximage
diff --git a/runtime/linux/imgui_sdl.cpp b/runtime/linux/imgui_sdl.cpp
new file mode 100644
index 0000000..08dbd97
--- /dev/null
+++ b/runtime/linux/imgui_sdl.cpp
@@ -0,0 +1,215 @@
+// Linux: ImGui's platform side on SDL. The main thread hands it SDL's events (ImGuiEvent) and the render thread starts
+// each frame (ImGuiNewFrame), both under app::UiLock, so the render thread never calls SDL's window functions, which
+// Wayland wants on the main thread alone. The cursor ImGui asks for goes back to the main loop (g_cursor).
+#ifndef _WIN32
+#include <imgui.h>
+
+#include <chrono>
+#include <cfloat>
+
+#include "linux/sdl_app.h"
+
+namespace linuxapp {
+
+namespace {
+
+SDL_Window* g_imgui_window = nullptr;
+std::chrono::steady_clock::time_point g_last;
+
+ImGuiKey Key(SDL_Keycode k) {
+    if (k >= SDLK_A && k <= SDLK_Z) return ImGuiKey(ImGuiKey_A + (k - SDLK_A));
+    if (k >= SDLK_0 && k <= SDLK_9) return ImGuiKey(ImGuiKey_0 + (k - SDLK_0));
+    if (k >= SDLK_F1 && k <= SDLK_F12) return ImGuiKey(ImGuiKey_F1 + (k - SDLK_F1));
+    switch (k) {
+        case SDLK_TAB: return ImGuiKey_Tab;
+        case SDLK_LEFT: return ImGuiKey_LeftArrow;
+        case SDLK_RIGHT: return ImGuiKey_RightArrow;
+        case SDLK_UP: return ImGuiKey_UpArrow;
+        case SDLK_DOWN: return ImGuiKey_DownArrow;
+        case SDLK_PAGEUP: return ImGuiKey_PageUp;
+        case SDLK_PAGEDOWN: return ImGuiKey_PageDown;
+        case SDLK_HOME: return ImGuiKey_Home;
+        case SDLK_END: return ImGuiKey_End;
+        case SDLK_INSERT: return ImGuiKey_Insert;
+        case SDLK_DELETE: return ImGuiKey_Delete;
+        case SDLK_BACKSPACE: return ImGuiKey_Backspace;
+        case SDLK_SPACE: return ImGuiKey_Space;
+        case SDLK_RETURN: return ImGuiKey_Enter;
+        case SDLK_ESCAPE: return ImGuiKey_Escape;
+        case SDLK_APOSTROPHE: return ImGuiKey_Apostrophe;
+        case SDLK_COMMA: return ImGuiKey_Comma;
+        case SDLK_MINUS: return ImGuiKey_Minus;
+        case SDLK_PERIOD: return ImGuiKey_Period;
+        case SDLK_SLASH: return ImGuiKey_Slash;
+        case SDLK_SEMICOLON: return ImGuiKey_Semicolon;
+        case SDLK_EQUALS: return ImGuiKey_Equal;
+        case SDLK_LEFTBRACKET: return ImGuiKey_LeftBracket;
+        case SDLK_BACKSLASH: return ImGuiKey_Backslash;
+        case SDLK_RIGHTBRACKET: return ImGuiKey_RightBracket;
+        case SDLK_GRAVE: return ImGuiKey_GraveAccent;
+        case SDLK_CAPSLOCK: return ImGuiKey_CapsLock;
+        case SDLK_KP_ENTER: return ImGuiKey_KeypadEnter;
+        case SDLK_KP_0: return ImGuiKey_Keypad0;
+        case SDLK_KP_1: return ImGuiKey_Keypad1;
+        case SDLK_KP_2: return ImGuiKey_Keypad2;
+        case SDLK_KP_3: return ImGuiKey_Keypad3;
+        case SDLK_KP_4: return ImGuiKey_Keypad4;
+        case SDLK_KP_5: return ImGuiKey_Keypad5;
+        case SDLK_KP_6: return ImGuiKey_Keypad6;
+        case SDLK_KP_7: return ImGuiKey_Keypad7;
+        case SDLK_KP_8: return ImGuiKey_Keypad8;
+        case SDLK_KP_9: return ImGuiKey_Keypad9;
+        case SDLK_LCTRL: return ImGuiKey_LeftCtrl;
+        case SDLK_LSHIFT: return ImGuiKey_LeftShift;
+        case SDLK_LALT: return ImGuiKey_LeftAlt;
+        case SDLK_LGUI: return ImGuiKey_LeftSuper;
+        case SDLK_RCTRL: return ImGuiKey_RightCtrl;
+        case SDLK_RSHIFT: return ImGuiKey_RightShift;
+        case SDLK_RALT: return ImGuiKey_RightAlt;
+        case SDLK_RGUI: return ImGuiKey_RightSuper;
+        default: return ImGuiKey_None;
+    }
+}
+
+// a window point in the drawn picture's pixels, which ImGui lays out in
+ImVec2 Pixels(SDL_Window* window, float x, float y) {
+    int w = 0, h = 0;
+    SDL_GetWindowSize(window, &w, &h);
+    float sx = w ? float(g_pixel_w.load()) / float(w) : 1.0f, sy = h ? float(g_pixel_h.load()) / float(h) : 1.0f;
+    return {x * sx, y * sy};
+}
+
+// a controller's buttons and sticks as ImGui's gamepad keys, from port 1's
+void Gamepad(ImGuiIO& io) {
+    SDL_Gamepad* pad = g_nav_pad ? g_nav_pad() : nullptr;
+    if (!pad) {
+        io.BackendFlags &= ~ImGuiBackendFlags_HasGamepad;
+        return;
+    }
+    io.BackendFlags |= ImGuiBackendFlags_HasGamepad;
+    struct Map {
+        ImGuiKey key;
+        SDL_GamepadButton button;
+    };
+    constexpr Map kButtons[] = {
+        {ImGuiKey_GamepadStart, SDL_GAMEPAD_BUTTON_START},       {ImGuiKey_GamepadBack, SDL_GAMEPAD_BUTTON_BACK},
+        {ImGuiKey_GamepadFaceLeft, SDL_GAMEPAD_BUTTON_WEST},     {ImGuiKey_GamepadFaceRight, SDL_GAMEPAD_BUTTON_EAST},
+        {ImGuiKey_GamepadFaceUp, SDL_GAMEPAD_BUTTON_NORTH},      {ImGuiKey_GamepadFaceDown, SDL_GAMEPAD_BUTTON_SOUTH},
+        {ImGuiKey_GamepadDpadLeft, SDL_GAMEPAD_BUTTON_DPAD_LEFT}, {ImGuiKey_GamepadDpadRight, SDL_GAMEPAD_BUTTON_DPAD_RIGHT},
+        {ImGuiKey_GamepadDpadUp, SDL_GAMEPAD_BUTTON_DPAD_UP},    {ImGuiKey_GamepadDpadDown, SDL_GAMEPAD_BUTTON_DPAD_DOWN},
+        {ImGuiKey_GamepadL1, SDL_GAMEPAD_BUTTON_LEFT_SHOULDER},  {ImGuiKey_GamepadR1, SDL_GAMEPAD_BUTTON_RIGHT_SHOULDER},
+        {ImGuiKey_GamepadL3, SDL_GAMEPAD_BUTTON_LEFT_STICK},     {ImGuiKey_GamepadR3, SDL_GAMEPAD_BUTTON_RIGHT_STICK},
+    };
+    for (const Map& m : kButtons) io.AddKeyEvent(m.key, SDL_GetGamepadButton(pad, m.button));
+    // sticks and triggers past a dead zone, as an analog key from 0 to 1
+    auto analog = [&](ImGuiKey key, SDL_GamepadAxis axis, float from, float to) {
+        float v = (float(SDL_GetGamepadAxis(pad, axis)) - from) / (to - from);
+        v = v < 0 ? 0 : v > 1 ? 1 : v;
+        io.AddKeyAnalogEvent(key, v > 0.1f, v);
+    };
+    constexpr float kDead = 8000;
+    analog(ImGuiKey_GamepadL2, SDL_GAMEPAD_AXIS_LEFT_TRIGGER, 0.0f, 32767.0f);
+    analog(ImGuiKey_GamepadR2, SDL_GAMEPAD_AXIS_RIGHT_TRIGGER, 0.0f, 32767.0f);
+    analog(ImGuiKey_GamepadLStickLeft, SDL_GAMEPAD_AXIS_LEFTX, -kDead, -32768.0f);
+    analog(ImGuiKey_GamepadLStickRight, SDL_GAMEPAD_AXIS_LEFTX, kDead, 32767.0f);
+    analog(ImGuiKey_GamepadLStickUp, SDL_GAMEPAD_AXIS_LEFTY, -kDead, -32768.0f);
+    analog(ImGuiKey_GamepadLStickDown, SDL_GAMEPAD_AXIS_LEFTY, kDead, 32767.0f);
+    analog(ImGuiKey_GamepadRStickLeft, SDL_GAMEPAD_AXIS_RIGHTX, -kDead, -32768.0f);
+    analog(ImGuiKey_GamepadRStickRight, SDL_GAMEPAD_AXIS_RIGHTX, kDead, 32767.0f);
+    analog(ImGuiKey_GamepadRStickUp, SDL_GAMEPAD_AXIS_RIGHTY, -kDead, -32768.0f);
+    analog(ImGuiKey_GamepadRStickDown, SDL_GAMEPAD_AXIS_RIGHTY, kDead, 32767.0f);
+}
+
+}  // namespace
+
+void ImGuiInit(SDL_Window* window) {
+    g_imgui_window = window;
+    g_last = std::chrono::steady_clock::now();
+    ImGuiIO& io = ImGui::GetIO();
+    io.BackendPlatformName = "xbe_sdl3";
+    io.BackendFlags |= ImGuiBackendFlags_HasMouseCursors;
+}
+
+void ImGuiEvent(const SDL_Event& e) {
+    if (!ImGui::GetCurrentContext() || !g_imgui_window) return;
+    ImGuiIO& io = ImGui::GetIO();
+    switch (e.type) {
+        case SDL_EVENT_MOUSE_MOTION: {
+            ImVec2 p = Pixels(g_imgui_window, e.motion.x, e.motion.y);
+            io.AddMousePosEvent(p.x, p.y);
+            break;
+        }
+        case SDL_EVENT_MOUSE_BUTTON_DOWN:
+        case SDL_EVENT_MOUSE_BUTTON_UP: {
+            int button = e.button.button == SDL_BUTTON_LEFT ? 0 : e.button.button == SDL_BUTTON_RIGHT ? 1
+                         : e.button.button == SDL_BUTTON_MIDDLE                                       ? 2
+                                                                                                      : -1;
+            if (button >= 0) io.AddMouseButtonEvent(button, e.type == SDL_EVENT_MOUSE_BUTTON_DOWN);
+            break;
+        }
+        case SDL_EVENT_MOUSE_WHEEL:
+            io.AddMouseWheelEvent(-e.wheel.x, e.wheel.y);
+            break;
+        case SDL_EVENT_TEXT_INPUT:
+            io.AddInputCharactersUTF8(e.text.text);
+            break;
+        case SDL_EVENT_KEY_DOWN:
+        case SDL_EVENT_KEY_UP: {
+            bool down = e.type == SDL_EVENT_KEY_DOWN;
+            io.AddKeyEvent(ImGuiMod_Ctrl, (e.key.mod & SDL_KMOD_CTRL) != 0);
+            io.AddKeyEvent(ImGuiMod_Shift, (e.key.mod & SDL_KMOD_SHIFT) != 0);
+            io.AddKeyEvent(ImGuiMod_Alt, (e.key.mod & SDL_KMOD_ALT) != 0);
+            io.AddKeyEvent(ImGuiMod_Super, (e.key.mod & SDL_KMOD_GUI) != 0);
+            if (ImGuiKey k = Key(e.key.key); k != ImGuiKey_None) io.AddKeyEvent(k, down);
+            break;
+        }
+        case SDL_EVENT_WINDOW_FOCUS_GAINED:
+            io.AddFocusEvent(true);
+            break;
+        case SDL_EVENT_WINDOW_FOCUS_LOST:
+            io.AddFocusEvent(false);
+            break;
+        case SDL_EVENT_WINDOW_MOUSE_LEAVE:
+            io.AddMousePosEvent(-FLT_MAX, -FLT_MAX);
+            break;
+        default:
+            break;
+    }
+}
+
+void ImGuiNewFrame() {
+    ImGuiIO& io = ImGui::GetIO();
+    io.DisplaySize = ImVec2(float(g_pixel_w.load()), float(g_pixel_h.load()));
+    auto now = std::chrono::steady_clock::now();
+    float dt = std::chrono::duration<float>(now - g_last).count();
+    io.DeltaTime = dt > 0 ? dt : 1.0f / 60.0f;
+    g_last = now;
+    if (io.ConfigFlags & ImGuiConfigFlags_NavEnableGamepad) Gamepad(io);
+    // the frame before's cursor, which the main loop shows: none when ImGui draws its own or wants none
+    ImGuiMouseCursor c = ImGui::GetMouseCursor();
+    g_cursor = io.MouseDrawCursor || c == ImGuiMouseCursor_None ? -1 : int(c);
+}
+
+void ApplyCursor() {
+    static SDL_Cursor* cursors[ImGuiMouseCursor_COUNT] = {};
+    static int shown = -2;
+    int want = g_cursor;
+    if (want == shown) return;
+    shown = want;
+    if (want < 0) {
+        SDL_HideCursor();
+        return;
+    }
+    static const SDL_SystemCursor kSystem[ImGuiMouseCursor_COUNT] = {
+        SDL_SYSTEM_CURSOR_DEFAULT,     SDL_SYSTEM_CURSOR_TEXT,      SDL_SYSTEM_CURSOR_MOVE,
+        SDL_SYSTEM_CURSOR_NS_RESIZE,   SDL_SYSTEM_CURSOR_EW_RESIZE, SDL_SYSTEM_CURSOR_NESW_RESIZE,
+        SDL_SYSTEM_CURSOR_NWSE_RESIZE, SDL_SYSTEM_CURSOR_POINTER,   SDL_SYSTEM_CURSOR_NOT_ALLOWED};
+    if (want < ImGuiMouseCursor_COUNT) {
+        if (!cursors[want]) cursors[want] = SDL_CreateSystemCursor(kSystem[want]);
+        SDL_SetCursor(cursors[want]);
+    }
+    SDL_ShowCursor();
+}
+
+}  // namespace linuxapp
+#endif
diff --git a/runtime/linux/main.cpp b/runtime/linux/main.cpp
new file mode 100644
index 0000000..b455d5e
--- /dev/null
+++ b/runtime/linux/main.cpp
@@ -0,0 +1,354 @@
+// Linux: the host's window and main loop (app/main.cpp's), on SDL. The main thread takes SDL's events: ImGui's input,
+// the window messages GameInfo::message knows, controllers plugged in or out, the display settings; the game and
+// the renderer run on threads of their own as on Windows.
+#ifndef _WIN32
+#include <execinfo.h>
+#include <pthread.h>
+#include <signal.h>
+#include <unistd.h>
+
+#include <algorithm>
+#include <chrono>
+#include <condition_variable>
+#include <cstring>
+#include <mutex>
+#include <thread>
+
+#include <imgui.h>
+
+#include "app/app.h"
+#include "core/input.h"
+#include "core/log.h"
+#include "gpu/backend.h"
+#include "image_symbols.h"
+#include "kernel/kernel.h"
+#include "linux/sdl_app.h"
+#include "windows.h"
+
+namespace app {
+
+namespace {
+
+int g_argc = 0;
+char** g_argv = nullptr;
+Uint32 g_apply_event = 0, g_open_event = 0;
+// OpenGameWindow waits for the main loop to have opened the window
+std::mutex g_open_lock;
+std::condition_variable g_open_cv;
+uint64_t g_opened = 0;
+
+bool HasArg(const char* arg) {
+    for (int i = 1; i < g_argc; i++)
+        if (!std::strcmp(g_argv[i], arg)) return true;
+    return false;
+}
+
+// the guest's registers and return addresses into the log, then the default action: a core dump where enabled
+void Crash(int sig, siginfo_t* info, void*) {
+    static std::atomic<bool> once{false};
+    if (!once.exchange(true)) {
+        if (kernel::Thread* t = kernel::Current(); t && t->ctx) {
+            uint64_t va = uint64_t(reinterpret_cast<uintptr_t>(info ? info->si_addr : nullptr));
+            uint64_t g = uint64_t(reinterpret_cast<uintptr_t>(kernel::g_base));
+            LOGE("signal %d at %llX on guest thread %X, guest %08llX", sig, (unsigned long long)va, t->id,
+                 (unsigned long long)(va - g));
+            kernel::LogGuestStack(*t->ctx, 256);
+        } else {
+            LOGE("signal %d", sig);
+        }
+        void* frames[64];
+        int n = backtrace(frames, 64);
+        char** names = backtrace_symbols(frames, n);
+        for (int i = 0; names && i < n; i++) LOGE("  %s", names[i]);
+        logx::Flush();
+    }
+    signal(sig, SIG_DFL);
+    raise(sig);
+}
+
+void DumpThreads() {
+    gpu::g_capture = true;
+    for (auto& t : kernel::Threads())
+        if (t->ctx) {
+            LOGI("thread %X", t->id);
+            kernel::LogGuestStack(*t->ctx, 32);
+        }
+}
+
+// main thread only: the window as the settings have it
+void ApplyNow() {
+    SDL_Window* w = linuxapp::g_window;
+    if (!w) return;
+    const Settings& s = Get();
+    Mode out = Output();
+    SDL_DisplayID display = SDL_GetDisplayForWindow(w);
+    if (s.display_mode == DisplayMode::Windowed) {
+        SDL_SetWindowFullscreen(w, false);
+        SDL_SetWindowBordered(w, true);
+        SDL_SetWindowResizable(w, true);
+        SDL_SetWindowSize(w, int(out.width), int(out.height));
+        SDL_SetWindowPosition(w, SDL_WINDOWPOS_CENTERED_DISPLAY(display), SDL_WINDOWPOS_CENTERED_DISPLAY(display));
+    } else if (s.display_mode == DisplayMode::Fullscreen && s.width && s.height) {
+        // a mode of its own, the closest the display has; the desktop's own size is borderless instead
+        SDL_DisplayMode mode{};
+        if (SDL_GetClosestFullscreenDisplayMode(display, int(s.width), int(s.height), 0.0f, true, &mode))
+            SDL_SetWindowFullscreenMode(w, &mode);
+        else
+            SDL_SetWindowFullscreenMode(w, nullptr);
+        SDL_SetWindowFullscreen(w, true);
+    } else {
+        SDL_SetWindowFullscreenMode(w, nullptr);  // the desktop's
+        SDL_SetWindowFullscreen(w, true);
+    }
+    SDL_SyncWindow(w);
+}
+
+void UpdatePixelSize() {
+    int w = 0, h = 0;
+    if (SDL_Window* win = linuxapp::g_window) SDL_GetWindowSizeInPixels(win, &w, &h);
+    linuxapp::g_pixel_w = uint32_t(std::max(w, 1));
+    linuxapp::g_pixel_h = uint32_t(std::max(h, 1));
+}
+
+// an SDL event as the Win32 message GameInfo::message takes; true when it took it
+bool Message(uint32_t msg, uintptr_t wp, intptr_t lp) {
+    intptr_t result = 0;
+    return kGame.message && kGame.message(linuxapp::g_window.load(), msg, wp, lp, &result);
+}
+
+// true: the window is closing
+bool Handle(const SDL_Event& e) {
+    {
+        std::lock_guard lock(UiLock());
+        linuxapp::ImGuiEvent(e);
+    }
+    if (e.type == g_apply_event) {
+        ApplyNow();
+        UpdatePixelSize();
+        return false;
+    }
+    if (e.type == g_open_event) {
+        CloseSplash();
+        if (e.user.code) ApplyNow();
+        SDL_ShowWindow(linuxapp::g_window);
+        SDL_RaiseWindow(linuxapp::g_window);
+        UpdatePixelSize();
+        std::lock_guard lock(g_open_lock);
+        g_opened++;
+        g_open_cv.notify_all();
+        return false;
+    }
+    switch (e.type) {
+        case SDL_EVENT_QUIT:
+            return true;
+        case SDL_EVENT_WINDOW_CLOSE_REQUESTED:
+            Message(WM_CLOSE, 0, 0);
+            return true;
+        case SDL_EVENT_WINDOW_FOCUS_GAINED:
+            linuxapp::g_focused = true;
+            Message(WM_ACTIVATE, WA_ACTIVE, 0);
+            break;
+        case SDL_EVENT_WINDOW_FOCUS_LOST:
+            linuxapp::g_focused = false;
+            Message(WM_ACTIVATE, WA_INACTIVE, 0);
+            break;
+        case SDL_EVENT_WINDOW_PIXEL_SIZE_CHANGED:
+        case SDL_EVENT_WINDOW_RESIZED:
+            UpdatePixelSize();
+            break;
+        case SDL_EVENT_KEY_DOWN:
+        case SDL_EVENT_KEY_UP: {
+            int vk = linuxapp::VirtualKey(e.key.scancode);
+            if (!vk) break;
+            bool down = e.type == SDL_EVENT_KEY_DOWN, alt = (e.key.mod & SDL_KMOD_ALT) != 0;
+            uint32_t msg = down ? (alt ? WM_SYSKEYDOWN : WM_KEYDOWN) : (alt ? WM_SYSKEYUP : WM_KEYUP);
+            // lp as Windows has it: the key in bits 16 on (here its virtual key, GetKeyNameTextW reads it back), a
+            // repeat in bit 30, a release in bit 31
+            intptr_t lp = intptr_t(uint32_t(vk) << 16 | (e.key.repeat ? 1u << 30 : 0) | (down ? 0 : 3u << 30));
+            if (Message(msg, uintptr_t(vk), lp)) break;
+            if (down && vk == VK_F3) DumpThreads();
+            break;
+        }
+        case SDL_EVENT_MOUSE_BUTTON_UP:
+            if (e.button.button == SDL_BUTTON_LEFT)
+                Message(WM_LBUTTONUP, 0, intptr_t(int(e.button.x) & 0xFFFF) | intptr_t(int(e.button.y) & 0xFFFF) << 16);
+            break;
+        case SDL_EVENT_GAMEPAD_ADDED:
+            input::PadAdded(e.gdevice.which);
+            break;
+        case SDL_EVENT_GAMEPAD_REMOVED:
+            input::PadRemoved(e.gdevice.which);
+            break;
+        default:
+            break;
+    }
+    return false;
+}
+
+// the game window's display's refresh rate, read again each second; 0 when unknown
+uint32_t RefreshRate() {
+    static std::atomic<uint32_t> rate{0};
+    static std::atomic<uint64_t> next{0};
+    uint64_t now = SDL_GetTicks();
+    if (now >= next) {
+        next = now + 1000;
+        SDL_Window* w = linuxapp::g_window;
+        const SDL_DisplayMode* m = w ? SDL_GetCurrentDisplayMode(SDL_GetDisplayForWindow(w)) : nullptr;
+        rate = m && m->refresh_rate > 1 ? uint32_t(m->refresh_rate + 0.5f) : 0;
+    }
+    return rate;
+}
+
+}  // namespace
+
+std::filesystem::path ExeDir() {
+    static const std::filesystem::path dir = [] {
+        std::error_code ec;
+        return std::filesystem::read_symlink("/proc/self/exe", ec).parent_path();
+    }();
+    return dir;
+}
+
+int Instance() {
+    static const int n = [] {
+        for (int i = 1; i + 1 < g_argc; i++)
+            if (!std::strcmp(g_argv[i], "--instance")) return std::max(0, std::min(8, std::atoi(g_argv[i + 1])));
+        return 0;
+    }();
+    return n;
+}
+
+void* Window() { return linuxapp::g_window.load(); }
+
+Mode WindowPixels() { return {linuxapp::g_pixel_w, linuxapp::g_pixel_h}; }
+
+std::recursive_mutex& UiLock() {
+    static std::recursive_mutex m;
+    return m;
+}
+
+void ApplyDisplay() {
+    SDL_Event e{};
+    e.type = g_apply_event;
+    SDL_PushEvent(&e);
+}
+
+void OpenGameWindow(bool apply) {
+    std::unique_lock lock(g_open_lock);
+    uint64_t before = g_opened;
+    SDL_Event e{};
+    e.type = g_open_event;
+    e.user.code = apply ? 1 : 0;
+    SDL_PushEvent(&e);
+    g_open_cv.wait_for(lock, std::chrono::seconds(5), [&] { return g_opened != before; });
+}
+
+void Pace() {
+    using clock = std::chrono::steady_clock;
+    static clock::time_point next = clock::now();
+    uint32_t cap = Get().fps_cap;
+    if (cap == kFpsCapRefresh) cap = RefreshRate();
+    auto now = clock::now();
+    if (!cap) {
+        next = now;
+        return;
+    }
+    auto period = std::chrono::nanoseconds(1000000000ull / cap);
+    next += period;
+    if (next < now - period) next = now;
+    while (clock::now() + std::chrono::milliseconds(2) < next) std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    while (clock::now() < next) std::this_thread::yield();
+}
+
+// the command line, for the parts of the app that read it (game_files.cpp, game_code.cpp)
+int Argc() { return g_argc; }
+char** Argv() { return g_argv; }
+
+}  // namespace app
+
+int main(int argc, char** argv) {
+    app::g_argc = argc;
+    app::g_argv = argv;
+    struct sigaction sa{};
+    sa.sa_sigaction = app::Crash;
+    sa.sa_flags = SA_SIGINFO;
+    for (int sig : {SIGSEGV, SIGBUS, SIGILL, SIGFPE, SIGABRT}) sigaction(sig, &sa, nullptr);
+    signal(SIGPIPE, SIG_IGN);
+    // one log a session: a relaunch into another image carries on its predecessor's, as does another release's
+    // executable the game files were handed to (game_files.cpp)
+    bool relaunched = app::HasArg("--relaunched"), handed_over = app::HasArg("--handed-over");
+    std::string log = app::kGame.log;
+    if (app::Instance() > 1) log += "-" + std::to_string(app::Instance());
+    logx::Init((app::ExeDir() / "logs").string(), log, relaunched || handed_over);
+    app::Load();
+    if (app::kGame.init) app::kGame.init();
+    // SDL's video and events on this thread, the controllers' too
+    SDL_SetHint(SDL_HINT_JOYSTICK_ALLOW_BACKGROUND_EVENTS, "1");
+    SDL_SetHint(SDL_HINT_APP_NAME, linuxapp::Utf8(app::kGame.title).c_str());
+    if (!SDL_Init(SDL_INIT_VIDEO | SDL_INIT_GAMEPAD)) {
+        std::fprintf(stderr, "SDL failed to start: %s\n", SDL_GetError());
+        LOGE("SDL failed to start: %s", SDL_GetError());
+        return 1;
+    }
+    app::g_apply_event = SDL_RegisterEvents(2);
+    app::g_open_event = app::g_apply_event + 1;
+    if (relaunched && !logx::kVerbose) LOGR("Relaunched: %s", IMAGE_XBE);
+    else app::LogSystem();
+    LOGR("Video: %s", SDL_GetCurrentVideoDriver());
+
+    app::GameFiles game;
+    if (!app::FindGame(game)) return 1;
+    if (!app::PrepareGameCode(game)) return 1;
+
+    bool splash = app::OpenSplash(), handover = app::StartHandover();
+    std::string title = linuxapp::Utf8(app::kGame.title);
+    if (app::Instance()) title += " [" + std::to_string(app::Instance()) + "]";
+    SDL_Window* window = SDL_CreateWindow(title.c_str(), 1280, 720, SDL_WINDOW_VULKAN | SDL_WINDOW_HIDDEN |
+                                                                        SDL_WINDOW_HIGH_PIXEL_DENSITY);
+    if (!window) {
+        MessageBoxW(nullptr, linuxapp::Wide(std::string("The game window could not be opened: ") + SDL_GetError()).c_str(),
+                    app::kGame.short_title, MB_ICONERROR);
+        return 1;
+    }
+    linuxapp::g_window = window;
+    app::ApplyNow();
+    // behind a splash the window stays hidden until the game's first frame; handed over, it is set up hidden
+    if (!splash && !handover) {
+        SDL_ShowWindow(window);
+        SDL_RaiseWindow(window);
+    }
+    app::UpdatePixelSize();
+
+    IMGUI_CHECKVERSION();
+    ImGui::CreateContext();
+    ImGuiIO& io = ImGui::GetIO();
+    io.IniFilename = nullptr;
+    io.ConfigFlags |= ImGuiConfigFlags_NavEnableKeyboard | ImGuiConfigFlags_NavEnableGamepad;
+    linuxapp::ImGuiInit(window);
+    // the controller reaches the settings menu through the renderer's UiPad (gpu/d3d12.cpp), as on Windows
+
+    input::Init();
+    if (app::kGame.window) app::kGame.window(window);
+    std::string hdd = app::Instance() > 1 ? "hdd" + std::to_string(app::Instance()) : "hdd";
+    if (!kernel::Boot(std::move(game.xbe), IMAGE_XBE, game.dir.string(), (app::ExeDir() / hdd).string())) {
+        MessageBoxW(nullptr, L"The game failed to start, see the log in the logs folder.", app::kGame.short_title,
+                    MB_ICONERROR);
+        return 1;
+    }
+
+    for (bool closing = false; !closing;) {
+        SDL_Event e;
+        // the controllers are updated with each pass of the queue, so it is passed often
+        if (SDL_WaitEventTimeout(&e, 4)) {
+            closing = app::Handle(e);
+            while (!closing && SDL_PollEvent(&e)) closing = app::Handle(e);
+        }
+        linuxapp::ApplyCursor();
+        // text typed into an ImGui field
+        bool text = ImGui::GetIO().WantTextInput;
+        if (text != SDL_TextInputActive(window)) text ? SDL_StartTextInput(window) : SDL_StopTextInput(window);
+    }
+    logx::Flush();
+    kernel::Shutdown(0);
+}
+#endif
diff --git a/runtime/linux/ngx/cv_ngx.cpp b/runtime/linux/ngx/cv_ngx.cpp
new file mode 100644
index 0000000..08df314
--- /dev/null
+++ b/runtime/linux/ngx/cv_ngx.cpp
@@ -0,0 +1,249 @@
+// The bridge to NVIDIA's NGX for NVIDIA DLSS on Linux (cv_ngx.h). Compiled and linked on the player's PC, never
+// released built: the game (linux/dlss_vk.cpp) runs
+//   clang -std=c++20 -O2 -fPIC -nostdinc -nostdinc++ -isystem <compiler>/ngx/stub -I dlss/include -c cv_ngx.cpp
+//   ld.lld -shared -o dlss/libcv_ngx.so cv_ngx.o dlss/libnvsdk_ngx.a
+// with the compiler folder's tools, the headers and libnvsdk_ngx.a being NVIDIA's DLSS SDK's, which the player downloaded
+// from NVIDIA. Freestanding as the game's code is built: no C or C++ library headers (stub/ has the few names NVIDIA's
+// headers include); the C and C++ runtimes the loader calls are the game's own, already loaded when the game loads this.
+#include <vulkan/vulkan.h>
+
+#include "cv_ngx.h"
+#include "nvsdk_ngx_helpers.h"
+#include "nvsdk_ngx_helpers_vk.h"
+#include "nvsdk_ngx_vk.h"
+
+extern "C" {
+// what crtbeginS.o gives a library a compiler driver links: the loader archive's static objects register their ends
+void* __dso_handle = &__dso_handle;
+int snprintf(char* s, size_t n, const char* format, ...);
+}
+
+namespace {
+
+// the game's name to NVIDIA (as on Windows, through Streamline)
+constexpr const char* kProject = "6b3c5f0e-4d2a-4b8e-9a51-c0d1e5f7a923";
+constexpr const char* kEngine = "xboxxbe-recomp";
+
+wchar_t g_data[1024];
+wchar_t g_features[1024];
+const wchar_t* g_paths[1] = {g_features};
+cv_ngx_log g_log = nullptr;
+int32_t g_verbose = 0;
+const char* g_names[64];
+char g_result[160];
+
+NVSDK_NGX_FeatureCommonInfo g_common{};
+NVSDK_NGX_Parameter* g_caps = nullptr;    // NGX's capabilities, from init
+NVSDK_NGX_Parameter* g_params = nullptr;  // DLSS's parameters, from create
+NVSDK_NGX_Handle* g_dlss = nullptr;
+VkDevice g_device = nullptr;
+bool g_inited = false;
+
+// UTF-8 to the wide characters NGX takes its paths as (UTF-32 here)
+void Wide(const char* s, wchar_t* out, size_t size) {
+    size_t n = 0;
+    const unsigned char* p = reinterpret_cast<const unsigned char*>(s ? s : "");
+    while (*p && n + 1 < size) {
+        uint32_t c = *p++;
+        int more = c >= 0xF0 ? 3 : c >= 0xE0 ? 2 : c >= 0xC0 ? 1 : 0;
+        c &= more == 3 ? 0x07 : more == 2 ? 0x0F : more == 1 ? 0x1F : 0x7F;
+        for (; more > 0 && (*p & 0xC0) == 0x80; more--) c = c << 6 | (*p++ & 0x3F);
+        out[n++] = wchar_t(c);
+    }
+    out[n] = 0;
+}
+
+void NVSDK_CONV OnLog(const char* message, NVSDK_NGX_Logging_Level, NVSDK_NGX_Feature) {
+    if (g_log && message) g_log(message);
+}
+
+NVSDK_NGX_FeatureDiscoveryInfo Discovery() {
+    NVSDK_NGX_FeatureDiscoveryInfo d{};
+    d.SDKVersion = NVSDK_NGX_Version_API;
+    d.FeatureID = NVSDK_NGX_Feature_SuperSampling;
+    d.Identifier.IdentifierType = NVSDK_NGX_Application_Identifier_Type_Project_Id;
+    d.Identifier.v.ProjectDesc.ProjectId = kProject;
+    d.Identifier.v.ProjectDesc.EngineType = NVSDK_NGX_ENGINE_TYPE_CUSTOM;
+    d.Identifier.v.ProjectDesc.EngineVersion = kEngine;
+    d.ApplicationDataPath = g_data;
+    d.FeatureInfo = &g_common;
+    return d;
+}
+
+int32_t Names(NVSDK_NGX_Result r, uint32_t count, VkExtensionProperties* props, uint32_t* n, const char* const** names) {
+    uint32_t k = 0;
+    if (NVSDK_NGX_SUCCEED(r) && props)
+        for (uint32_t i = 0; i < count && k < 64; i++) g_names[k++] = props[i].extensionName;
+    *n = k;
+    *names = g_names;
+    return int32_t(r);
+}
+
+NVSDK_NGX_PerfQuality_Value Mode(uint32_t mode) {
+    return mode == 1   ? NVSDK_NGX_PerfQuality_Value_MaxQuality
+           : mode == 2 ? NVSDK_NGX_PerfQuality_Value_Balanced
+           : mode == 3 ? NVSDK_NGX_PerfQuality_Value_MaxPerf
+                       : NVSDK_NGX_PerfQuality_Value_DLAA;
+}
+
+NVSDK_NGX_Resource_VK Resource(const cv_ngx_image& im, bool write) {
+    VkImageSubresourceRange range{};
+    range.aspectMask = 1;  // VK_IMAGE_ASPECT_COLOR_BIT
+    range.levelCount = 1;
+    range.layerCount = 1;
+    return NVSDK_NGX_Create_ImageView_Resource_VK(reinterpret_cast<VkImageView>(im.view),
+                                                  reinterpret_cast<VkImage>(im.image), range, VkFormat(im.format), im.w,
+                                                  im.h, write);
+}
+
+const char* Result(int32_t r) {
+    const wchar_t* w = GetNGXResultAsString(NVSDK_NGX_Result(r));
+    size_t n = 0;
+    for (; w && w[n] && n + 1 < sizeof(g_result); n++) g_result[n] = w[n] < 128 ? char(w[n]) : '?';
+    g_result[n] = 0;
+    return g_result;
+}
+
+void Setup(const char* data, const char* features, cv_ngx_log log, int32_t verbose) {
+    Wide(data, g_data, 1024);
+    Wide(features, g_features, 1024);
+    g_log = log;
+    g_verbose = verbose;
+    g_common = {};
+    g_common.PathListInfo.Path = g_paths;
+    g_common.PathListInfo.Length = 1;
+    // NGX's lines to the game's log (which keeps them when verbose) as well as to its own files in data
+    g_common.LoggingInfo.LoggingCallback = OnLog;
+    g_common.LoggingInfo.MinimumLoggingLevel = verbose ? NVSDK_NGX_LOGGING_LEVEL_VERBOSE : NVSDK_NGX_LOGGING_LEVEL_ON;
+    g_common.LoggingInfo.DisableOtherLoggingSinks = false;
+}
+
+int32_t InstanceExtensions(uint32_t* n, const char* const** names) {
+    NVSDK_NGX_FeatureDiscoveryInfo d = Discovery();
+    uint32_t count = 0;
+    VkExtensionProperties* props = nullptr;
+    NVSDK_NGX_Result r = NVSDK_NGX_VULKAN_GetFeatureInstanceExtensionRequirements(&d, &count, &props);
+    return Names(r, count, props, n, names);
+}
+
+int32_t DeviceExtensions(void* instance, void* pd, uint32_t* n, const char* const** names) {
+    NVSDK_NGX_FeatureDiscoveryInfo d = Discovery();
+    uint32_t count = 0;
+    VkExtensionProperties* props = nullptr;
+    NVSDK_NGX_Result r = NVSDK_NGX_VULKAN_GetFeatureDeviceExtensionRequirements(
+        static_cast<VkInstance>(instance), static_cast<VkPhysicalDevice>(pd), &d, &count, &props);
+    return Names(r, count, props, n, names);
+}
+
+int32_t Init(void* instance, void* pd, void* device, void* gipa, void* gdpa) {
+    NVSDK_NGX_Result r = NVSDK_NGX_VULKAN_Init_with_ProjectID(
+        kProject, NVSDK_NGX_ENGINE_TYPE_CUSTOM, kEngine, g_data, static_cast<VkInstance>(instance),
+        static_cast<VkPhysicalDevice>(pd), static_cast<VkDevice>(device), reinterpret_cast<PFN_vkGetInstanceProcAddr>(gipa),
+        reinterpret_cast<PFN_vkGetDeviceProcAddr>(gdpa), &g_common, NVSDK_NGX_Version_API);
+    if (NVSDK_NGX_FAILED(r)) return int32_t(r);
+    g_inited = true;
+    g_device = static_cast<VkDevice>(device);
+    return int32_t(NVSDK_NGX_VULKAN_GetCapabilityParameters(&g_caps));
+}
+
+int32_t Available(char* why, uint32_t size) {
+    if (!g_caps) {
+        snprintf(why, size, "NGX did not start");
+        return 0;
+    }
+    int ok = 0, update = 0;
+    unsigned int major = 0, minor = 0;
+    int result = 0;
+    g_caps->Get(NVSDK_NGX_Parameter_SuperSampling_Available, &ok);
+    g_caps->Get(NVSDK_NGX_Parameter_SuperSampling_NeedsUpdatedDriver, &update);
+    g_caps->Get(NVSDK_NGX_Parameter_SuperSampling_MinDriverVersionMajor, &major);
+    g_caps->Get(NVSDK_NGX_Parameter_SuperSampling_MinDriverVersionMinor, &minor);
+    g_caps->Get(NVSDK_NGX_Parameter_SuperSampling_FeatureInitResult, &result);
+    if (ok) return 1;
+    if (update)
+        snprintf(why, size, "it needs NVIDIA's driver %u.%u or later", major, minor);
+    else
+        snprintf(why, size, "not on this card or driver (%s)", Result(result));
+    return 0;
+}
+
+int32_t Optimal(uint32_t w, uint32_t h, uint32_t mode, uint32_t* rw, uint32_t* rh) {
+    if (!g_caps) return int32_t(NVSDK_NGX_Result_FAIL_NotInitialized);
+    unsigned int ow = 0, oh = 0, maxw = 0, maxh = 0, minw = 0, minh = 0;
+    float sharpness = 0;
+    NVSDK_NGX_Result r =
+        NGX_DLSS_GET_OPTIMAL_SETTINGS(g_caps, w, h, Mode(mode), &ow, &oh, &maxw, &maxh, &minw, &minh, &sharpness);
+    *rw = ow;
+    *rh = oh;
+    return int32_t(r);
+}
+
+void Release() {
+    if (g_dlss) NVSDK_NGX_VULKAN_ReleaseFeature(g_dlss);
+    g_dlss = nullptr;
+    if (g_params) NVSDK_NGX_VULKAN_DestroyParameters(g_params);
+    g_params = nullptr;
+}
+
+int32_t Create(void* cmd, uint32_t w, uint32_t h, uint32_t rw, uint32_t rh, uint32_t mode, int32_t inverted) {
+    Release();
+    NVSDK_NGX_Result r = NVSDK_NGX_VULKAN_AllocateParameters(&g_params);
+    if (NVSDK_NGX_FAILED(r)) return int32_t(r);
+    NVSDK_NGX_DLSS_Create_Params c{};
+    c.Feature.InWidth = rw;
+    c.Feature.InHeight = rh;
+    c.Feature.InTargetWidth = w;
+    c.Feature.InTargetHeight = h;
+    c.Feature.InPerfQualityValue = Mode(mode);
+    // the game's 8 bit gamma-encoded colour with its own exposure, its motion at the size drawn and taken before the
+    // frame's offset (as on Windows: framegen.cpp's FillConstants)
+    c.InFeatureCreateFlags = NVSDK_NGX_DLSS_Feature_Flags_MVLowRes | (inverted ? NVSDK_NGX_DLSS_Feature_Flags_DepthInverted : 0);
+    c.InEnableOutputSubrects = false;
+    r = NGX_VULKAN_CREATE_DLSS_EXT(static_cast<VkCommandBuffer>(cmd), 1, 1, &g_dlss, g_params, &c);
+    if (NVSDK_NGX_FAILED(r)) {
+        g_dlss = nullptr;
+        Release();
+    }
+    return int32_t(r);
+}
+
+int32_t Evaluate(void* cmd, const cv_ngx_frame* f) {
+    if (!g_dlss || !g_params) return int32_t(NVSDK_NGX_Result_FAIL_FeatureNotFound);
+    NVSDK_NGX_Resource_VK color = Resource(f->color, false), depth = Resource(f->depth, false),
+                          motion = Resource(f->motion, false), output = Resource(f->output, true),
+                          bias = Resource(f->bias, false);
+    NVSDK_NGX_VK_DLSS_Eval_Params e{};
+    e.Feature.pInColor = &color;
+    e.Feature.pInOutput = &output;
+    e.pInDepth = &depth;
+    e.pInMotionVectors = &motion;
+    if (f->bias.image) e.pInBiasCurrentColorMask = &bias;
+    e.InJitterOffsetX = f->jitter[0];
+    e.InJitterOffsetY = f->jitter[1];
+    e.InRenderSubrectDimensions.Width = f->rw;
+    e.InRenderSubrectDimensions.Height = f->rh;
+    e.InReset = f->reset;
+    e.InMVScaleX = f->mv_scale[0];
+    e.InMVScaleY = f->mv_scale[1];
+    e.InPreExposure = 1;
+    e.InExposureScale = 1;
+    e.InFrameTimeDeltaInMsec = f->frame_ms;
+    return int32_t(NGX_VULKAN_EVALUATE_DLSS_EXT(static_cast<VkCommandBuffer>(cmd), g_dlss, g_params, &e));
+}
+
+void Shutdown() {
+    Release();
+    if (g_caps) NVSDK_NGX_VULKAN_DestroyParameters(g_caps);
+    g_caps = nullptr;
+    if (g_inited) NVSDK_NGX_VULKAN_Shutdown1(g_device);
+    g_inited = false;
+}
+
+const cv_ngx kApi = {CV_NGX_ABI, Result,   Setup,    InstanceExtensions, DeviceExtensions, Init, Available,
+                     Optimal,    Create,   Evaluate, Release,            Shutdown};
+
+}  // namespace
+
+extern "C" __attribute__((visibility("default"))) const cv_ngx* cv_ngx_get(uint32_t abi) {
+    return abi == CV_NGX_ABI ? &kApi : nullptr;
+}
diff --git a/runtime/linux/ngx/cv_ngx.h b/runtime/linux/ngx/cv_ngx.h
new file mode 100644
index 0000000..9539406
--- /dev/null
+++ b/runtime/linux/ngx/cv_ngx.h
@@ -0,0 +1,69 @@
+// The bridge between the game and NVIDIA's NGX, for NVIDIA DLSS on Linux (linux/dlss_vk.h). The game's download carries
+// none of NVIDIA's code: the bridge (cv_ngx.cpp) is compiled and linked on the player's PC, by the compiler folder's clang
+// and ld.lld, with the parts of NVIDIA's DLSS SDK the player downloaded (its headers and its NGX loader,
+// libnvsdk_ngx.a), into dlss/libcv_ngx.so beside the executables, which the game loads. NGX itself is the NVIDIA
+// driver's (libnvidia-ngx.so.1); it loads DLSS from the library NVIDIA releases with the SDK
+// (libnvidia-ngx-dlss.so.<version>, in dlss/ too).
+//
+// Plain C between the two: Vulkan's handles as pointers and 64 bit integers, so neither side needs the other's headers.
+#pragma once
+
+#include <stdint.h>
+
+#define CV_NGX_ABI 1
+
+extern "C" {
+
+// an image of the game's: its VkImage, a VkImageView of all of it (colour), its VkFormat and size
+struct cv_ngx_image {
+    uint64_t image;
+    uint64_t view;
+    uint32_t format;
+    uint32_t w, h;
+};
+
+// a frame's DLSS: the inputs drawn into their top left rw x rh, the output whole, every image in VK_IMAGE_LAYOUT_GENERAL
+struct cv_ngx_frame {
+    cv_ngx_image color, depth, motion, output;
+    cv_ngx_image bias;  // R8, the share of each pixel taken from this frame rather than gathered; image 0: none
+    uint32_t rw, rh;
+    float jitter[2];    // the frame's offset, in pixels of the part drawn
+    float mv_scale[2];  // the motion's units to pixels of the part drawn
+    float frame_ms;
+    int32_t reset;      // nothing to gather from: a cut, the first frame
+};
+
+typedef void (*cv_ngx_log)(const char* line);
+
+// NGX's results are its NVSDK_NGX_Result: 1 success, 0xBADxxxxx failures (result() names them)
+struct cv_ngx {
+    uint32_t abi;  // CV_NGX_ABI
+    const char* (*result)(int32_t r);
+    // the folders NGX writes its logs to (data) and finds DLSS's library in (features), as UTF-8; NGX's own log lines
+    // to log, every one when verbose; first, before the rest
+    void (*setup)(const char* data, const char* features, cv_ngx_log log, int32_t verbose);
+    // the Vulkan instance and device extensions DLSS asks for (before the instance, and the device, are made); the
+    // names valid until the next call
+    int32_t (*instance_extensions)(uint32_t* n, const char* const** names);
+    int32_t (*device_extensions)(void* instance, void* physical_device, uint32_t* n, const char* const** names);
+    // NGX on the game's Vulkan device (VkInstance, VkPhysicalDevice, VkDevice, vkGetInstanceProcAddr,
+    // vkGetDeviceProcAddr)
+    int32_t (*init)(void* instance, void* physical_device, void* device, void* gipa, void* gdpa);
+    // DLSS on this card and driver: 1, else 0 and why
+    int32_t (*available)(char* why, uint32_t why_size);
+    // the size DLSS draws from for an output of w x h at a mode: 0 DLAA (the output's own), 1 Quality, 2 Balanced,
+    // 3 Performance
+    int32_t (*optimal)(uint32_t w, uint32_t h, uint32_t mode, uint32_t* rw, uint32_t* rh);
+    // DLSS for an output of w x h drawn from up to rw x rh at a mode, its depth near at 1 when depth_inverted; recorded
+    // into cmd (a VkCommandBuffer being recorded); the one before released
+    int32_t (*create)(void* cmd, uint32_t w, uint32_t h, uint32_t rw, uint32_t rh, uint32_t mode, int32_t depth_inverted);
+    // a frame's, recorded into cmd
+    int32_t (*evaluate)(void* cmd, const cv_ngx_frame* f);
+    void (*release)();
+    void (*shutdown)();
+};
+
+// the bridge's table, null when it was built for another ABI
+typedef const cv_ngx* (*cv_ngx_get_fn)(uint32_t abi);
+const cv_ngx* cv_ngx_get(uint32_t abi);
+}
diff --git a/runtime/linux/ngx/stub/stdbool.h b/runtime/linux/ngx/stub/stdbool.h
new file mode 100644
index 0000000..96c949f
--- /dev/null
+++ b/runtime/linux/ngx/stub/stdbool.h
@@ -0,0 +1,2 @@
+#pragma once
+// the bridge is built freestanding (cv_ngx.cpp): bool is C++'s own
diff --git a/runtime/linux/ngx/stub/stddef.h b/runtime/linux/ngx/stub/stddef.h
new file mode 100644
index 0000000..552e29c
--- /dev/null
+++ b/runtime/linux/ngx/stub/stddef.h
@@ -0,0 +1,6 @@
+#pragma once
+// the bridge is built freestanding (cv_ngx.cpp): the C names NVIDIA's headers use, from the compiler's own types
+typedef decltype(sizeof(0)) size_t;
+typedef decltype(static_cast<int*>(nullptr) - static_cast<int*>(nullptr)) ptrdiff_t;
+#define NULL nullptr
+#define offsetof(t, m) __builtin_offsetof(t, m)
