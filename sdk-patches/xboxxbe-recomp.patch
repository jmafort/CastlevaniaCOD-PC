@@ -0,0 +1,30 @@
+#pragma once
+// Linux: a sans serif font of the system's for the SDK's own windows (the first start's build), as Windows draws them
+// in its message font; ImGui's built in one when the system has none of these
+#include <imgui.h>
+
+#include <filesystem>
+
+namespace linuxapp {
+
+inline void LoadUiFont(ImGuiIO& io, float pixels) {
+    static const char* kFonts[] = {
+        "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",          // Debian, Ubuntu
+        "/usr/share/fonts/TTF/DejaVuSans.ttf",                      // Arch
+        "/usr/share/fonts/dejavu-sans-fonts/DejaVuSans.ttf",        // Fedora
+        "/usr/share/fonts/truetype/noto/NotoSans-Regular.ttf",
+        "/usr/share/fonts/noto/NotoSans-Regular.ttf",
+        "/usr/share/fonts/google-noto/NotoSans-Regular.ttf",
+        "/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf",
+        "/usr/share/fonts/liberation-sans/LiberationSans-Regular.ttf",
+        "/usr/share/fonts/truetype/ubuntu/Ubuntu-R.ttf",
+    };
+    std::error_code ec;
+    for (const char* path : kFonts)
+        if (std::filesystem::exists(path, ec) && io.Fonts->AddFontFromFileTTF(path, pixels)) return;
+    ImFontConfig config;
+    config.SizePixels = pixels;
+    io.Fonts->AddFontDefault(&config);
+}
+
+}  // namespace linuxapp
diff --git a/runtime/linux/vk_images.cpp b/runtime/linux/vk_images.cpp
new file mode 100644
index 0000000..7ded624
--- /dev/null
+++ b/runtime/linux/vk_images.cpp
@@ -0,0 +1,125 @@
+// Linux: Vulkan images of the renderer's own as D3D12 resources (linux/vk_images.h)
+#ifndef _WIN32
+#include "linux/vk_images.h"
+
+#include <vkd3d.h>
+
+#include <mutex>
+#include <unordered_map>
+
+#include "core/log.h"
+
+namespace gpu::linux_vk {
+
+namespace {
+
+std::mutex g_images_m;
+std::unordered_map<ID3D12Resource*, Image> g_images;
+
+uint32_t MemoryType(VkPhysicalDevice pd, uint32_t bits, VkMemoryPropertyFlags want) {
+    VkPhysicalDeviceMemoryProperties mp;
+    vkGetPhysicalDeviceMemoryProperties(pd, &mp);
+    for (uint32_t i = 0; i < mp.memoryTypeCount; i++)
+        if ((bits >> i & 1) && (mp.memoryTypes[i].propertyFlags & want) == want) return i;
+    return UINT32_MAX;
+}
+
+void Free(const Image& im) {
+    if (im.view) vkDestroyImageView(im.device, im.view, nullptr);
+    if (im.image) vkDestroyImage(im.device, im.image, nullptr);
+    if (im.memory) vkFreeMemory(im.device, im.memory, nullptr);
+}
+
+}  // namespace
+
+ID3D12Resource* MakeImage(ID3D12Device* dev, uint32_t w, uint32_t h, DXGI_FORMAT format, bool render_target) {
+    VkDevice vkd = vkd3d_get_vk_device(dev);
+    VkPhysicalDevice pd = vkd3d_get_vk_physical_device(dev);
+    VkFormat vf = vkd3d_get_vk_format(format);
+    VkFormatProperties fp;
+    vkGetPhysicalDeviceFormatProperties(pd, vf, &fp);
+    bool storage = (fp.optimalTilingFeatures & VK_FORMAT_FEATURE_STORAGE_IMAGE_BIT) != 0;
+    Image im;
+    im.device = vkd;
+    im.storage = storage;
+    im.info = {VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+    im.info.imageType = VK_IMAGE_TYPE_2D;
+    im.info.format = vf;
+    im.info.extent = {w, h, 1};
+    im.info.mipLevels = 1;
+    im.info.arrayLayers = 1;
+    im.info.samples = VK_SAMPLE_COUNT_1_BIT;
+    im.info.tiling = VK_IMAGE_TILING_OPTIMAL;
+    im.info.usage = VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT |
+                    (storage ? VK_IMAGE_USAGE_STORAGE_BIT : 0) | (render_target ? VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT : 0);
+    im.info.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+    if (vkCreateImage(vkd, &im.info, nullptr, &im.image) != VK_SUCCESS) {
+        LOGR("antialias: no %ux%u Vulkan image of format %d", w, h, int(vf));
+        return nullptr;
+    }
+    VkMemoryRequirements req;
+    vkGetImageMemoryRequirements(vkd, im.image, &req);
+    VkMemoryAllocateInfo mi{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+    mi.allocationSize = req.size;
+    mi.memoryTypeIndex = MemoryType(pd, req.memoryTypeBits, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+    if (mi.memoryTypeIndex == UINT32_MAX) mi.memoryTypeIndex = MemoryType(pd, req.memoryTypeBits, 0);
+    if (vkAllocateMemory(vkd, &mi, nullptr, &im.memory) != VK_SUCCESS) {
+        Free(im);
+        return nullptr;
+    }
+    vkBindImageMemory(vkd, im.image, im.memory, 0);
+    VkImageViewCreateInfo vi{VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO};
+    vi.image = im.image;
+    vi.viewType = VK_IMAGE_VIEW_TYPE_2D;
+    vi.format = vf;
+    vi.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+    if (vkCreateImageView(vkd, &vi, nullptr, &im.view) != VK_SUCCESS) {
+        Free(im);
+        return nullptr;
+    }
+    vkd3d_image_resource_create_info ri{};
+    ri.type = VKD3D_STRUCTURE_TYPE_IMAGE_RESOURCE_CREATE_INFO;
+    ri.vk_image = im.image;
+    ri.desc.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    ri.desc.Width = w;
+    ri.desc.Height = h;
+    ri.desc.DepthOrArraySize = 1;
+    ri.desc.MipLevels = 1;
+    ri.desc.Format = format;
+    ri.desc.SampleDesc.Count = 1;
+    ri.desc.Flags = (render_target ? D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET : D3D12_RESOURCE_FLAG_NONE) |
+                    (storage ? D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS : D3D12_RESOURCE_FLAG_NONE);
+    ri.flags = VKD3D_RESOURCE_INITIAL_STATE_TRANSITION;
+    ID3D12Resource* r = nullptr;
+    if (FAILED(vkd3d_create_image_resource(dev, &ri, &r))) {
+        Free(im);
+        return nullptr;
+    }
+    std::lock_guard lock(g_images_m);
+    g_images[r] = im;
+    return r;
+}
+
+void DropImage(ID3D12Resource* resource) {
+    Image im;
+    {
+        std::lock_guard lock(g_images_m);
+        auto it = g_images.find(resource);
+        if (it == g_images.end()) return;
+        im = it->second;
+        g_images.erase(it);
+    }
+    Free(im);
+}
+
+bool Find(ID3D12Resource* resource, Image& out) {
+    if (!resource) return false;
+    std::lock_guard lock(g_images_m);
+    auto it = g_images.find(resource);
+    if (it == g_images.end()) return false;
+    out = it->second;
+    return true;
+}
+
+}  // namespace gpu::linux_vk
+#endif
diff --git a/runtime/linux/vk_images.h b/runtime/linux/vk_images.h
new file mode 100644
index 0000000..ecdacf9
--- /dev/null
+++ b/runtime/linux/vk_images.h
@@ -0,0 +1,35 @@
+#pragma once
+// Linux: Vulkan images of the renderer's own as D3D12 resources, for the anti-aliasing that runs on Vulkan itself rather
+// than through vkd3d (AMD FSR 3, linux/fsr_vk.h; NVIDIA DLSS, linux/dlss_vk.h). Those take Vulkan images, and vkd3d gives
+// no image of a resource it made, so the inputs and the output are images made here, wrapped as D3D12 resources for the
+// renderer: it draws its depth and motion into them and copies the frame's colour in.
+#include <vulkan/vulkan.h>
+
+#include <cstdint>
+
+#include "d3d12.h"
+
+namespace gpu::linux_vk {
+
+// a w x h image as a D3D12 resource in COMMON (Vulkan's GENERAL layout), sampled, stored to (where the format allows:
+// render_target formats and RGBA always) and copied to or from; a render target too when asked. Null when it cannot be
+// made (logged)
+ID3D12Resource* MakeImage(ID3D12Device* dev, uint32_t w, uint32_t h, DXGI_FORMAT format, bool render_target);
+
+// an image MakeImage made, its resource released and the GPU done with it: its Vulkan image, view and memory freed
+void DropImage(ID3D12Resource* resource);
+
+// a MakeImage image's Vulkan side
+struct Image {
+    VkDevice device = VK_NULL_HANDLE;
+    VkImage image = VK_NULL_HANDLE;
+    VkImageView view = VK_NULL_HANDLE;  // all of it, its colour
+    VkDeviceMemory memory = VK_NULL_HANDLE;
+    VkImageCreateInfo info{};
+    bool storage = false;
+};
+
+// the image under a resource MakeImage made; false for any other
+bool Find(ID3D12Resource* resource, Image& out);
+
+}  // namespace gpu::linux_vk
diff --git a/runtime/linux/win32.cpp b/runtime/linux/win32.cpp
new file mode 100644
index 0000000..4af696d
