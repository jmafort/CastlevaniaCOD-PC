-set_source_files_properties(${XBE_SDK_DIR}/runtime/core/input.cpp PROPERTIES INCLUDE_DIRECTORIES "${sdl3_SOURCE_DIR}/include")
+
+# ray tracing's shaders (runtime/gpu/rt_*.hlsl, gpu/raytrace.h): DXIL passes with inline ray queries, each a full
+# screen triangle's vertex shader (vs) and a pixel shader (ps), made into headers (k_<name>_vs, k_<name>_ps) by the
+# Windows SDK's dxc, which signs them with its dxil.dll. Without dxc the runtime builds without ray tracing
+# (XBE_RAYTRACING 0) and keeps its screen space passes
+file(GLOB XBE_RT_KITS "C:/Program Files (x86)/Windows Kits/10/bin/10.*/x64")
+list(SORT XBE_RT_KITS COMPARE NATURAL ORDER DESCENDING)
+find_program(XBE_DXC dxc HINTS "$ENV{WindowsSdkVerBinPath}x64" ${XBE_RT_KITS} NO_DEFAULT_PATH)
+set(XBE_RT_GEN ${CMAKE_BINARY_DIR}/xbe_rt)
+set(XBE_RT_HEADERS)
+if(XBE_DXC)
+    file(GLOB XBE_RT_HLSL CONFIGURE_DEPENDS ${XBE_SDK_DIR}/runtime/gpu/rt_*.hlsl)
+    file(GLOB XBE_RT_HLSLI CONFIGURE_DEPENDS ${XBE_SDK_DIR}/runtime/gpu/rt_*.hlsli)
+    foreach(hlsl ${XBE_RT_HLSL})
+        get_filename_component(name ${hlsl} NAME_WE)
+        foreach(stage vs ps)
+            add_custom_command(OUTPUT ${XBE_RT_GEN}/${name}_${stage}.h
+                COMMAND ${CMAKE_COMMAND} -E make_directory ${XBE_RT_GEN}
+                COMMAND ${XBE_DXC} -nologo -T ${stage}_6_5 -E ${stage} -O3 -Vn k_${name}_${stage}
+                        -Fh ${XBE_RT_GEN}/${name}_${stage}.h ${hlsl}
+                DEPENDS ${hlsl} ${XBE_RT_HLSLI} VERBATIM)
+            list(APPEND XBE_RT_HEADERS ${XBE_RT_GEN}/${name}_${stage}.h)
+        endforeach()
+    endforeach()
+    add_custom_target(xbe_rt_shaders DEPENDS ${XBE_RT_HEADERS})
+    message(STATUS "XbeRecomp: ray tracing's shaders by ${XBE_DXC}")
+else()
+    message(STATUS "XbeRecomp: no dxc found, the runtime builds without ray tracing")
+endif()
+# SDL's headers go to the input code alone (it is linked LINK_ONLY); on Linux, to the window, sound and screen code too
+set(XBE_SDL_SOURCES ${XBE_SDK_DIR}/runtime/core/input.cpp)
+if(NOT WIN32)
+    file(GLOB XBE_SDL_LINUX CONFIGURE_DEPENDS ${XBE_SDK_DIR}/runtime/app/*.cpp ${XBE_SDK_DIR}/runtime/linux/*.cpp)
+    list(APPEND XBE_SDL_SOURCES ${XBE_SDL_LINUX} ${XBE_SDK_DIR}/runtime/gpu/d3d12.cpp)
+endif()
+set_source_files_properties(${XBE_SDL_SOURCES} PROPERTIES INCLUDE_DIRECTORIES "${sdl3_SOURCE_DIR}/include")
+# frame generation's vendor headers (MIT, third_party): FidelityFX's and Streamline's, their libraries loaded at run time
+set_source_files_properties(${XBE_SDK_DIR}/runtime/gpu/framegen.cpp PROPERTIES INCLUDE_DIRECTORIES
+    "${XBE_SDK_DIR}/third_party/fidelityfx;${XBE_SDK_DIR}/third_party/streamline/include")
+
+# Linux: D3D12 on Vulkan through vkd3d (WineHQ's), built beside this or installed; a release carries its libraries
+if(NOT WIN32)
+    set(XBE_VKD3D_DIR "" CACHE PATH "vkd3d's install prefix (include/vkd3d, lib)")
+    find_path(XBE_VKD3D_INCLUDE vkd3d.h PATHS ${XBE_VKD3D_DIR}/include PATH_SUFFIXES vkd3d REQUIRED)
+    find_library(XBE_VKD3D_LIB vkd3d PATHS ${XBE_VKD3D_DIR}/lib REQUIRED)
+    find_library(XBE_VKD3D_UTILS_LIB vkd3d-utils PATHS ${XBE_VKD3D_DIR}/lib REQUIRED)
+    find_library(XBE_VKD3D_SHADER_LIB vkd3d-shader PATHS ${XBE_VKD3D_DIR}/lib REQUIRED)
+    find_package(Vulkan REQUIRED)
+    get_filename_component(XBE_VKD3D_LIB_DIR ${XBE_VKD3D_LIB} DIRECTORY)
+    # AMD FSR 3's upscaler on Vulkan (runtime/linux/fsr_vk.cpp): the FidelityFX SDK 1.1.4's Linux fork, its sdk folder
+    # once built (include, bin/ffx_sdk); without it AMD FSR's place is the renderer's own TAA
+    set(XBE_FSR_VK_DIR "" CACHE PATH "the FidelityFX SDK's sdk folder, built for Vulkan on Linux")
