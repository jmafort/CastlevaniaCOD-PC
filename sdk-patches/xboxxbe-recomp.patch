+    mem_most_ = std::max(mem_most_, m.CurrentUsage);
+    if (trace) LOGR("memory trace: frame %llu, %.3f of %.2f GB", (unsigned long long)presents_,
+                    double(m.CurrentUsage) / (1024.0 * 1024.0 * 1024.0), double(m.Budget) / (1024.0 * 1024.0 * 1024.0));
