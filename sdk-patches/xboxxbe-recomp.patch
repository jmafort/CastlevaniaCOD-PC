+// Linux: PNG files through stb, BC blocks unpacked as WIC's DDS decoder unpacks them (linux/image.h)
+#ifndef _WIN32
+#include "linux/image.h"
+
+#include <algorithm>
+#include <cstring>
+#include <fstream>
+
+#define STB_IMAGE_IMPLEMENTATION
+#define STB_IMAGE_WRITE_IMPLEMENTATION
+#define STBI_NO_HDR
+#define STBI_NO_PIC
+#define STBI_NO_PNM
+#define STBI_NO_PSD
+#define STBI_NO_GIF
+#include <stb_image.h>
+#include <stb_image_write.h>
+
+namespace linuximage {
+
+namespace {
+
+// stb's RGBA to BGRA, in place
+void SwapRedBlue(uint8_t* px, size_t count) {
+    for (size_t i = 0; i < count; i++) std::swap(px[i * 4], px[i * 4 + 2]);
+}
+
+bool FromStb(uint8_t* rgba, int w, int h, std::vector<uint8_t>& bgra, uint32_t& ow, uint32_t& oh) {
+    if (!rgba || w <= 0 || h <= 0) {
+        if (rgba) stbi_image_free(rgba);
+        return false;
+    }
+    bgra.assign(rgba, rgba + size_t(w) * size_t(h) * 4);
+    stbi_image_free(rgba);
+    SwapRedBlue(bgra.data(), size_t(w) * size_t(h));
+    ow = uint32_t(w);
+    oh = uint32_t(h);
+    return true;
+}
+
+uint32_t Read32(const uint8_t* p) {
+    uint32_t v;
+    std::memcpy(&v, p, 4);
+    return v;
+}
+
+// a 565 colour as BGRA
+void Expand(uint16_t c, uint8_t* out) {
+    uint32_t r = c >> 11 & 31, g = c >> 5 & 63, b = c & 31;
+    out[0] = uint8_t(b << 3 | b >> 2);
+    out[1] = uint8_t(g << 2 | g >> 4);
+    out[2] = uint8_t(r << 3 | r >> 2);
+    out[3] = 255;
+}
+
+// a BC1 colour block's 16 pixels; four colours always in BC2 and BC3, as their blocks have them
+void ColourBlock(const uint8_t* b, bool four, uint8_t px[16][4]) {
+    uint16_t c0 = uint16_t(b[0] | b[1] << 8), c1 = uint16_t(b[2] | b[3] << 8);
+    uint8_t pal[4][4];
+    Expand(c0, pal[0]);
+    Expand(c1, pal[1]);
+    if (four || c0 > c1) {
+        for (int i = 0; i < 3; i++) {
+            pal[2][i] = uint8_t((2 * pal[0][i] + pal[1][i]) / 3);
+            pal[3][i] = uint8_t((pal[0][i] + 2 * pal[1][i]) / 3);
+        }
+        pal[2][3] = pal[3][3] = 255;
+    } else {
+        for (int i = 0; i < 3; i++) pal[2][i] = uint8_t((pal[0][i] + pal[1][i]) / 2);
+        pal[2][3] = 255;
+        pal[3][0] = pal[3][1] = pal[3][2] = pal[3][3] = 0;
+    }
+    uint32_t idx = Read32(b + 4);
+    for (int i = 0; i < 16; i++) std::memcpy(px[i], pal[idx >> (2 * i) & 3], 4);
+}
+
+}  // namespace
+
+bool ReadFile(const std::filesystem::path& path, std::vector<uint8_t>& bgra, uint32_t& w, uint32_t& h) {
+    int iw = 0, ih = 0, n = 0;
+    return FromStb(stbi_load(path.c_str(), &iw, &ih, &n, 4), iw, ih, bgra, w, h);
+}
+
+bool ReadMemory(const uint8_t* data, size_t size, std::vector<uint8_t>& bgra, uint32_t& w, uint32_t& h) {
+    int iw = 0, ih = 0, n = 0;
+    return FromStb(stbi_load_from_memory(data, int(size), &iw, &ih, &n, 4), iw, ih, bgra, w, h);
+}
+
+bool WritePng(const std::filesystem::path& path, const uint8_t* bgra, uint32_t w, uint32_t h, uint32_t pitch) {
+    std::vector<uint8_t> rgba(size_t(w) * h * 4);
+    for (uint32_t y = 0; y < h; y++) std::memcpy(&rgba[size_t(y) * w * 4], bgra + size_t(y) * pitch, size_t(w) * 4);
+    SwapRedBlue(rgba.data(), size_t(w) * h);
+    return stbi_write_png(path.c_str(), int(w), int(h), 4, rgba.data(), int(w * 4)) != 0;
+}
+
+void DecodeBc(int bc, const uint8_t* blocks, uint32_t w, uint32_t h, std::vector<uint8_t>& bgra) {
+    bgra.assign(size_t(w) * h * 4, 0);
+    uint32_t bw = (w + 3) / 4, bh = (h + 3) / 4, size = bc == 1 ? 8 : 16;
+    for (uint32_t by = 0; by < bh; by++)
+        for (uint32_t bx = 0; bx < bw; bx++) {
+            const uint8_t* b = blocks + (size_t(by) * bw + bx) * size;
+            uint8_t px[16][4];
+            ColourBlock(bc == 1 ? b : b + 8, bc != 1, px);
+            if (bc == 2) {
+                // explicit alpha, 4 bits a pixel
+                for (int i = 0; i < 16; i++) {
+                    uint32_t a = b[i / 2] >> (4 * (i & 1)) & 15;
+                    px[i][3] = uint8_t(a << 4 | a);
+                }
+            } else if (bc == 3) {
+                // two end alphas and 3 bit indices between them
+                uint8_t a[8] = {b[0], b[1]};
+                if (a[0] > a[1]) {
+                    for (int i = 2; i < 8; i++) a[i] = uint8_t(((8 - i) * a[0] + (i - 1) * a[1]) / 7);
+                } else {
+                    for (int i = 2; i < 6; i++) a[i] = uint8_t(((6 - i) * a[0] + (i - 1) * a[1]) / 5);
+                    a[6] = 0;
+                    a[7] = 255;
+                }
+                uint64_t idx = 0;
+                for (int i = 0; i < 6; i++) idx |= uint64_t(b[2 + i]) << (8 * i);
+                for (int i = 0; i < 16; i++) px[i][3] = a[idx >> (3 * i) & 7];
+            }
+            for (int i = 0; i < 16; i++) {
+                uint32_t x = bx * 4 + uint32_t(i % 4), y = by * 4 + uint32_t(i / 4);
+                if (x < w && y < h) std::memcpy(&bgra[(size_t(y) * w + x) * 4], px[i], 4);
+            }
+        }
+}
+
+bool ReadDds(const std::vector<uint8_t>& f, std::vector<uint8_t>& bgra, uint32_t& w, uint32_t& h) {
+    if (f.size() < 128 || std::memcmp(f.data(), "DDS ", 4)) return false;
+    h = Read32(&f[12]);
+    w = Read32(&f[16]);
+    uint32_t pf_flags = Read32(&f[80]), fourcc = Read32(&f[84]), bits = Read32(&f[88]);
+    size_t data = 128;
+    int bc = 0;
+    auto cc = [](const char* s) { return uint32_t(s[0]) | uint32_t(s[1]) << 8 | uint32_t(s[2]) << 16 | uint32_t(s[3]) << 24; };
+    bool rgba = false;
+    if (pf_flags & 4) {  // DDPF_FOURCC
+        if (fourcc == cc("DXT1")) bc = 1;
+        else if (fourcc == cc("DXT2") || fourcc == cc("DXT3")) bc = 2;
+        else if (fourcc == cc("DXT4") || fourcc == cc("DXT5")) bc = 3;
+        else if (fourcc == cc("DX10") && f.size() >= 148) {
+            uint32_t dxgi = Read32(&f[128]);
+            data = 148;
+            if (dxgi == 71 || dxgi == 72) bc = 1;
+            else if (dxgi == 74 || dxgi == 75) bc = 2;
+            else if (dxgi == 77 || dxgi == 78) bc = 3;
+            else if (dxgi == 28 || dxgi == 29) rgba = true;
+            else if (dxgi != 87 && dxgi != 91) return false;  // B8G8R8A8 as it is
+        } else {
+            return false;
+        }
+    } else if (bits != 32) {
+        return false;
+    } else {
+        rgba = Read32(&f[92]) == 0x000000FF;  // the red mask low: RGBA, else BGRA
+    }
+    if (!w || !h || w > 16384 || h > 16384) return false;
+    size_t need = bc ? size_t((w + 3) / 4) * ((h + 3) / 4) * (bc == 1 ? 8 : 16) : size_t(w) * h * 4;
+    if (f.size() < data + need) return false;
+    if (bc) {
+        DecodeBc(bc, &f[data], w, h, bgra);
+    } else {
+        bgra.assign(f.begin() + long(data), f.begin() + long(data + need));
+        if (rgba) SwapRedBlue(bgra.data(), size_t(w) * h);
+    }
+    return true;
+}
+
+}  // namespace linuximage
+#endif
diff --git a/runtime/linux/image.h b/runtime/linux/image.h
new file mode 100644
