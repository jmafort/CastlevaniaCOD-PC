new file mode 100644
index 0000000..9cef91b
--- /dev/null
+++ b/runtime/app/window_icon.h
@@ -0,0 +1,103 @@
+#pragma once
+// A window's icon made at run time from a picture (the title bar's, the taskbar's, Alt+Tab's), for an executable that
+// carries none of its own (resource 1): a release, which packs nothing of the game, makes it from the player's own
+// files (GameInfo::icon). Header only: the runtime's windows and a game's launcher share it.
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <vector>
+
+namespace app::icon {
+
+// size x size from a from x from picture (BGRA, straight alpha): each pixel the mean of the picture's under it,
+// weighted by how much of each it covers and by its alpha, so a transparent pixel's colour does not bleed into an edge
+inline std::vector<uint8_t> Shrink(const std::vector<uint8_t>& px, int from, int size) {
+    std::vector<uint8_t> out(size_t(size) * size * 4, 0);
+    if (from <= 0 || size <= 0 || px.size() < size_t(from) * from * 4) return out;
+    const double k = double(from) / double(size);
+    for (int y = 0; y < size; y++) {
+        double y0 = y * k, y1 = (y + 1) * k;
+        for (int x = 0; x < size; x++) {
+            double x0 = x * k, x1 = (x + 1) * k;
+            double acc[4] = {}, area = 0;
+            for (int sy = int(y0); sy < std::min(from, int(std::ceil(y1))); sy++) {
+                double wy = std::min(y1, double(sy + 1)) - std::max(y0, double(sy));
+                if (wy <= 0) continue;
+                for (int sx = int(x0); sx < std::min(from, int(std::ceil(x1))); sx++) {
+                    double wx = std::min(x1, double(sx + 1)) - std::max(x0, double(sx));
+                    if (wx <= 0) continue;
+                    const uint8_t* p = &px[(size_t(sy) * from + sx) * 4];
+                    double w = wx * wy, a = p[3] / 255.0;
+                    for (int c = 0; c < 3; c++) acc[c] += w * a * p[c];
+                    acc[3] += w * a;
+                    area += w;
+                }
+            }
+            uint8_t* o = &out[(size_t(y) * size + x) * 4];
+            for (int c = 0; c < 3; c++)
+                o[c] = uint8_t(std::lround(std::clamp(acc[3] > 0 ? acc[c] / acc[3] : 0.0, 0.0, 255.0)));
+            o[3] = uint8_t(std::lround(std::clamp(area > 0 ? 255.0 * acc[3] / area : 0.0, 0.0, 255.0)));
+        }
+    }
+    return out;
+}
+
+}  // namespace app::icon
+
+#ifdef _WIN32
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+
+namespace app::icon {
+
+// a size x size icon (32 bit, its alpha its shape) from the picture; null when Windows cannot make it
+inline HICON Make(const std::vector<uint8_t>& px, int from, int size) {
+    std::vector<uint8_t> s = Shrink(px, from, size);
+    BITMAPV5HEADER bi{};
+    bi.bV5Size = sizeof(bi);
+    bi.bV5Width = size;
+    bi.bV5Height = size;  // bottom up, as icons are
+    bi.bV5Planes = 1;
+    bi.bV5BitCount = 32;
+    bi.bV5Compression = BI_BITFIELDS;
+    bi.bV5RedMask = 0x00FF0000;
+    bi.bV5GreenMask = 0x0000FF00;
+    bi.bV5BlueMask = 0x000000FF;
+    bi.bV5AlphaMask = 0xFF000000;
+    void* bits = nullptr;
+    HDC dc = GetDC(nullptr);
+    HBITMAP color = CreateDIBSection(dc, reinterpret_cast<BITMAPINFO*>(&bi), DIB_RGB_COLORS, &bits, nullptr, 0);
+    ReleaseDC(nullptr, dc);
+    if (!color || !bits) {
+        if (color) DeleteObject(color);
+        return nullptr;
+    }
+    for (int y = 0; y < size; y++)
+        std::copy_n(&s[size_t(size - 1 - y) * size * 4], size_t(size) * 4, static_cast<uint8_t*>(bits) + size_t(y) * size * 4);
+    HBITMAP mask = CreateBitmap(size, size, 1, 1, nullptr);  // unused: the colour's alpha is the shape
+    ICONINFO ii{TRUE, 0, 0, mask, color};
+    HICON h = CreateIconIndirect(&ii);
+    DeleteObject(mask);
+    DeleteObject(color);
+    return h;
+}
+
+// the window's big icon (the taskbar's, Alt+Tab's) and small one (its title bar's), at the system's sizes for its DPI
+inline void Set(HWND hwnd, const std::vector<uint8_t>& px, int from, HICON* big_out = nullptr, HICON* small_out = nullptr) {
+    UINT dpi = GetDpiForWindow(hwnd);
+    if (!dpi) dpi = GetDpiForSystem();
+    HICON big = Make(px, from, GetSystemMetricsForDpi(SM_CXICON, dpi));
+    HICON little = Make(px, from, GetSystemMetricsForDpi(SM_CXSMICON, dpi));
+    if (big) SendMessageW(hwnd, WM_SETICON, ICON_BIG, LPARAM(big));
+    if (little) SendMessageW(hwnd, WM_SETICON, ICON_SMALL, LPARAM(little));
+    if (big_out) *big_out = big;
+    if (small_out) *small_out = little;
+}
+
+}  // namespace app::icon
+#endif
