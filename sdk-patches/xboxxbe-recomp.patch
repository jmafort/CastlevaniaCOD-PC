new file mode 100644
index 0000000..6a23d2f
--- /dev/null
+++ b/runtime/linux/dlss_vk.cpp
@@ -0,0 +1,518 @@
+// Linux: NVIDIA DLSS on Vulkan through NVIDIA's NGX (linux/dlss_vk.h)
+#ifndef _WIN32
+#include "linux/dlss_vk.h"
+
+#include <dlfcn.h>
+#include <fcntl.h>
+#include <spawn.h>
+#include <sys/wait.h>
+#include <unistd.h>
+#include <vkd3d.h>
+
+#include <algorithm>
+#include <cerrno>
+#include <cstdlib>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <iterator>
+#include <string>
+#include <system_error>
+
+#include "app/app.h"
+#include "core/log.h"
+#include "linux/ngx/cv_ngx.h"
+#include "linux/vk_images.h"
+
+extern char** environ;
+
+namespace gpu::linux_dlss {
+
+namespace {
+
+namespace fs = std::filesystem;
+
+// NVIDIA's DLSS SDK headers the bridge includes (ngx/cv_ngx.cpp), in dlss/include
+const char* const kHeaders[] = {"nvsdk_ngx.h",           "nvsdk_ngx_defs.h",       "nvsdk_ngx_defs_vk.h",
+                                "nvsdk_ngx_helpers.h",   "nvsdk_ngx_helpers_cuda.h", "nvsdk_ngx_helpers_d3d.h",
+                                "nvsdk_ngx_helpers_vk.h", "nvsdk_ngx_params.h",     "nvsdk_ngx_vk.h"};
+// the bridge's own files in the compiler folder's ngx
+const char* const kOwn[] = {"cv_ngx.cpp", "cv_ngx.h", "stub/stdbool.h", "stub/stddef.h", "stub/stdint.h", "stub/wchar.h",
+                            "stub/vulkan/vulkan.h"};
+
+const cv_ngx* g_api = nullptr;
+void* g_lib = nullptr;
+bool g_tried = false;
+std::vector<std::string> g_instance_names, g_device_names;
+VkPhysicalDevice g_card = VK_NULL_HANDLE;  // the card DeviceExtensions found DLSS's extensions on
+
+fs::path Dir() { return app::ExeDir() / "dlss"; }
+fs::path Bridge() { return Dir() / "libcv_ngx.so"; }
+fs::path Own() { return app::ExeDir() / "compiler" / "ngx"; }
+fs::path BuildLog() { return app::ExeDir() / "logs" / "dlss-build.log"; }
+
+bool Verbose() {
+    const char* v = std::getenv("XBE_DLSS_LOG");
+    return v && *v == '1';
+}
+
+void NgxLog(const char* line) {
+    std::string s(line ? line : "");
+    while (!s.empty() && (s.back() == '\n' || s.back() == '\r')) s.pop_back();
+    if (Verbose())
+        LOGR("ngx: %s", s.c_str());
+    else
+        LOGD("ngx: %s", s.c_str());
+}
+
+// the DLSS library NVIDIA releases with the SDK, any version of it
+bool HaveDlssLibrary() {
+    std::error_code ec;
+    for (auto& e : fs::directory_iterator(Dir(), ec))
+        if (e.path().filename().string().rfind("libnvidia-ngx-dlss.so.", 0) == 0) return true;
+    return false;
+}
+
+// what the bridge is built from; empty, and the first missing named, when one is not there
+std::vector<fs::path> Inputs(std::string& missing) {
+    std::vector<fs::path> in;
+    for (const char* h : kHeaders) in.push_back(Dir() / "include" / h);
+    in.push_back(Dir() / "libnvsdk_ngx.a");
+    for (const char* o : kOwn) in.push_back(Own() / o);
+    std::error_code ec;
+    for (const fs::path& p : in)
+        if (!fs::is_regular_file(p, ec)) {
+            missing = p.lexically_relative(app::ExeDir()).string();
+            return {};
+        }
+    return in;
+}
+
+// what the bridge was built from, each file's name, size and time: a new download or game release changes it, even with
+// an older time than the bridge's
+std::string Stamp(const std::vector<fs::path>& in) {
+    std::string s = "abi " + std::to_string(CV_NGX_ABI) + "\n";
+    std::error_code ec;
+    for (const fs::path& p : in) {
+        auto t = fs::last_write_time(p, ec).time_since_epoch().count();
+        s += p.lexically_relative(app::ExeDir()).string() + " " + std::to_string(fs::file_size(p, ec)) + " " +
+             std::to_string(t) + "\n";
+    }
+    return s;
+}
+
+fs::path StampFile() { return Dir() / "libcv_ngx.stamp"; }
+
+bool UpToDate(const std::vector<fs::path>& in) {
+    std::error_code ec;
+    if (!fs::is_regular_file(Bridge(), ec)) return false;
+    std::ifstream f(StampFile());
+    std::string had((std::istreambuf_iterator<char>(f)), std::istreambuf_iterator<char>());
+    return had == Stamp(in);
+}
+
+// a tool of the compiler folder's, else the PATH's by its name or a versioned one (clang-21); empty when none
+std::string Tool(const std::string& name) {
+    std::error_code ec;
+    fs::path own = app::ExeDir() / "compiler" / name;
+    if (fs::exists(own, ec)) return own.string();
+    const char* path = std::getenv("PATH");
+    std::string dirs = path && *path ? path : "/usr/local/bin:/usr/bin:/bin";
+    std::vector<std::string> names{name};
+    for (int v = 30; v >= 14; v--) names.push_back(name + "-" + std::to_string(v));
+    for (const std::string& n : names) {
+        size_t at = 0;
+        while (at <= dirs.size()) {
+            size_t end = dirs.find(':', at);
+            if (end == std::string::npos) end = dirs.size();
+            fs::path p = fs::path(dirs.substr(at, end - at)) / n;
+            if (end > at && access(p.c_str(), X_OK) == 0) return p.string();
+            at = end + 1;
+        }
+    }
+    return {};
+}
+
+// a tool run to its end, its output added to the build's log; true when it succeeded
+bool Run(const std::vector<std::string>& args) {
+    {
+        std::ofstream log(BuildLog(), std::ios::app);
+        for (const std::string& a : args) log << a << ' ';
+        log << '\n';
+    }
+    posix_spawn_file_actions_t fa;
+    posix_spawn_file_actions_init(&fa);
+    posix_spawn_file_actions_addopen(&fa, 1, BuildLog().c_str(), O_WRONLY | O_APPEND | O_CREAT, 0644);
+    posix_spawn_file_actions_adddup2(&fa, 1, 2);
+    std::vector<char*> argv;
+    for (const std::string& a : args) argv.push_back(const_cast<char*>(a.c_str()));
+    argv.push_back(nullptr);
+    pid_t pid = 0;
+    int e = posix_spawn(&pid, argv[0], &fa, nullptr, argv.data(), environ);
+    posix_spawn_file_actions_destroy(&fa);
+    if (e) return false;
+    int status = 0;
+    while (waitpid(pid, &status, 0) < 0 && errno == EINTR) {
+    }
+    return WIFEXITED(status) && WEXITSTATUS(status) == 0;
+}
+
+// the bridge compiled and linked as ngx/cv_ngx.cpp says, into place whole
+bool Build(const std::vector<fs::path>& in) {
+    std::string clang = Tool("clang"), lld = Tool("ld.lld");
+    if (clang.empty() || lld.empty()) {
+        LOGR("antialias: NVIDIA DLSS's bridge needs clang and ld.lld, which the compiler folder has (not here)");
+        return false;
+    }
+    std::error_code ec;
+    fs::create_directories(BuildLog().parent_path(), ec);
+    std::ofstream(BuildLog(), std::ios::trunc) << "NVIDIA DLSS's bridge (the SDK's runtime/linux/ngx/cv_ngx.cpp)\n";
+    fs::path obj = Dir() / "cv_ngx.o.tmp", lib = Dir() / "libcv_ngx.so.tmp";
+    bool ok = Run({clang, "-target", "x86_64-linux-gnu", "-std=c++20", "-O2", "-fPIC", "-nostdinc", "-nostdinc++",
+                   "-fno-exceptions", "-fno-rtti", "-w", "-isystem", (Own() / "stub").string(), "-I",
+                   (Dir() / "include").string(), "-c", (Own() / "cv_ngx.cpp").string(), "-o", obj.string()}) &&
+              Run({lld, "-shared", "-z", "noexecstack", "-o", lib.string(), obj.string(),
+                   (Dir() / "libnvsdk_ngx.a").string()});
+    fs::remove(obj, ec);
+    if (ok) fs::rename(lib, Bridge(), ec);
+    if (ok && !ec) std::ofstream(StampFile(), std::ios::trunc) << Stamp(in);
+    if (!ok || ec) {
+        fs::remove(lib, ec);
+        LOGR("antialias: NVIDIA DLSS's bridge was not built, see logs/dlss-build.log");
+        return false;
+    }
+    LOGR("antialias: NVIDIA DLSS's bridge built from NVIDIA's DLSS SDK files (dlss/libcv_ngx.so)");
+    return true;
+}
+
+// Halton's low-discrepancy sequence, as on Windows (framegen.cpp's HaltonJitter)
+float Halton(int32_t i, int32_t b) {
+    float f = 1, r = 0;
+    while (i > 0) {
+        f /= float(b);
+        r += f * float(i % b);
+        i /= b;
+    }
+    return r;
+}
+
+const char* ModeName(uint32_t mode) {
+    static const char* const kNames[] = {"DLAA", "Quality", "Balanced", "Performance"};
+    return kNames[std::min<uint32_t>(mode, 3)];
+}
+
+cv_ngx_image Of(const linux_vk::Image& im) {
+    return {reinterpret_cast<uint64_t>(im.image), reinterpret_cast<uint64_t>(im.view), uint32_t(im.info.format),
+            im.info.extent.width, im.info.extent.height};
+}
+
+class Dlss final : public framegen::AntiAlias {
+public:
+    ~Dlss() override {
+        if (vkd_) vkDeviceWaitIdle(vkd_);
+        if (inited_) g_api->shutdown();
+        if (fence_) vkDestroyFence(vkd_, fence_, nullptr);
+        if (pool_) vkDestroyCommandPool(vkd_, pool_, nullptr);
+    }
+
+    bool Init(ID3D12Device* dev, ID3D12CommandQueue* queue) {
+        queue_ = queue;
+        vkd_ = vkd3d_get_vk_device(dev);
+        pd_ = vkd3d_get_vk_physical_device(dev);
+        family_ = vkd3d_get_vk_queue_family_index(queue);
+        VkInstance vki = vkd3d_instance_get_vk_instance(vkd3d_instance_from_device(dev));
+        int32_t r = g_api->init(vki, pd_, vkd_, reinterpret_cast<void*>(vkGetInstanceProcAddr),
+                                reinterpret_cast<void*>(vkGetDeviceProcAddr));
+        inited_ = true;  // shut down even when it failed part way
+        if (r != 1) {
+            LOGR("antialias: NVIDIA's NGX did not start (%s), see logs/ngx", g_api->result(r));
+            return false;
+        }
+        char why[256] = "";
+        if (!g_api->available(why, sizeof(why))) {
+            LOGR("antialias: NVIDIA DLSS is not running: %s", why);
+            return false;
+        }
+        VkCommandPoolCreateInfo pci{VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO};
+        pci.flags = VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT;
+        pci.queueFamilyIndex = family_;
+        if (vkCreateCommandPool(vkd_, &pci, nullptr, &pool_) != VK_SUCCESS) return false;
+        VkCommandBufferAllocateInfo ai{VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO};
+        ai.commandPool = pool_;
+        ai.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+        ai.commandBufferCount = 1;
+        if (vkAllocateCommandBuffers(vkd_, &ai, &cmd_) != VK_SUCCESS) return false;
+        VkFenceCreateInfo fci{VK_STRUCTURE_TYPE_FENCE_CREATE_INFO};
+        if (vkCreateFence(vkd_, &fci, nullptr, &fence_) != VK_SUCCESS) return false;
+        LOGR("antialias: NVIDIA DLSS on NVIDIA's driver, through NGX");
+        return true;
+    }
+
+    uint32_t Kind() const override { return framegen::kAaDlss; }
+
+    // DLSS's own size for the mode, else AMD's ratios
+    void RenderSize(uint32_t w, uint32_t h, uint32_t quality, uint32_t& rw, uint32_t& rh) override {
+        rw = w;
+        rh = h;
+        if (quality == framegen::kUpNative) return;
+        if (w == size_w_ && h == size_h_ && quality == size_q_) {
+            rw = size_rw_;
+            rh = size_rh_;
+            return;
+        }
+        uint32_t ow = 0, oh = 0;
+        if (g_api->optimal(w, h, quality, &ow, &oh) == 1 && ow && oh && ow <= w && oh <= h) {
+            rw = ow;
+            rh = oh;
+        } else {
+            float ratio = quality == framegen::kUpQuality ? 1.5f : quality == framegen::kUpBalanced ? 1.7f : 2.0f;
+            rw = std::max(1u, uint32_t(float(w) / ratio));
+            rh = std::max(1u, uint32_t(float(h) / ratio));
+        }
+        size_w_ = w;
+        size_h_ = h;
+        size_q_ = quality;
+        size_rw_ = rw;
+        size_rh_ = rh;
+    }
+
+    void Jitter(uint64_t frame, float ratio, float& x, float& y) const override {
+        int32_t phases = std::max(8, int32_t(8.0f * ratio * ratio));
+        int32_t i = int32_t(frame % uint64_t(phases)) + 1;
+        x = Halton(i, 2) - 0.5f;
+        y = Halton(i, 3) - 0.5f;
+    }
+
+    bool VulkanImages() const override { return true; }
+    bool Run(ID3D12GraphicsCommandList*, const Frame&) override { return false; }  // RunQueue's
+
+    bool RunQueue(const Frame& f) override {
+        if (broken_) return false;
+        linux_vk::Image color, depth, motion, bias, output;
+        if (!linux_vk::Find(f.color, color) || !linux_vk::Find(f.depth, depth) || !linux_vk::Find(f.motion, motion) ||
+            !linux_vk::Find(f.output, output) || !f.w || !f.h || !f.rw || !f.rh) {
+            LOG_FIRST(2, "antialias: NVIDIA DLSS's inputs are not its own images");
+            return false;
+        }
+        bool have_bias = linux_vk::Find(f.reactive, bias);
+        bool inverted = f.view.near_w > f.view.far_w;
+        uint32_t mode = std::min<uint32_t>(f.quality, framegen::kUpPerformance);
+        bool fresh = false;
+        if (!made_ || f.w != w_ || f.h != h_ || f.rw != rw_ || f.rh != rh_ || mode != mode_ || inverted != inverted_) {
+            made_ = false;
+            int32_t r = 0;
+            if (!Record([&] { r = g_api->create(cmd_, f.w, f.h, f.rw, f.rh, mode, inverted); }) || r != 1) {
+                LOGR("antialias: NVIDIA DLSS was not made (%s) for %ux%u from %ux%u", r ? g_api->result(r) : "submit",
+                     f.w, f.h, f.rw, f.rh);
+                broken_ = ++failures_ >= 3;
+                return false;
+            }
+            made_ = fresh = true;
+            w_ = f.w;
+            h_ = f.h;
+            rw_ = f.rw;
+            rh_ = f.rh;
+            mode_ = mode;
+            inverted_ = inverted;
+            LOGR("antialias: NVIDIA DLSS %s on Vulkan, at %ux%u from %ux%u", ModeName(mode), f.w, f.h, f.rw, f.rh);
+        }
+        cv_ngx_frame fr{};
+        fr.color = Of(color);
+        fr.depth = Of(depth);
+        fr.motion = Of(motion);
+        fr.output = Of(output);
+        if (have_bias) fr.bias = Of(bias);
+        fr.rw = f.rw;
+        fr.rh = f.rh;
+        fr.jitter[0] = f.jitter[0];
+        fr.jitter[1] = f.jitter[1];
+        fr.mv_scale[0] = float(f.rw);  // UV units to pixels of the size drawn
+        fr.mv_scale[1] = float(f.rh);
+        fr.frame_ms = f.frame_ms;
+        fr.reset = f.reset || fresh;
+        int32_t r = 0;
+        if (!Record([&] { r = g_api->evaluate(cmd_, &fr); }) || r != 1) {
+            LOG_FIRST(4, "antialias: NVIDIA DLSS %s at %ux%u from %ux%u", r ? g_api->result(r) : "not submitted", f.w,
+                      f.h, f.rw, f.rh);
+            broken_ = ++failures_ >= 8;
+            return false;
+        }
+        return true;
+    }
+
+private:
+    // the command buffer recorded by what (between barriers: the frame's writes seen by NGX's commands, NGX's by what
+    // follows), submitted on the queue, not waited for (the next one waits); false when it was not submitted
+    template <class F>
+    bool Record(F&& what) {
+        // the last submit's commands done with before these are recorded (long done by now: a frame back), and
+        // before what releases or makes again what they used
+        if (pending_) {
+            vkWaitForFences(vkd_, 1, &fence_, VK_TRUE, UINT64_MAX);
+            pending_ = false;
+        }
+        vkResetCommandBuffer(cmd_, 0);
+        VkCommandBufferBeginInfo bi{VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+        bi.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+        vkBeginCommandBuffer(cmd_, &bi);
+        VkMemoryBarrier mb{VK_STRUCTURE_TYPE_MEMORY_BARRIER};
+        mb.srcAccessMask = VK_ACCESS_MEMORY_WRITE_BIT;
+        mb.dstAccessMask = VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT;
+        vkCmdPipelineBarrier(cmd_, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 1, &mb, 0,
+                             nullptr, 0, nullptr);
+        what();
+        vkCmdPipelineBarrier(cmd_, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 1, &mb, 0,
+                             nullptr, 0, nullptr);
+        if (vkEndCommandBuffer(cmd_) != VK_SUCCESS) return false;
+        // the fence reset only for a submit, so one never submitted is never waited for
+        vkResetFences(vkd_, 1, &fence_);
+        VkSubmitInfo si{VK_STRUCTURE_TYPE_SUBMIT_INFO};
+        si.commandBufferCount = 1;
+        si.pCommandBuffers = &cmd_;
+        VkQueue q = vkd3d_acquire_vk_queue(queue_);
+        VkResult r = vkQueueSubmit(q, 1, &si, fence_);
+        vkd3d_release_vk_queue(queue_);
+        if (r != VK_SUCCESS) {
+            // the fence stays unsignalled: a new one
+            vkDestroyFence(vkd_, fence_, nullptr);
+            fence_ = VK_NULL_HANDLE;
+            VkFenceCreateInfo fci{VK_STRUCTURE_TYPE_FENCE_CREATE_INFO};
+            vkCreateFence(vkd_, &fci, nullptr, &fence_);
+            return false;
+        }
+        // not waited for: the renderer's own commands after it, which read the output, go on the same queue after
+        // it, and the barrier at its end has them see what it wrote. The processor goes on with the frame meanwhile
+        pending_ = true;
+        return true;
+    }
+
+    ID3D12CommandQueue* queue_ = nullptr;
+    VkDevice vkd_ = VK_NULL_HANDLE;
+    VkPhysicalDevice pd_ = VK_NULL_HANDLE;
+    uint32_t family_ = 0;
+    bool inited_ = false, made_ = false, inverted_ = false, broken_ = false;
+    uint32_t failures_ = 0;
+    uint32_t w_ = 0, h_ = 0, rw_ = 0, rh_ = 0, mode_ = 0;
+    uint32_t size_w_ = 0, size_h_ = 0, size_q_ = 0, size_rw_ = 0, size_rh_ = 0;  // RenderSize's last
+    VkCommandPool pool_ = VK_NULL_HANDLE;
+    VkCommandBuffer cmd_ = VK_NULL_HANDLE;
+    VkFence fence_ = VK_NULL_HANDLE;
+    bool pending_ = false;  // submitted, its fence not yet waited for
+};
+
+}  // namespace
+
+bool Load() {
+    if (g_tried) return g_api != nullptr;
+    g_tried = true;
+    std::error_code ec;
+    if (!fs::is_directory(Dir(), ec)) return false;  // not downloaded
+    if (!HaveDlssLibrary()) {
+        LOGR("antialias: NVIDIA DLSS's library (libnvidia-ngx-dlss.so) is not in dlss/");
+        return false;
+    }
+    std::string missing;
+    std::vector<fs::path> in = Inputs(missing);
+    if (in.empty()) {
+        LOGR("antialias: NVIDIA DLSS's files are not all there (%s is missing)", missing.c_str());
+        return false;
+    }
+    // built when it is missing or older than what it is built from; and once more when it would not load or was another
+    // version's
+    for (int attempt = 0; attempt < 2 && !g_api; attempt++) {
+        if ((attempt || !UpToDate(in)) && !Build(in)) return false;
+        g_lib = dlopen(Bridge().c_str(), RTLD_NOW | RTLD_LOCAL);
+        if (!g_lib) {
+            LOGR("antialias: NVIDIA DLSS's bridge would not load (%s)", dlerror());
+            continue;
+        }
+        auto get = reinterpret_cast<cv_ngx_get_fn>(dlsym(g_lib, "cv_ngx_get"));
+        g_api = get ? get(CV_NGX_ABI) : nullptr;
+        if (!g_api) {
+            dlclose(g_lib);
+            g_lib = nullptr;
+        }
+    }
+    if (!g_api) return false;
+    fs::path data = app::ExeDir() / "logs" / "ngx";
+    fs::create_directories(data, ec);
+    g_api->setup(data.c_str(), Dir().c_str(), NgxLog, Verbose());
+    LOGR("antialias: NVIDIA DLSS's files are there, its bridge loaded");
+    return true;
+}
+
+bool Loaded() { return g_api != nullptr; }
+
+void InstanceExtensions(std::vector<const char*>& out) {
+    if (!g_api) return;
+    uint32_t n = 0;
+    const char* const* names = nullptr;
+    int32_t r = g_api->instance_extensions(&n, &names);
+    if (r != 1) {
+        LOGR("antialias: NGX named no Vulkan instance extensions for NVIDIA DLSS (%s)", g_api->result(r));
+        return;
+    }
+    g_instance_names.assign(names, names + n);
+    for (const std::string& s : g_instance_names) out.push_back(s.c_str());
+}
+
+void DeviceExtensions(VkInstance instance, VkPhysicalDevice card, std::vector<const char*>& out) {
+    g_card = VK_NULL_HANDLE;
+    if (!g_api || !card) return;
+    // only on NVIDIA's own driver is NGX started: on Mesa's (NVK, dozen) it would take a device it cannot run on
+    VkPhysicalDeviceDriverProperties dp{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_DRIVER_PROPERTIES};
+    VkPhysicalDeviceProperties2 p2{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2, &dp};
+    auto props2 = reinterpret_cast<PFN_vkGetPhysicalDeviceProperties2>(
+        vkGetInstanceProcAddr(instance, "vkGetPhysicalDeviceProperties2"));
+    if (!props2)
+        props2 = reinterpret_cast<PFN_vkGetPhysicalDeviceProperties2>(
+            vkGetInstanceProcAddr(instance, "vkGetPhysicalDeviceProperties2KHR"));
+    if (props2) props2(card, &p2);
+    if (!props2 || p2.properties.vendorID != 0x10DE || dp.driverID != VK_DRIVER_ID_NVIDIA_PROPRIETARY) {
+        LOGR("antialias: NVIDIA DLSS needs an NVIDIA RTX card on NVIDIA's own driver; %s is on %s", p2.properties.deviceName,
+             dp.driverName[0] ? dp.driverName : "another driver");
+        return;
+    }
+    uint32_t n = 0;
+    const char* const* names = nullptr;
+    int32_t r = g_api->device_extensions(instance, card, &n, &names);
+    if (r != 1) {
+        LOGR("antialias: NGX named no Vulkan device extensions for NVIDIA DLSS (%s)", g_api->result(r));
+        return;
+    }
+    uint32_t have_n = 0;
+    vkEnumerateDeviceExtensionProperties(card, nullptr, &have_n, nullptr);
+    std::vector<VkExtensionProperties> have(have_n);
+    vkEnumerateDeviceExtensionProperties(card, nullptr, &have_n, have.data());
+    std::vector<std::string> want(names, names + n);
+    for (const std::string& w : want) {
+        bool found = std::any_of(have.begin(), have.end(), [&](const VkExtensionProperties& e) { return w == e.extensionName; });
+        if (!found) {
+            LOGR("antialias: NVIDIA DLSS needs Vulkan's %s, which %s's driver has not", w.c_str(), p2.properties.deviceName);
+            return;
+        }
+    }
+    g_device_names = want;
+    for (const std::string& s : g_device_names) out.push_back(s.c_str());
+    g_card = card;
+    std::string list;
+    for (const std::string& s : g_device_names) list += (list.empty() ? "" : ", ") + s;
+    LOGR("antialias: NVIDIA DLSS's Vulkan extensions on %s: %s", p2.properties.deviceName, list.c_str());
+}
+
+std::unique_ptr<framegen::AntiAlias> MakeDlss(ID3D12Device* dev, ID3D12CommandQueue* queue) {
+    if (!g_api) {
+        LOGR("antialias: NVIDIA DLSS's files are not there: the launcher downloads them from NVIDIA (Graphics)");
+        return nullptr;
+    }
+    if (!g_card || vkd3d_get_vk_physical_device(dev) != g_card) {
+        LOGR("antialias: NVIDIA DLSS is not on this card (above)");
+        return nullptr;
+    }
+    auto d = std::make_unique<Dlss>();
+    if (!d->Init(dev, queue)) return nullptr;
+    return d;
+}
+
+}  // namespace gpu::linux_dlss
+#endif
diff --git a/runtime/linux/dlss_vk.h b/runtime/linux/dlss_vk.h
new file mode 100644
index 0000000..3240129
--- /dev/null
+++ b/runtime/linux/dlss_vk.h
@@ -0,0 +1,40 @@
+#pragma once
+// Linux: NVIDIA DLSS on Vulkan, in NVIDIA DLSS's place among the frame's anti-aliasing (framegen::AntiAlias), through
+// NVIDIA's NGX, which NVIDIA's own Linux driver brings (libnvidia-ngx.so.1). It runs on vkd3d's own Vulkan device and
+// queue, its inputs and output the renderer's own Vulkan images (linux/vk_images.h), as AMD FSR's do (linux/fsr_vk.h).
+//
+// The game's download carries none of NVIDIA's code. NVIDIA's DLSS SDK files are the player's, downloaded from NVIDIA
+// into dlss/ beside the executables (the launcher does it): the SDK's headers (dlss/include), its NGX loader
+// (libnvsdk_ngx.a) and the DLSS library (libnvidia-ngx-dlss.so.<version>). The bridge between the game and NGX
+// (ngx/cv_ngx.cpp, this SDK's, in the compiler folder) is compiled and linked with them on the player's PC, by the
+// compiler folder's clang and ld.lld, into dlss/libcv_ngx.so, which the game loads.
+//
+// DLSS runs only on NVIDIA's own driver, the card an RTX: on any other (Mesa's, in WSL Mesa's dozen) NGX is never
+// started and AMD FSR takes DLSS's place. XBE_DLSS_LOG=1 keeps NGX's own lines in the game's log; NGX writes its logs to
+// logs/ngx too.
+#include <vulkan/vulkan.h>
+
+#include <memory>
+#include <vector>
+
+#include "d3d12.h"
+#include "gpu/framegen.h"
+
+namespace gpu::linux_dlss {
+
+// NVIDIA's files are in dlss/: the bridge built from them when it is missing or older than they are, then loaded; false
+// when they are not there (quietly) or it cannot be built or loaded (logged). Before the Vulkan instance is made
+bool Load();
+bool Loaded();
+
+// the Vulkan extensions DLSS asks for, once loaded: the instance's; a card's, none unless its driver is NVIDIA's own
+// and has them all. The names stay valid until the next call
+void InstanceExtensions(std::vector<const char*>& out);
+void DeviceExtensions(VkInstance instance, VkPhysicalDevice card, std::vector<const char*>& out);
+
+// NVIDIA DLSS on the device's Vulkan device and the queue's; null when it cannot be (logged). Its frames run through
+// AntiAlias::RunQueue, after the renderer has submitted the frame so far: its commands go on the queue after the
+// frame's, not waited for
+std::unique_ptr<framegen::AntiAlias> MakeDlss(ID3D12Device* dev, ID3D12CommandQueue* queue);
+
+}  // namespace gpu::linux_dlss
