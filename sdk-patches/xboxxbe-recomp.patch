+#pragma once
+// Linux: the SDL window and keyboard the platform layer shares (linux/main.cpp, win32.cpp, imgui_sdl.cpp)
+#include <SDL3/SDL.h>
+
+#include <atomic>
+#include <cstdint>
+#include <string>
+
+namespace linuxapp {
+
+// the game window, null until it is made; its keyboard focus
+inline std::atomic<SDL_Window*> g_window{nullptr};
+inline std::atomic<bool> g_focused{false};
+// the window's size in pixels as the main loop last saw it, for the render thread
+inline std::atomic<uint32_t> g_pixel_w{0}, g_pixel_h{0};
+
+// a key's Win32 virtual key code, 0 for one without
+int VirtualKey(SDL_Scancode sc);
+// UTF-8 to and from wide text
+std::string Utf8(const wchar_t* text);
+std::wstring Wide(const std::string& text);
+// a program run in the background, not waited for (xdg-open)
+void Spawn(const char* program, const char* arg);
+
+// ImGui on SDL (imgui_sdl.cpp): events from the main thread, frames from the render thread, both under UiLock
+void ImGuiInit(SDL_Window* window);
+void ImGuiEvent(const SDL_Event& e);
+void ImGuiNewFrame();
+// the cursor ImGui wants over the window, applied by the main loop (ApplyCursor, main thread): -1 hidden
+inline std::atomic<int> g_cursor{0};
+void ApplyCursor();
+// the controller ImGui navigates with: the game's port 1 (input::SdlGamepad), the launcher's own
+inline SDL_Gamepad* (*g_nav_pad)() = nullptr;
+
+}  // namespace linuxapp
