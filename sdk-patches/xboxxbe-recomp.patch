+                    own(aa_out_, aa_out_state_, DXGI_FORMAT_R8G8B8A8_UNORM, false) &&
+                    own(aa_vk_color_, aa_vk_color_state_, fmt, false) &&
+                    own(aa_vk_rx_, aa_vk_rx_state_, DXGI_FORMAT_R8_UNORM, false);
