index 0000000..1898f36
--- /dev/null
+++ b/runtime/linux/audio.cpp
@@ -0,0 +1,58 @@
+// Linux: mixer output through SDL's audio (PipeWire, PulseAudio or ALSA, whichever the system has)
+#ifndef _WIN32
+#include <SDL3/SDL.h>
+
+#include <algorithm>
+#include <vector>
+
+#include "audio/audio.h"
+#include "core/log.h"
+
+namespace audio {
+
+namespace {
+
+constexpr uint32_t kFrames = kRate / 100;  // the mixer renders 10 ms at a time, as for XAudio2
+
+struct Output {
+    std::function<void(float*, uint32_t)> render;
+    std::vector<float> buffer = std::vector<float>(kFrames * 2);
+};
+
+// SDL's audio thread wants more: whole 10 ms blocks until it has at least that much
+void Feed(void* user, SDL_AudioStream* stream, int additional, int) {
+    auto* out = static_cast<Output*>(user);
+    constexpr int kBlockBytes = int(kFrames * 2 * sizeof(float));
+    for (int added = 0; added < additional; added += kBlockBytes) {
+        if (g_paused.load(std::memory_order_relaxed))
+            std::fill(out->buffer.begin(), out->buffer.end(), 0.0f);
+        else
+            out->render(out->buffer.data(), kFrames);
+        Count(out->buffer.data(), kFrames);
+        SDL_PutAudioStreamData(stream, out->buffer.data(), kBlockBytes);
+    }
+}
+
+}  // namespace
+
+void StartOutput(std::function<void(float*, uint32_t)> render) {
+    if (!SDL_InitSubSystem(SDL_INIT_AUDIO)) {
+        LOGE("audio: SDL audio unavailable (%s), no sound", SDL_GetError());
+        return;
+    }
+    // a block in the device's queue at most, so the game's sound is not late
+    SDL_SetHint(SDL_HINT_AUDIO_DEVICE_SAMPLE_FRAMES, "480");
+    SDL_AudioSpec spec{SDL_AUDIO_F32, 2, int(kRate)};
+    auto* out = new Output{std::move(render)};  // for the run
+    SDL_AudioStream* stream = SDL_OpenAudioDeviceStream(SDL_AUDIO_DEVICE_DEFAULT_PLAYBACK, &spec, Feed, out);
+    if (!stream) {
+        LOGE("audio: no output device (%s), no sound", SDL_GetError());
+        return;
+    }
+    SDL_ResumeAudioStreamDevice(stream);
+    LOGI("audio: %s through SDL (%s)", SDL_GetAudioDeviceName(SDL_GetAudioStreamDevice(stream)),
+         SDL_GetCurrentAudioDriver());
+}
+
+}  // namespace audio
+#endif
